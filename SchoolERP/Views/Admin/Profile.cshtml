@using SchoolERP.Models.ViewModels
@using System.Security.Claims
@model RolePermissionViewModel
@{
    ViewData["Title"] = "Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <!-- PROFILE HEADER -->
    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex align-items-center">
            <i class="bi bi-person-circle text-primary" style="font-size: 70px;"></i>
            <div>
                <h4 class="mb-0">@User.FindFirst("FullName")?.Value</h4>
                <span class="text-muted">@User.FindFirst(ClaimTypes.Role)?.Value</span><br />
                <small class="text-success">Active</small>
            </div>

            <div class="ms-auto">
                <button class="btn btn-primary btn-sm">Edit Profile</button>
            </div>

        </div>
    </div>

    <div class="row">

        <!-- LEFT SIDE -->
        <div class="col-md-4">

            <!-- BASIC INFO -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-info bg-opacity-25 text-dark">
                    <i class="bi bi-person-lines-fill me-2"></i>
                    <strong>Basic Information</strong>
                </div>

                <div class="card-body">
                    <p><strong>Email:</strong> @User.FindFirst(ClaimTypes.Email)?.Value</p>
                    <p><strong>Phone:</strong> @User.FindFirst("MobileNumber")?.Value</p>
                    <p><strong>Department:</strong> Admin</p>
                </div>
            </div>

            <!-- ACCOUNT INFO -->
            <div class="card shadow-sm">
                <div class="card-header bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-person-circle me-2"></i>
                    <strong>Account Details</strong>
                </div>

                <div class="card-body">
                    <p><strong>Username:</strong> @User.FindFirst(ClaimTypes.Name)?.Value</p>
                    <p><strong>Created On:</strong> @User.FindFirst("CreatedOn")?.Value </p>
                    <p><strong>Last Login:</strong> @User.FindFirst("LastLogin")?.Value</p>
                </div>
            </div>

        </div>

        <!-- RIGHT SIDE -->
        <div class="col-md-8">

            <!-- ROLE / PERMISSIONS -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-warning bg-opacity-25 text-dark">
                    <i class="bi bi-shield-lock me-2"></i>
                    <strong>Role & Permissions</strong>
                </div>

                <div class="card-body">

                     <!-- PERMISSIONS -->
    <div class="accordion" id="permissionAccordion">

        @for (int s = 0; s < Model.Sections.Count; s++)
        {
            var _section = Model.Sections[s];
            var collapseId = $"section_{s}";

            <div class="accordion-item mb-2 shadow-sm">

                <!-- SECTION HEADER -->
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#@collapseId">

                        <i class="bi bi-folder-fill text-primary me-2"></i>
                        <strong>@_section.SectionTitle</strong>
                    </button>
                </h2>

                <!-- SECTION BODY -->
                <div id="@collapseId"
                     class="accordion-collapse collapse"
                     data-bs-parent="#permissionAccordion">

                    <div class="accordion-body">

                        @foreach (var item in _section.Items)
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom py-2">

                                <!-- MENU -->
                                <div>
                                    <i class="bi bi-file-earmark text-muted"></i>
                                    @item.MenuTitle
                                </div>

                                <!-- PERMISSIONS -->
                                <div class="d-flex gap-3">

                                    <span class="badge @(item.CanView ? "bg-success" : "bg-secondary")">
                                        View
                                    </span>

                                    <span class="badge @(item.CanCreate ? "bg-success" : "bg-secondary")">
                                        Create
                                    </span>

                                    <span class="badge @(item.CanEdit ? "bg-success" : "bg-secondary")">
                                        Edit
                                    </span>

                                    <span class="badge @(item.CanDelete ? "bg-success" : "bg-secondary")">
                                        Delete
                                    </span>

                                </div>

                            </div>
                        }

                    </div>
                </div>
            </div>
        }

    </div>

                </div>
            </div>

            <!-- ACTIVITY LOG -->
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <strong>Recent Activity</strong>
                </div>

                <div class="card-body">
                    @* <ul class="list-group">
                        @foreach (var log in Model.Activities)
                        {
                            <li class="list-group-item">
                                @log.Action -
                                <small class="text-muted">@log.Date</small>
                            </li>
                        }
                    </ul> *@
                </div>
            </div>

        </div>

    </div>
</div>