@using SchoolERP.Models.ViewModels
@model List<StudentLockViewModel>

@{
    ViewData["Title"] = "Lock/Unlock Students";
     Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container my-4">
    <h2 class="mb-4">
        <i class="bi bi-shield-lock-fill"></i> Student Lock/Unlock Management
    </h2>

    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Class</th>
                <th>Section</th>
                <th>Login Count</th>
                <th>Last Login</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                var student = Model[i];
                <tr>
                    <td>@(i + 1)</td>
                    <td>@student.Name</td>
                    <td>@student.ClassName</td>
                    <td>@student.SectionName</td>
                     <td>@student.FailedCount</td>
                    <td>@student.LastLogin</td>
                    <td>
                        @if (student.IsLocked)
                        {
                            <span class="badge bg-danger">
                                <i class="bi bi-lock-fill"></i> Locked
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                <i class="bi bi-unlock-fill"></i> Unlocked
                            </span>
                        }
                    </td>
                    <td>
                        <form asp-action="ToggleLock" method="post">
                            <input type="hidden" name="userId" value="@student.UserID" />
                            <button type="submit" class="btn btn-sm @(student.IsLocked ? "btn-success" : "btn-danger")">
                                @if (student.IsLocked)
                                {
                                    <i class="bi bi-unlock-fill"></i><text>Unlock</text>
                                }
                                else
                                {
                                    <i class="bi bi-lock-fill"></i> <text>Lock</text>
                                }
                            </button>
                        </form>
                    </td>
                </tr>
            }
        
        </tbody>
    </table>

</div>

