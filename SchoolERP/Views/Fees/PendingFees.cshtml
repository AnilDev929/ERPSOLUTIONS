@using SchoolERP.Models.ViewModels
@model PendingFeeDashboardVM
@{
    ViewData["Title"] = "Pending Fee Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>

    :root {
        --erp-bg: #f6f8fc;
        --erp-border: #e8edf4;
        --danger: #ef4444;
        --danger-soft: #fef2f2;
        --primary: #2563eb;
        --primary-soft: #eff6ff;
        --warning: #f59e0b;
        --warning-soft: #fffbeb;
        --success: #10b981;
        --success-soft: #ecfdf5;
    }

    body {
        background: var(--erp-bg);
    }

    .erp-card {
        background: #fff;
        border: none;
        border-radius: 22px;
        box-shadow: 0 10px 35px rgba(18,38,63,.06);
    }

    .page-header {
        padding: 11px;
    }

    .kpi-card {
        padding: 22px;
        transition: .25s;
    }

        .kpi-card:hover {
            transform: translateY(-4px);
        }

    .kpi-icon {
        width: 58px;
        height: 58px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .kpi-value {
        font-size: 32px;
        font-weight: 800;
    }

    .kpi-label {
        color: #64748b;
        font-size: 14px;
    }

    .filter-box {
        padding: 22px;
    }

    .form-select,
    .form-control {
        height: 48px;
        border-radius: 14px;
        border: 1px solid var(--erp-border);
    }

    .input-group-text {
        border-radius: 14px 0 0 14px;
    }

    .section-header {
        padding: 22px;
        border-bottom: 1px solid #f1f5f9;
    }

    .table {
        margin-bottom: 0;
    }

    .table thead th {
        color: #64748b;
        font-size: 13px;
        font-weight: 700;
        padding: 18px;
    }

    .table tbody td {
        padding: 20px 18px;
    }

    .table tbody tr:hover {
        background: #fafcff;
    }

    .class-icon {
        width: 42px;
        height: 42px;
        background: var(--primary-soft);
        color: var(--primary);
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .student-icon {
        width: 40px;
        height: 40px;
        background: #f8fafc;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .progress {
        height: 10px;
        border-radius: 30px;
        background: #edf2f7;
    }

    .progress-bar {
        border-radius: 30px;
    }

    .status-pill {
        border-radius: 999px;
        padding: 8px 14px;
        font-size: 13px;
        font-weight: 700;
    }

    .overdue {
        background: var(--danger-soft);
        color: var(--danger);
    }

    .pending {
        background: var(--warning-soft);
        color: var(--warning);
    }

    .dashboard-table-header th {
        background: linear-gradient( 135deg, #eef2ff, #e0e7ff );
        color: #374151;
        font-weight: 600;
        font-size: 1.1rem;
        padding: 14px 16px;
        white-space: nowrap;
        border-bottom: 2px solid #c7d2fe;
    }

    .dashboard-table-header th i {
        font-size: 0.95rem;
    }

    @@media(max-width:768px) {

        .kpi-value {
            font-size: 24px;
        }

        .page-header {
            padding: 18px;
        }
    }


    /* Filter */
    .filter-card {
        background: #fff;
        border-radius: 20px;
        padding: 22px;
        box-shadow: 0 8px 24px rgba(15,23,42,.06);
        border: 1px solid #eef2f7;
    }

    .filter-header {
        margin-bottom: 18px;
    }

        .filter-header h6 {
            font-weight: 700;
            color: #1f2937;
        }

        .filter-header small {
            color: #6b7280;
        }

    .filter-label {
        font-size: .8rem;
        font-weight: 600;
        color: #6b7280;
        margin-bottom: 6px;
        display: block;
    }

    .modern-input {
        height: 48px;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
    }

        .modern-input:focus {
            box-shadow: 0 0 0 4px rgba(79,70,229,.12);
            border-color: #6366f1;
        }

    .search-wrapper {
        position: relative;
    }

    .search-icon {
        position: absolute;
        top: 50%;
        left: 14px;
        transform: translateY(-50%);
        color: #9ca3af;
        z-index: 2;
    }

    .search-input {
        padding-left: 42px;
    }

    @@media(max - width:768px) {
        .filter-card
        {
            padding: 16px;
        }
        .filter-header {
            text-align: center;
        }
    }

    .record-summary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: 12px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #475569;
        font-size: .9rem;
        font-weight: 500;
    }

    .record-summary i {
        color: #2563eb;
    }

    .record-summary strong {
        color: #111827;
        font-weight: 700;
    }


    .table-header-modern th {
        background: linear-gradient( 180deg, #f8fafc 0%, #eef2ff 100% );
        color: #334155;
        font-weight: 700;
        font-size: .9rem;
        white-space: nowrap;
        padding: 14px 12px;
        border-bottom: 2px solid #e2e8f0;
    }
</style>

<div class="container-fluid">

    <!-- HEADER -->
    <div class="erp-card page-header mb-1">

        <div class="d-flex justify-content-between flex-wrap align-items-center">

            <div>
                <div class="text-muted small mb-2">
                    Dashboard > Fees > Pending Fees
                </div>

                <h4 class="fw-bold mb-1">
                    <i class="bi bi-wallet2 text-danger me-2"></i>
                    Pending Fees
                </h4>

                <div class="text-muted">
                    Monitor pending collections class-wise
                </div>
            </div>

            <div class="mt-3 mt-lg-0">
                <button class="btn btn-danger rounded-pill px-4 ms-2">
                    <i class="bi bi-send me-2"></i> Send Notice</button>
            </div>

        </div>

    </div>


    <!-- KPI -->
    <div class="row mb-2">

        <div class="col-lg-3 col-md-6">
            <div class="erp-card kpi-card">
                <div class="d-flex">
                    <div class="kpi-icon bg-danger-subtle">
                        <i class="bi bi-cash-stack text-danger"></i>
                    </div>
                    <div class="ms-3">
                        <div class="kpi-label"> Total Due </div>
                        <div class="kpi-value text-danger">
                            ₹@Model.TotalPending
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">

            <div class="erp-card kpi-card">
                <div class="d-flex">
                    <div class="kpi-icon bg-primary-subtle">
                        <i class="bi bi-people-fill text-primary"></i>
                    </div>
                    <div class="ms-3">
                        <div class="kpi-label">
                            Students
                        </div>
                        <div class="kpi-value">
                            @Model.TotalStudents
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-lg-3 col-md-6">
            <div class="erp-card kpi-card">
                <div class="d-flex">
                    <div class="kpi-icon bg-success-subtle">
                        <i class="bi bi-building text-success"></i>
                    </div>

                    <div class="ms-3">
                        <div class="kpi-label">
                            Classes
                        </div>
                        <div class="kpi-value">
                            @Model.TotalClasses
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="erp-card kpi-card">
                <div class="d-flex">
                    <div class="kpi-icon bg-warning-subtle">
                        <i class="bi bi-clock-history text-warning"></i>
                    </div>

                    <div class="ms-3">
                        <div class="kpi-label">
                            Overdue
                        </div>
                        <div class="kpi-value text-warning">
                            @Model.OverdueCount
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- CLASS -->
    <div class="bg-white rounded-4 shadow-sm mb-2">

        <div class="p-3 border-bottom">
            <h5 class="mb-0"> Class Wise Summary </h5>
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="dashboard-table-header">
                    <tr>
                        <th>
                            <i class="bi bi-mortarboard-fill text-primary me-2"></i>
                            Class
                        </th>

                        <th>
                            <i class="bi bi-currency-rupee text-danger me-2"></i>
                            Pending Fees
                        </th>

                        <th>
                            <i class="bi bi-people-fill text-success me-2"></i>
                            Students
                        </th>

                        <th>
                            <i class="bi bi-activity text-warning me-2"></i>
                            Status
                        </th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.ClassWisePending.Any())
                    {
                        @foreach (var item in Model.ClassWisePending)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="class-icon me-3">
                                            <i class="bi bi-mortarboard-fill"></i>
                                        </div>

                                        <div>
                                            <div class="fw-semibold">
                                                @item.ClassName
                                            </div>

                                            <div class="small text-muted">
                                                @item.PendingStudents Students
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="fw-bold text-danger">
                                        ₹ @item.PendingAmount
                                    </div>
                                </td>

                                <td>
                                    <span class="badge rounded-pill bg-primary-subtle text-primary">
                                        @item.PendingStudents Students
                                    </span>
                                </td>

                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="progress flex-grow-1">
                                            <div class="progress-bar bg-danger"
                                                 style="width:@item.PendingPercentage%">
                                            </div>
                                        </div>
                                        <div class="ms-3 fw-semibold">
                                            @item.PendingPercentage%
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

    </div>

    <!-- FILTER -->
    <div class="filter-card mb-2">

        <div class="filter-header">
            <div>
                <h6 class="mb-1">
                    <i class="bi bi-funnel-fill me-2"></i>
                    Filters
                </h6>
                <small>Search and filter student records</small>
            </div>
        </div>

        <div class="row g-3 mt-1">

            <!-- Class -->
            <div class="col-lg-3 col-md-4">
                <label class="filter-label">Class</label>
                <select id="classFilter" class="form-select modern-input">
                    <option value=""> All Classes </option>
                    @foreach (var cls in ViewBag.Classes)
                    {
                        <option value="@cls.ClassName"
                                selected="@(ViewBag.ClassId == cls.ClassId)">
                            @cls.ClassName
                        </option>
                    }
                </select>
            </div>

            <!-- Search -->
            <div class="col-lg-6 col-md-8">
                <label class="filter-label"> Search Student </label>
                <div class="search-wrapper">
                    <i class="bi bi-search search-icon"></i>
                    <input type="text" id="studentSearch"
                           class="form-control modern-input search-input"
                           placeholder="Search by Name, Admission No, Roll No, Mobile..." />
                </div>
            </div>

            <!-- Buttons -->
            <div class="col-lg-3">
                <label class="filter-label opacity-0">  Action </label>
                <div class="d-flex gap-2">
                    <div class="record-summary">
                        <i class="bi bi-people-fill"></i>
                        <span>
                            Showing
                            <strong id="recordCount">
                                @(Model.PendingStudents?.Count() ?? 0)
                            </strong>
                            <small>Students Found</small>
                        </span>
                    </div>

                    <a href="@Url.Action("PendingFees")" class="btn btn-light border">
                        <i class="bi bi-arrow-clockwise"></i>
                    </a>
                    <a class="btn btn-light">
                        <i class="bi bi-download"></i>
                    </a>
                </div>
            </div>
        </div>

    </div>

    <!-- STUDENTS -->
    <div class="bg-white rounded-4 shadow-sm">
        
        <div class="table-responsive">

            <table class="table align-middle mb-0">
                <thead class="table-header-modern">
                    <tr>
                        <th><i class="bi bi-person-fill text-primary me-1"></i>Student</th>
                        <th><i class="bi bi-building text-success me-1"></i>Class</th>
                        <th><i class="bi bi-person-vcard-fill text-info me-1"></i>Admission No.</th>
                        <th><i class="bi bi-telephone-fill text-secondary me-1"></i>Contact</th>
                        <th><i class="bi bi-wallet2 text-danger me-1"></i>Outstanding</th>
                        <th><i class="bi bi-calendar2-event text-warning me-1"></i>Payment Due</th>
                        <th class="text-center"><i class="bi bi-flag-fill text-success me-1"></i>Status</th>
                    </tr>
                </thead>

                <tbody id="studentTableBody">
                    @foreach (var s in Model.PendingStudents)
                    {
                        <tr data-class="@s.ClassName">
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="student-icon me-3">
                                        <i class="bi bi-person-fill text-primary"></i>
                                    </div>
                                    <div class="fw-semibold"> @s.StudentName </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge rounded-pill bg-primary-subtle text-primary">
                                    @s.ClassName
                                </span>
                            </td>
                            <td>@s.AdmissionNo</td>
                            <td>@s.MobileNo</td>
                            <td class="fw-bold text-danger">₹ @s.PendingAmount</td>
                            <td>
                                <i class="bi bi-calendar-event text-muted me-2"></i>
                                @s.DueDate.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                <span class="status-pill
                                    @(s.IsOverdue ? "overdue" : "pending")">
                                    @(s.IsOverdue? "Overdue": "Pending")
                                </span>
                            </td>
                        </tr> 
                    }
                </tbody>

            </table>
        </div>

    </div>

</div>

@section Scripts 
{
    <script>

        $(document).ready(function () {

            $("#studentSearch").on("keyup", filterStudents);
            $("#classFilter").on("change", filterStudents);

            function filterStudents()
            {
                var search = $("#studentSearch").val().toLowerCase();
                var selectedClass = $("#classFilter").val().toLowerCase();

                $("#studentTableBody tr").each(function () {

                    var row = $(this);

                    var rowText = row.text().toLowerCase();

                    var rowClass = row.data("class").toString().toLowerCase();

                    var searchMatch = rowText.indexOf(search) > -1;

                    var classMatch =
                        selectedClass === "" ||
                        rowClass === selectedClass;

                    row.toggle(searchMatch && classMatch);

                });

                var visibleRows = $("#studentTableBody tr:visible").length;
                $("#recordCount").text(visibleRows);
            }

        });


        

        

       

    </script>
}