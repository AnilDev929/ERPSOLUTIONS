@using SchoolERP.Models.ViewModels
@model ClassTeacherAssignmentViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Class Teacher Assignment";
}

<style>
    .page-title {
        font-weight: 700;
        color: #1f2937;
    }

    .page-subtitle {
        color: #6b7280;
    }

    .filter-card,
    .assignment-card {
        border: 1px solid #e7edf5;
        border-radius: 18px;
        background: #fff;
    }

    .assignment-card {
        transition: all .25s ease;
        overflow: hidden;
    }

    .assignment-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 35px rgba(0,0,0,.08);
        border-color: #cdd8eb;
    }

    .card-top-border {
        height: 5px;
        background: linear-gradient(90deg,#0d6efd,#4f8dfd);
    }

    .teacher-box {
        background: linear-gradient(145deg,#f8fbff,#ffffff);
        border: 1px solid #edf2f7;
        border-radius: 16px;
        padding: 16px;
    }

    .teacher-avatar {
        width: 54px;
        height: 54px;
        border-radius: 50%;
        background: linear-gradient(135deg,#0d6efd,#4f8dfd);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        box-shadow: 0 6px 18px rgba(13,110,253,.25);
    }

    .badge-status {
        border-radius: 30px;
        padding: .6rem .9rem;
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .3px;
        display: inline-flex;
        align-items: center;
        border: 1px solid transparent;
    }

    .badge-assigned {
        background: #e8f8ee;
        color: #198754;
        border-color: #b7e4c7;
    }

    .badge-unassigned {
        background: #fff3cd;
        color: #856404;
        border-color: #ffda6a;
    }

    .modal-content {
        border-radius: 22px;
    }

    .stats-box {
        border: 1px dashed #d7e2f0;
        border-radius: 14px;
        padding: 16px;
        background: #fff;
    }


    .assignment-modal {
        border-radius: 26px;
        overflow: hidden;
        border: 0;
        box-shadow: 0 30px 70px rgba(0,0,0,.16);
    }

    /* HEADER */

    .modal-header-custom {
        background: linear-gradient( 135deg, #0f172a 0%, #1e3a8a 45%, #2563eb 100%);
        padding: 1.25rem 1.5rem;
        border-bottom: 0;
    }

    /* HEADER ICON */

    .modal-icon-wrapper {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        background: rgba(255,255,255,.12);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 24px;
        backdrop-filter: blur(6px);
    }

    /* BODY */

    .modal-body {
        background: #f8fafc;
    }

    /* FORM CARD */

    .form-card {
        background: #fff;
        border-radius: 18px;
        padding: 18px;
        border: 1px solid #e7edf5;
        transition: .2s ease;
    }

        .form-card:hover {
            border-color: #c9dafc;
            box-shadow: 0 6px 18px rgba(37,99,235,.06);
        }

    /* LABEL */

    .custom-label {
        font-weight: 700;
        margin-bottom: 10px;
        color: #1e293b;
    }

    /* SELECT */

    .custom-select {
        min-height: 52px;
        border-radius: 12px;
        border: 1px solid #dbe4f0;
        font-weight: 500;
    }

        .custom-select:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 .2rem rgba(37,99,235,.12);
        }

    /* TEACHER CARD */

    .teacher-preview-card {
        background: linear-gradient( 145deg, #ffffff, #f8fbff);
        border-radius: 22px;
        padding: 28px 20px;
        text-align: center;
        border: 1px solid #e6edf7;
        box-shadow: 0 10px 30px rgba(15,23,42,.05);
    }

    /* AVATAR */

    .teacher-avatar-large {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        margin: auto auto 18px;
        background: linear-gradient( 135deg, #2563eb, #60a5fa);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        font-weight: 700;
        box-shadow: 0 12px 28px rgba(37,99,235,.28);
    }

    /* SUMMARY */

    .summary-card {
        background: #fff;
        border-radius: 22px;
        padding: 22px;
        border: 1px solid #e7edf5;
    }

    .summary-title {
        font-size: 1rem;
        font-weight: 700;
        margin-bottom: 18px;
        color: #0f172a;
    }

    .summary-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 0;
        border-bottom: 1px dashed #dbe4f0;
    }

    .summary-value {
        font-weight: 700;
        color: #1d4ed8;
    }

    /* FOOTER */

    .modal-footer-custom {
        background: #f1f5f9;
        border-top: 1px solid #e2e8f0;
        padding: 1rem 1.5rem;
    }

    /* FOOTER BUTTON */

    .btn-footer {
        min-width: 140px;
        border-radius: 12px;
        font-weight: 600;
        padding: .7rem 1rem;
    }
</style>

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title mb-1"><i class="bi bi-person-workspace text-primary me-2"></i> Class Teacher Assignment</h2>
            <p class="page-subtitle mb-0"> Manage class teacher assignment section wise</p>
        </div>

        <!-- NEW ASSIGNMENT BUTTON -->
        <button class="btn btn-primary shadow-sm" id="btnNewAssignment" data-bs-toggle="modal" data-bs-target="#assignModal">
            <i class="bi bi-plus-circle-fill me-1"></i> Assign Teacher</button>
    </div>

    <!-- FILTERS -->
    <form method="get" asp-action="Index">

        <div class="card border-0 filter-card shadow-sm mb-2">

            <div class="card-body">

                <div class="row g-3 align-items-end">

                    <div class="col-lg-3">
                        <label class="form-label fw-semibold"><i class="bi bi-building me-1 text-primary"></i> Class </label>
                        <select class="form-select" name="classId">
                            <option value="0">All Classes</option>
                            @foreach (var cls in Model.Classes)
                            {
                                <option value="@cls.ClassId">@cls.ClassName</option>
                            }
                        </select>
                    </div>

                    <div class="col-lg-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-ui-checks-grid me-1 text-success"></i>Status</label>

                        <select class="form-select" name="status">
                            <option value="">  All </option>
                            <option value="assigned">Assigned</option>
                            <option value="unassigned"> Unassigned</option>
                        </select>
                    </div>

                    <div class="col-lg-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-search me-1"></i> Search</label>
                        <input type="text" class="form-control"
                               name="search" placeholder="Search class / section / teacher" />
                    </div>

                    <div class="col-lg-2">
                        <button class="btn btn-dark w-100">
                            <i class="bi bi-funnel-fill me-1"></i>Filter</button>
                    </div>

                </div>

            </div>

        </div>

    </form>

    <!-- CARDS -->
    <div class="row">

        @foreach (var item in Model.Sections)
        {
            var assigned = item.ClassTeacher != null;

            <div class="col-xl-3 col-lg-4 col-md-6 mb-4">

                <div class="card assignment-card shadow-sm h-100">
                    <div class="card-top-border"></div>
                    <div class="card-body d-flex flex-column">

                        <!-- TOP -->
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h5 class="fw-bold mb-1"> @item.ClassName - @item.SectionName</h5>
                                <small class="text-muted fs-6"> <i class="bi bi-people-fill me-1"></i>@item.StudentCount Students</small>
                            </div>

                            @if (assigned)
                            {
                                <span class="badge badge-status badge-assigned"><i class="bi bi-check-circle-fill me-1"></i>
                                    Assigned</span>
                            }
                            else
                            {
                                <span class="badge badge-status badge-unassigned"> <i class="bi bi-exclamation-circle-fill me-1"></i>
                                    Unassigned
                                </span>
                            }
                        </div>

                        <!-- TEACHER BOX -->
                        <div class="teacher-box mb-3 flex-grow-1">
                            @if (assigned)
                            {
                                <div class="d-flex align-items-center">
                                    <div class="teacher-avatar me-3">@item.ClassTeacher.Initials</div>
                                    <div>
                                        <div class="fw-semibold"> @item.ClassTeacher.Name</div>
                                        <small class="text-muted">@item.ClassTeacher.SubjectName</small>
                                    </div>
                                </div>
                                <hr />
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted fs-6"> Assigned Sections</span>
                                    <span class="fw-bold text-primary"> @item.ClassTeacher.TotalAssignedSections </span>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4"> <i class="bi bi-person-x-fill text-warning fs-1 mb-3"></i>
                                    <div class="fw-semibold"> No Teacher Assigned </div>
                                </div>
                            }

                        </div>

                        <!-- ACTIONS -->
                        <div class="d-grid gap-2">
                            <!-- CHANGE / ASSIGN -->
                            <button type="button" class="btn @(assigned ? "btn-outline-primary" : "btn-primary") btnEditAssignment"
                                    data-id="@item.ClassSectionId">
                                <i class="bi bi-person-plus-fill fs-5 me-1"></i> @(assigned ? "Change Teacher" : "Assign Teacher")
                            </button>

                            <!-- REMOVE ASSIGN-->
                            @if (assigned)
                            {
                                <button type="button" class="btn btn-outline-danger btnRemoveAssignment"
                                        data-id="@item.ClassSectionId"
                                        data-name="@item.ClassName - @item.SectionName">
                                    <i class="bi bi-trash-fill me-1"></i> Remove Assignment
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- ASSIGN MODAL -->
<div class="modal fade" id="assignModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content assignment-modal">
            <!-- FORM -->
            <form asp-action="SaveAssignment" asp-controller="ClassTeacher" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="ClassSectionId" name="ClassSectionId" />

                <!-- HEADER -->
                <div class="modal-header modal-header-custom">
                    <div class="d-flex align-items-center">
                        <div class="modal-icon-wrapper me-3">
                            <i class="bi bi-person-workspace"></i>
                        </div>
                        <div>
                            <h4 class="modal-title fw-bold mb-1 text-white"> Assign Class Teacher</h4>
                            <div class="text-white-50 small"> Assign or update teacher section wise</div>
                        </div>

                    </div>
                    <button type="button" class="btn-close btn-close-white"data-bs-dismiss="modal"></button>
                </div>

                <!-- BODY -->
                <div class="modal-body p-4">
                    <div class="row g-4">
                        <!-- LEFT SIDE -->
                        <div class="col-lg-7">
                            <!-- CLASS -->
                            <div class="form-card mb-4">
                                <label class="form-label custom-label">
                                    <i class="bi bi-mortarboard-fill text-primary me-2"></i>
                                    Select Class <span class="text-danger">*</span>
                                </label>

                                <select class="form-select custom-select" id="ddlClass" name="ClassId">
                                    <option value="">Choose Class</option>
                                </select>
                            </div>

                            <!-- SECTION -->
                            <div class="form-card mb-4">

                                <label class="form-label custom-label">
                                    <i class="bi bi-diagram-3-fill text-success me-2"></i>
                                    Select Section <span class="text-danger">*</span>
                                </label>

                                <select class="form-select custom-select" id="ddlSection" name="SectionId">
                                    <option value=""> Choose Section</option>
                                </select>

                                <div id="sectionInfo" class="text-info small mt-1" style="display:none;"></div>
                            </div>

                            <!-- TEACHER -->

                            <div class="form-card">
                                <label class="form-label custom-label">
                                    <i class="bi bi-person-badge-fill text-info me-2"></i> Select Teacher <span class="text-danger">*</span>
                                </label>

                                <select class="form-select custom-select" id="ddlTeacher" name="TeacherId" required>
                                    <option value=""> Choose Teacher </option>
                                </select>
                            </div>

                        </div>

                        <!-- RIGHT SIDE -->
                        <div class="col-lg-5">

                            <!-- TEACHER PREVIEW -->
                            <div class="teacher-preview-card mb-4">
                                <div class="teacher-avatar-large"
                                     id="teacherAvatar">
                                    NA
                                </div>
                                <h5 class="fw-bold mb-1" id="teacherName"> Select Teacher </h5>
                                <div class="text-muted" id="teacherSubject"> Subject </div>
                            </div>

                            <!-- SUMMARY CARD -->
                            <div class="summary-card">

                                <div class="summary-title">
                                    <i class="bi bi-bar-chart-fill text-primary me-2"></i>Assignment Summary </div>

                                <!-- SECTION STUDENTS -->
                                <div class="summary-item">
                                    <div>
                                        <i class="bi bi-people-fill text-success me-2"></i>Section Students</div>

                                    <div class="summary-value"  id="lblClassStudents"> 0 </div>
                                </div>

                                <!-- ASSIGNED SECTIONS -->
                                <div class="summary-item">
                                    <div> <i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i> Assigned Sections</div>
                                    <div class="summary-value" id="lblSections"> 0</div>
                                </div>

                                <!-- TOTAL STUDENTS -->
                                <div class="summary-item border-0">
                                    <div>
                                        <i class="bi bi-person-lines-fill text-warning me-2"></i> Teacher Students
                                    </div>
                                    <div class="summary-value" id="lblStudents">0</div>
                                </div>
                            </div>

                        </div>

                    </div>

                </div>

                <!-- FOOTER -->
                <div class="modal-footer modal-footer-custom">
                    <button type="button"  class="btn btn-light btn-footer" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i>Cancel</button>

                    <button type="submit" class="btn btn-primary btn-footer shadow-sm">
                        <i class="bi bi-check-circle-fill me-1"></i> Save Assignment </button>
                </div>

            </form>

        </div>

    </div>

</div>

<!-- REMOVE Teacher MODAL -->
<div class="modal fade" id="removeModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow-lg">

            <form asp-action="RemoveTeacher" asp-controller="ClassTeacher" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="removeClassSectionId" name="ClassSectionId" />

                <div class="modal-header border-0">
                    <h5 class="fw-bold text-danger">
                        <i class="bi bi-trash-fill me-2"></i> Remove Assignment </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="alert alert-warning">
                        Are you sure you want to remove assignment from:
                        <strong id="removeSectionName"></strong> ?
                    </div>
                </div>

                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash-fill me-1"></i> Remove Assignment
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {

    <script>

        $(document).ready(function () {

            $("#ddlTeacher").change(function () {

                let selectedOption = $(this).find("option:selected");

                let teacherName = selectedOption.text();
                let subject = selectedOption.data("subject");

                // Update right panel
                $("#teacherName").text(teacherName || "Select Teacher");
                $("#teacherSubject").text(subject || "Subject");

                // Avatar initials
                if (teacherName && teacherName !== "Choose Teacher") {

                    let initials = teacherName
                        .split(' ')
                        .map(x => x.charAt(0))
                        .join('')
                        .substring(0, 2)
                        .toUpperCase();

                    $("#teacherAvatar").text(initials);

                } else {
                    $("#teacherAvatar").text("NA");
                }
            });

        });

        $("#assignModal").on("hidden.bs.modal", function () {

            $("form")[0].reset();

            $("#ddlClass, #ddlSection, #ddlTeacher").val("");
            $("#ddlClass, #ddlSection").prop("disabled", false);

            $("#lblClassStudents, #lblSections, #lblStudents").text("0");

            $("#teacherName").text("Select Teacher");
            $("#teacherSubject").text("Subject");
            $("#teacherAvatar").text("NA");
        });

        // NEW ASSIGNMENT
        $("#btnNewAssignment").click(async function () {

            // reset form fields
            $("form")[0].reset();

            // reset hidden field
            $("#ClassSectionId").val("");

            $("#ddlClass").prop("disabled", false);
            $("#ddlSection").prop("disabled", false);
            $("#ddlSection").empty();

            // reset labels
            $("#lblClassStudents").text("0");
            $("#lblSections").text("0");
            $("#lblStudents").text("0");

            // reset teacher preview
            $("#teacherName").text("Select Teacher");
            $("#teacherSubject").text("Subject");
            $("#teacherAvatar").text("NA");

            await loadClasses();
            await loadTeachers();

            $("#assignModal").modal("show");
        });

        // EDIT ASSIGNMENT
        $(".btnEditAssignment").click(async function () {

            const id = $(this).data("id");
            const response = await fetch(`/ClassTeacher/GetAssignment?classSectionId=${id}`);
            const data = await response.json();
            await loadClasses();
            $("#ddlClass").val(data.classId);

            await loadSections(data.classId);
            $("#ddlSection").val(data.sectionId);

            const sectionId = $("#ddlSection").val();
            $("#ClassSectionId").val(sectionId);
            const sectionResponse =
                await fetch(`/ClassTeacher/GetSectionDetails?classSectionId=${sectionId}`);
            const sectionData =
                await sectionResponse.json();
            $("#lblClassStudents").text(sectionData.students);

            await loadTeachers();
            $("#ddlTeacher").val(data.teacherId);
            $("#ddlTeacher").trigger("change");

            // LOCK CLASS / SECTION
            $("#ddlClass").prop("disabled", true);
            $("#ddlSection").prop("disabled", true);
            $("#assignModal").modal("show");

        });

        // REMOVE
        $(".btnRemoveAssignment").click(function () {
            $("#removeClassSectionId").val($(this).data("id"));
            $("#removeSectionName").text($(this).data("name"));
            $("#removeModal").modal("show");
        });

        // LOAD CLASSES

        async function loadClasses()
        {
            $("#ddlClass").empty();
            const response = await fetch('/ClassTeacher/GetClasses');
            const data = await response.json();

            $("#ddlClass").append(`
                <option value="">
                    Select Class
                </option>`);

            data.forEach(x => {

                $("#ddlClass").append(`
                    <option value="${x.classId}">
                        ${x.className}
                    </option>`);
            });
        }

        async function loadSections(classId) 
        {
            const ddl = $("#ddlSection");
            ddl.empty();

            const response = await fetch(`/ClassTeacher/GetSectionsByClass?classId=${classId}`);
            const data = await response.json();

            ddl.append(`<option value="">Select Section</option>`);

            data.forEach(x => {

                ddl.append(`
                    <option
                        value="${x.sectionId}"
                        data-classsectionid="${x.classSectionId}"
                        data-ismapped="${x.isMapped}">
                        ${x.sectionName}
                    </option>
                `);
            });

            $("#ddlSection").val(data.sectionId);
            ddl.prop("disabled", false);

            // INFO MESSAGE
            if (data.length > 0 && !data[0].isMapped) {

                $("#sectionInfo").show().text(
                    "No sections mapped to this class. Showing all available sections."
                );
            }
            else {

                $("#sectionInfo").hide().text("");
            }
        }
        

        // LOAD TEACHERS
        async function loadTeachers()
        {
            $("#ddlTeacher").empty();

            const response =
                await fetch('/ClassTeacher/GetTeachers');

            const data =
                await response.json();

            $("#ddlTeacher").append(`
                <option value="">
                    Select Teacher
                </option>`);

            data.forEach(x => {

                $("#ddlTeacher").append(`
                    <option value="${x.teacherId}"
                            data-sections="${x.totalAssignedSections}"
                            data-students="${x.totalStudents}">

                        ${x.name} (${x.subjectName})

                    </option>`);
            });
        }

        // CLASS CHANGE
        $("#ddlClass").change(async function () {
            const classId = $(this).val();
            await loadSections(classId);
        });

        $("#ddlSection").change(async function () {
            $("#ClassSectionId").val($(this).val());
            const sectionId = $(this).val();
            if (!sectionId)
            {
                $("#lblClassStudents").text(0);
                return;
            }

            const classId = $("#ddlClass").val();
            const response = await fetch(`/ClassTeacher/GetSectionDetails?ClassId=${classId}&SectionId=${sectionId}`);
            const data = await response.json();
            $("#lblClassStudents").text(data.students);

        });


        $(document).on("change", "#ddlTeacher", function () {

            const selected = $(this).find("option:selected");

            const name = selected.text();
            const subject = selected.data("subject");

            if (!$(this).val()) {
                $("#teacherName").text("Select Teacher");
                $("#teacherSubject").text("Subject");
                $("#teacherAvatar").text("NA");
                return;
            }

            $("#teacherName").text(name);
            $("#teacherSubject").text(subject || "Not Assigned");

            const initials = name
                .split(" ")
                .map(x => x.charAt(0))
                .join("")
                .substring(0, 2)
                .toUpperCase();

            $("#teacherAvatar").text(initials);
                $("#lblSections").text(selected.data("sections") || 0);
                $("#lblStudents").text(selected.data("students") || 0);
        });


    </script>

}




