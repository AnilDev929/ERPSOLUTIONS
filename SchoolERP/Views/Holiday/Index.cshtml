@using SchoolERP.Enum
@* @using SchoolERP.Models.Entities *@
@using SchoolERP.Models.ViewModels
@* @model List<Holiday> *@
@model HolidayDashboardVM

@{
    ViewBag.Title = "Holiday Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <!-- 🔷 DASHBOARD CARDS -->
    <div class="row mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-white"
                 style="background: linear-gradient(135deg, #4e73df, #224abe);">
                <div class="card-body d-flex align-items-center">
                    <i class="bi bi-calendar-event fs-2 me-3"></i>
                    <div>
                        <h5 class="mb-0">@Model.TotalHolidays</h5>
                        <small>Total Holidays</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-white"
                 style="background: linear-gradient(135deg, #f6c23e, #dda20a);">
                <div class="card-body d-flex align-items-center">
                    <i class="bi bi-hourglass-split fs-2 me-3"></i>
                    <div>
                        <h5 class="mb-0">@Model.UpcomingHolidays</h5>
                        <small>Upcoming</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-white"
                 style="background: linear-gradient(135deg, #1cc88a, #17a673);">
                <div class="card-body d-flex align-items-center">
                    <i class="bi bi-tree fs-2 me-3"></i>
                    <div>
                        <h5 class="mb-0">@Model.VacationDays</h5>
                        <small>Vacation Days</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 text-white"
                 style="background: linear-gradient(135deg, #e74a3b, #be2617);">
                <div class="card-body d-flex align-items-center">
                    <i class="bi bi-arrow-repeat fs-2 me-3"></i>
                    <div>
                        <h5 class="mb-0">@Model.RecurringHolidays</h5>
                        <small>Recurring</small>
                    </div>
                </div>
            </div>
        </div>

    </div>

    @if (Model.NextHoliday != null)
    {
        <div class="card shadow-sm border-0 mb-4"
             style="background: linear-gradient(135deg, #36b9cc, #258391); color: white;">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="mb-1">
                        <i class="bi bi-stars"></i> Next Holiday
                    </h5>

                    <h4 class="mb-0">
                        @Model.NextHoliday.Title
                    </h4>

                    <small>
                        @Model.NextHoliday.StartDate.ToString("dd MMM yyyy")
                    </small>
                </div>

                <div class="text-end">
                    <i class="bi bi-calendar-check fs-1"></i>
                </div>

            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 mb-4 text-center p-3">
            <i class="bi bi-emoji-smile fs-2 text-muted"></i>
            <p class="mb-0 text-muted">No upcoming holidays 🎉</p>
        </div>
    }

    <!-- 🔷 HEADER CARD -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body d-flex justify-content-between align-items-center"
             style="background: linear-gradient(135deg, #4e73df, #224abe); color: white; border-radius: 8px;">

            <div>
                <h4 class="mb-1">
                    <i class="bi bi-calendar-event-fill"></i> Holiday Management
                </h4>
                <small>
                    Manage school holidays, vacations, and special events efficiently.
                </small>
            </div>

            <a href="/Holiday/Create" class="btn btn-light shadow-sm">
                <i class="bi bi-plus-circle"></i> Add Holiday
            </a>
        </div>
    </div>

    <!-- 🔷 TABLE CARD -->
    <div class="card shadow-sm border-0">
        <div class="card-body">

            @if (!Model.Holidays.Any())
            {
                <div class="text-center p-4">
                    <i class="bi bi-calendar-x fs-1 text-muted"></i>
                    <p class="mt-2 text-muted">No holidays found</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th><i class="bi bi-card-text"></i> Title</th>
                                <th><i class="bi bi-calendar-date"></i> Date</th>
                                <th><i class="bi bi-tag"></i> Type</th>
                                <th class="text-end"><i class="bi bi-gear"></i> Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.Holidays)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.Title</strong>
                                    </td>

                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @item.StartDate.ToString("dd MMM yyyy")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge
                                                    @(item.Type == HolidayType.Public ? "bg-danger" :
                                                            item.Type == HolidayType.School ? "bg-primary" :
                                                            item.Type == HolidayType.Vacation ? "bg-success" : "bg-secondary")">
                                            @item.Type
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <a href="/Holiday/Create/@item.Id"
                                           class="btn btn-sm btn-outline-warning me-1">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a href="/Holiday/Delete/@item.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                                                }
                        </tbody>

                    </table>
                </div>
            }
            

        </div>
    </div>

</div>