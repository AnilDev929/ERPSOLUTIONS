<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Contact School - Help</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>

        body {
            background: #f6f8fc;
        }

        /* Hero */
        .hero {
            background: linear-gradient(135deg, #4f8cff, #6ee7b7);
            color: white;
            padding: 60px 20px;
            text-align: center;
            border-radius: 0 0 25px 25px;
        }

        /* Support cards */
        .support-card {
            border: none;
            border-radius: 14px;
            transition: 0.2s;
            text-align: center;
        }

            .support-card:hover {
                transform: translateY(-5px);
            }

        /* Button */
        .btn-contact {
            background: #1e3a8a;
            color: white;
            border-radius: 10px;
        }

            .btn-contact:hover {
                background: #162c66;
            }

    </style>
</head>

<body>

    <!-- HERO -->
    <section class="hero">
        <h2 class="fw-bold">Need Help?</h2>
        <p class="mb-0">We’re here to support parents anytime</p>
    </section>

    <!-- SUPPORT OPTIONS -->
    <div class="container py-5">

        <div class="row g-3">

            <div class="col-md-3">
                <div class="card support-card p-3">
                    <i class="bi bi-telephone fs-2 text-primary"></i>
                    <h6 class="mt-2">Call School</h6>
                    <p class="small text-muted">+91 98765 43210</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card support-card p-3">
                    <i class="bi bi-whatsapp fs-2 text-success"></i>
                    <h6 class="mt-2">WhatsApp</h6>
                    <p class="small text-muted">Quick chat support</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card support-card p-3">
                    <i class="bi bi-envelope-at fs-2 text-danger"></i>
                    <h6 class="mt-2">Email</h6>
                    <p class="small text-muted">support@school.com</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card support-card p-3">
                    <i class="bi bi-geo-alt fs-2 text-warning"></i>
                    <h6 class="mt-2">Visit Us</h6>
                    <p class="small text-muted">School Campus</p>
                </div>
            </div>

        </div>

        <!-- CONTACT FORM -->
        <div class="row mt-5 justify-content-center">

            <div class="col-md-7">
                <div class="card p-4 border-0 shadow-sm">

                    <h5 class="mb-3">Send a Message</h5>

                    <input type="text" class="form-control mb-3" placeholder="Your Name">

                    <input type="text" class="form-control mb-3" placeholder="Phone Number">

                    <textarea class="form-control mb-3" rows="4" placeholder="Describe your issue"></textarea>

                    <button class="btn btn-contact w-100">
                        Submit Request
                    </button>

                </div>
            </div>

        </div>

    </div>

</body>
</html>