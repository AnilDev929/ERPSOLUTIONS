@using SchoolERP.Models.ViewModels
@model StudentListViewModel

@{
    ViewBag.Title = "Student Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Modal container */
    .modal-content {
        border-radius: 12px;
        border: none;
        box-shadow: 0 15px 40px rgba(0,0,0,0.15);
        overflow: hidden;
    }

    /* Header */
    .custom-header {
        background: linear-gradient(135deg, #4e73df, #6f42c1);
        color: #fff;
        padding: 1rem 1.5rem;
        border-bottom: none;
    }

    /* Body */
    .modal-body {
        background: #ffffff;
        padding: 1.5rem;
    }

    /* Footer */
    .custom-footer {
        background: #f8f9fc;
        border-top: none;
        padding: 1rem 1.5rem;
    }

    /* Inputs */
    .form-control, .form-select {
        border-radius: 8px;
        padding: 10px;
        border: 1px solid #ddd;
        transition: all 0.2s ease;
    }

    .form-control:focus, .form-select:focus {
        border-color: #4e73df;
        box-shadow: 0 0 0 0.15rem rgba(78,115,223,0.2);
    }

    /* Labels */
    .form-label {
        font-weight: 500;
        color: #444;
    }

    /* Buttons */
    .btn-success {
        background: linear-gradient(135deg, #1cc88a, #17a673);
        border: none;
    }

    .btn-success:hover {
        background: linear-gradient(135deg, #17a673, #13855c);
    }

    /* .action-group {
        display: flex;
        justify-content: center;
        gap: 6px;
        flex-wrap: nowrap;
    } */

    /* .action-btn {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: .2s;
    }

    .action-btn:hover {
        transform: translateY(-2px);
    } */

    .view-student.action-btn {
        background: #eef2ff;
        color: #4f46e5;
    }

    /* .edit-btn {
        background: #fff7ed;
        color: #ea580c;
    } */

    /* .delete-btn {
        background: #fef2f2;
        color: #dc2626;
    } */

    .table-light {
        background: linear-gradient( 135deg, #4f46e5, #6366f1 );
    }

    .table thead th {
        font-weight: 600;
        font-size: 0.9rem;
        white-space: nowrap;
        vertical-align: middle;
        color: #374151;
        padding-top: 14px;
        padding-bottom: 14px;
    }

    .student-header {
        background: linear-gradient( 135deg, #4f46e5, #6366f1 );
        color: white;
        border: none;
    }

    .student-count {
        background: rgba(255,255,255,.2);
        color: white;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 20px;
    }

    .search-box {
        min-width: 280px;
    }

    .search-box .input-group {
        border-radius: 12px;
        overflow: hidden;
    }

    .search-box .form-control:focus {
        box-shadow: none;
    }

    @@media (max-width: 768px) {
        .search-box
        {
            width: 100%;
            min-width: auto;
        }
    }

    #pageLoader {
        position: fixed;
        inset: 0;
        background: rgba(255,255,255,.7);
        backdrop-filter: blur(2px);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .gender-badge {
        padding: 6px 12px;
        border-radius: 50px;
        font-size: .8rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .gender-male {
        background: #dbeafe;
        color: #2563eb;
    }

    .gender-female {
        background: #fce7f3;
        color: #db2777;
    }

    .gender-other {
        background: #f1f5f9;
        color: #475569;
    }

    .action-column {
        width: 60px;
    }

    .action-menu-btn {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        padding: 0;
    }

    .action-menu {
        min-width: 220px;
        border: none;
        border-radius: 14px;
        box-shadow: 0 10px 30px rgba(0,0,0,.12);
    }

    .dropdown-menu {
        border: none;
        border-radius: 14px;
        min-width: 220px;
        box-shadow: 0 10px 30px rgba(0,0,0,.12);
    }

    .dropdown-item {
        padding: 10px 16px;
        font-weight: 500;
        border-radius: 8px;
        margin: 2px 6px;
    }

    .dropdown-item:hover {
        background: #f8fafc;
    }

    .dropdown-toggle::after {
        display: none;
    }


    /* Full Screen Overlay */
    .loader-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(15,23,42,.35);
        backdrop-filter: blur(6px);
    }

    /* Loader Card */
    .loader-card {
        width: 280px;
        padding: 30px;
        background: rgba(255,255,255,.95);
        border-radius: 24px;
        text-align: center;
        box-shadow: 0 15px 40px rgba(0,0,0,.12);
    }

    /* ERP Icon */
    .loader-icon {
        width: 70px;
        height: 70px;
        margin: auto;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
        background: linear-gradient( 135deg, #2563eb, #4f46e5 );
        color: white;
        font-size: 30px;
    }

    /* Spinner */
    .loader-spinner {
        width: 50px;
        height: 50px;
        margin: 20px auto 0;
        border: 4px solid #e2e8f0;
        border-top: 4px solid #2563eb;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to
        {
            transform: rotate(360deg);
        }

    }
</style>

<div class="container-fluid">

    <!-- Modal -->
    <div class="modal fade" id="studentModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg border-0 rounded-3">

                <!-- Header -->
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title d-flex align-items-center">
                        <i class="bi bi-person-circle me-2"></i>
                        Student Details
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <!-- Body -->
                <div class="modal-body p-4" id="studentModalBody">
                    Loading...
                </div>

            </div>
        </div>
    </div>

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-people-fill text-primary me-2"></i>
                Student List
            </h3>

            <small class="text-muted">
                View and manage student records
            </small>
        </div>

        <a href="@Url.Action("NewStudent")" class="btn btn-success rounded-pill px-4">
            <i class="fas fa-plus me-1"></i> Add New Student
        </a>
    </div>

    <!-- 🔍 Search Card -->
    <div class="card shadow-sm mb-2">
        <div class="card-body">
            <form method="get" id="searchForm" class="row g-3 align-items-end">

                <div class="col-md-3">
                    <label class="form-label"><i class="bi bi-building me-1"></i>Class</label>
                    <select asp-for="ClassID" required asp-items="Model.Classes" class="form-select">
                        <option value="">All Classes</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label"><i class="bi bi-diagram-3 me-1"></i>Section</label>
                    <select asp-for="SectionID" required asp-items="Model.Sections" class="form-select">
                        <option value="">All Sections</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label"><i class="bi bi-hash me-1"></i>Roll Number</label>
                    <input type="text" asp-for="RollNumber" class="form-control" placeholder="Enter Roll No">
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i> Search
                    </button>
                </div>

            </form>
        </div>
    </div>

    <div id="pageLoader" class="loader-overlay d-none">

        <div class="loader-card">
            <div class="loader-icon">
                <i class="bi bi-mortarboard-fill"></i>
            </div>

            <div class="loader-spinner"></div>
            <h5 class="mt-3 mb-1">
                Please Wait...
            </h5>
            <p class="text-muted mb-0">
                Loading data from server
            </p>

        </div>

    </div>

    <!-- 📋 Student Table -->
    <div class="card shadow-sm">

        <div class="card-header student-header d-flex justify-content-between align-items-center flex-wrap gap-2">

            <div class="d-flex align-items-center">
                <i class="bi bi-people-fill fs-5 me-2"></i>
                <span class="fw-semibold">
                    Students
                </span>
                <span class="badge student-count ms-2">
                    @Model.Students.Count()
                </span>
            </div>

            <div class="search-box">
                <div class="input-group input-group-sm">
                    <span class="input-group-text border-0 bg-white">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text"
                           id="studentSearch"
                           class="form-control border-0"
                           placeholder="Search student..." />

                </div>
            </div>

        </div>

        <div class="card-body p-0">
            @Html.AntiForgeryToken()
            <div class="table-responsive">
                <table id="studentTable" class="table table-hover table-bordered mb-0 align-middle">
                   
                    <thead class="table-light">
                        <tr>
                            <th>
                                <i class="bi bi-mortarboard-fill text-success me-2"></i>
                                Class
                            </th>
                            <th class="d-none d-md-table-cell">
                                <i class="bi bi-diagram-3-fill text-warning me-2"></i>
                                Section
                            </th>
                            <th>
                                <i class="bi bi-person-circle text-primary me-2"></i>
                                Student Name
                            </th>
                            <th class="d-none d-md-table-cell">
                                <i class="bi bi-gender-ambiguous text-purple me-2"></i>
                                Gender
                            </th>
                            <th>
                                <i class="bi bi-calendar-check-fill text-success me-2"></i>
                                Join Date
                            </th>
                            <th>
                                <i class="bi bi-person-vcard-fill text-info me-2"></i>
                                Admission No.
                            </th>
                            <th>
                                <i class="bi bi-hash text-secondary me-2"></i>
                                Roll No
                            </th>
                            <th class="d-none d-md-table-cell">
                                <i class="bi bi-telephone-fill text-danger me-2"></i>
                                Mobile
                            </th>
                            <th class="d-none d-md-table-cell">
                                <i class="bi bi-envelope-fill text-info me-2"></i>
                                Email
                            </th>
                            <th><i class="bi bi-shield-check me-2"></i>Status</th>
                            <th class="text-center">
                                <i class="bi bi-sliders text-dark me-2"></i>
                                Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Students.Any())
                        {
                            foreach (var s in Model.Students)
                            {
                                <tr>
                                    <td>@s.ClassName</td>
                                    <td class="d-none d-md-table-cell">@s.SectionName</td>
                                    <td>@s.StudentName</td>
                                    <td class="d-none d-md-table-cell">
                                        @if (s.Gender == 1)
                                        {
                                            <span class="gender-badge gender-male">
                                                <i class="bi bi-gender-male"></i>
                                                Male
                                            </span>
                                        }
                                        else if (s.Gender == 2)
                                        {
                                            <span class="gender-badge gender-female">
                                                <i class="bi bi-gender-female"></i>
                                                Female
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="gender-badge gender-other">
                                                <i class="bi bi-gender-ambiguous"></i>
                                                Other
                                            </span>
                                        }
                                    </td>
                                    <td>@s.JoinDate</td>
                                    <td>@s.AdmissionNumber</td>
                                    <td>@s.RollNumber</td>
                                    <td class="d-none d-md-table-cell">@s.PhoneNumber</td>
                                    <td class="d-none d-md-table-cell">@s.EmilID</td>
                                    <td>
                                        @if (s.IsActive)
                                        {
                                            <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-2">
                                                <i class="bi bi-check-circle-fill me-1"></i>
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">
                                                <i class="bi bi-x-circle-fill me-1"></i>
                                                Inactive
                                            </span>
                                        }
                                    </td>
                                    @* <td class="text-center action-column">
                                        <div class="action-group">
                                            <a href="javascript:void(0);" class="action-btn view-student"
                                               data-id="@s.StudentID" title="View">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a href="@Url.Action("Edit", "Students", new { id = s.StudentID })"
                                               class="action-btn edit-btn" title="Edit">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            @if (s.IsActive)
                                            {
                                                <a href="javascript:void(0)"
                                                   class="action-btn delete-btn delete-student"
                                                   data-id="@s.StudentID" data-name="@s.StudentName" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            }
                                        </div>
                                    </td> *@

                                    <td class="text-center action-column">
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-light border action-menu-btn"
                                                    type="button" data-bs-toggle="dropdown">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end action-menu">
                                                <!-- Student -->
                                                <li>
                                                    <a class="dropdown-item view-student" href="javascript:void(0);" data-id="@s.StudentID">
                                                        <i class="bi bi-eye-fill text-primary me-2"></i>View Details
                                                    </a>
                                                </li>

                                                <li>
                                                    <a class="dropdown-item" href="@Url.Action("Edit","Students", new { id = s.StudentID })">
                                                        <i class="bi bi-pencil-square text-success me-2"></i>
                                                        Edit Details
                                                    </a>
                                                </li>

                                                <li><hr class="dropdown-divider"></li>

                                                <!-- Academic -->
                                                <li>
                                                    <a class="dropdown-item" 
                                                       href="@Url.Action("StudentFees", "Fees", new { studentId = s.StudentID })">
                                                    <i class="bi bi-cash-stack text-warning me-2"></i> Fees
                                                    </a>
                                                </li>

                                                <li>
                                                    <a class="dropdown-item" href="@Url.Action("UploadDocuments", "Students", new { studentId = s.StudentID })">
                                                        <i class="bi bi-cloud-arrow-up-fill text-info me-2"></i>
                                                        Upload Documents
                                                    </a>
                                                </li>

                                                @if (s.IsActive)
                                                {
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <a class="dropdown-item text-danger delete-student"
                                                            href="javascript:void(0)"
                                                            data-id="@s.StudentID"
                                                            data-name="@s.StudentName">

                                                            <i class="bi bi-trash-fill me-2"></i> Delete Student
                                                        </a>
                                                    </li>
                                                }

                                            </ul>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-3">
                                    <i class="bi bi-info-circle me-1"></i>No students found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>

    document.getElementById("studentSearch").addEventListener("keyup", function () 
    {
        let value = this.value.toLowerCase();

        let rows = document.querySelectorAll(
            "#studentTable tbody tr"
        );

        rows.forEach(row => {
            let text = row.innerText.toLowerCase();
            row.style.display =
                text.includes(value)
                    ? ""
                    : "none";
        });
    });

    $(document).ready(function () {

        // Initialize Bootstrap 5 modal
        var studentModalEl = document.getElementById('studentModal');
        var studentModal = new bootstrap.Modal(studentModalEl, {
            backdrop: 'static', // prevents outside click closing
            keyboard: false      // disables ESC key closing
        });

        $(".view-student").click(function () {
            var studentId = $(this).data("id");

            $("#studentModalBody").html("Loading...");

            $.get('/Students/Details', { id: studentId }, function (data) {
                $("#studentModalBody").html(data);

                // Show modal safely using JS API
                studentModal.show();
            });
        });

        // Optional: focus close button after modal is fully shown
        studentModalEl.addEventListener('shown.bs.modal', function () {
            $(studentModalEl).find('.btn-close').focus();
        });

        $("#searchForm").on("submit", function () {
            $("#searchBtn").prop("disabled", true);

            $("#btnText").addClass("d-none");
            $("#btnLoader").removeClass("d-none");

            $("#pageLoader").removeClass("d-none");
        });

    });


    $(document).on("click", ".delete-student", function () {

        let studentId = $(this).data("id");
        let studentName = $(this).data("name");

        Swal.fire({
            title: "Delete Student?",
            html: `
                <b>${studentName}</b><br>
                This action cannot be undone.
            `,
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#dc3545",
            cancelButtonColor: "#6c757d",
            confirmButtonText: "Yes, Delete",
            cancelButtonText: "Cancel",
            reverseButtons: true
        })
        .then((result) => {

            if (result.isConfirmed) 
            {
                $.ajax({
                    url: '/Students/Delete',
                    type: 'POST',
                    data: {
                        id: studentId,
                        __RequestVerificationToken:
                            $('input[name="__RequestVerificationToken"]').val()
                    },

                    success: function (response) {

                        if (response.success) {

                            Swal.fire({
                                icon: 'success',
                                title: 'Deleted!',
                                text: response.message,
                                timer: 1500,
                                showConfirmButton: false
                            })
                            .then(() => {
                                location.reload();
                            });

                        } else {

                            Swal.fire(
                                'Error',
                                response.message,
                                'error'
                            );
                        }
                    },

                    error: function () {
                        Swal.fire(
                            'Error',
                            'Something went wrong.',
                            'error'
                        );
                    }
                });
            }
        });

    });

</script>