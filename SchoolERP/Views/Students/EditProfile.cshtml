@using SchoolERP.Models.DTOS
@model EditStudentProfileDto

@{
    ViewData["Title"] = "Student Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .card-header-3d {
        color: #fff;
        font-weight: 600;
        border: none;
        padding: 12px 15px;
        border-radius: 10px 10px 0 0;
        background: linear-gradient(135deg, #4e54c8, #8f94fb);
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    }

    .card-3d {
        border: none;
        border-radius: 12px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.08);
        transition: 0.2s;
    }

    .card-3d:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.12);
    }

    /* 🔘 Perfect circular button */
    #saveBtn{
        position: absolute;
        bottom: 5px;
        right: 5px;
        width: 38px;
        height: 38px;
    }

    .upload-btn {
        position: absolute;
        bottom: 5px;
        right: 5px;
        width: 38px;
        height: 38px;
        background: #4e73df;
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 3px 8px rgba(0,0,0,0.2);
        transition: all 0.2s ease;
    }

    /* Hover effect */
    .upload-btn:hover {
        background: #224abe;
        transform: scale(1.1);
    }

    /* Icon size */
    .upload-btn i {
        font-size: 16px;
    }

</style>

<div class="container mt-4">

    <div class="modal fade" id="editAddressModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Update Address</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-6">
                        <label>Address</label>
                        <textarea class="form-control" id="modalAddress"></textarea>
                    </div>

                    <div class="col-md-6">
                        <label>City</label>
                        <input type="text" class="form-control" id="modalCity">
                    </div>

                    <div class="col-md-6">
                        <label>State</label>
                        <input type="text" class="form-control" id="modalState">
                    </div>

                    <div class="col-md-6">
                        <label>Pincode</label>
                        <input type="text" class="form-control" id="modalPincode" maxlength="6">
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btnSaveAddress"
                            class="btn btn-success" onclick="saveAddress()">
                        <span id="btnText"> Save Changes</span>
                        <span id="btnLoader" class="d-none">
                            <span class="spinner-border spinner-border-sm me-1"></span>Saving... </span>
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- Header -->
    <div class="mb-4">
        <h3 class="fw-bold mb-1 text-dark">
            <i class="fas fa-user-edit text-primary me-2"></i> Edit Profile
        </h3>
        <small class="text-muted">Update your profile information</small>
    </div>

    <form asp-action="EditProfile" method="post">
        <input type="hidden" asp-for="Id" />
        
        <div class="row g-3">

            <!-- ================= LEFT SIDE : EDIT FORM ================= -->
            <div class="col-lg-8">

                <!-- PERSONAL INFO CARD -->
                <div class="card shadow-sm mb-3">

                    <div class="card-header text-white fw-semibold"
                         style="background: linear-gradient(135deg,#4e54c8,#8f94fb);">
                        <i class="bi bi-person-lines-fill me-2"></i> Personal Information
                    </div>

                    <div class="card-body row g-3">

                        <div class="col-md-6">
                            <label>Name</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input asp-for="StudentName" class="form-control" readonly />
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label>Gender</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-gender-ambiguous"></i></span>
                                <select asp-for="GenderID" class="form-control" disabled asp-items="ViewBag.Genders" >
                                    <option value="">Select</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label>DOB</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-calendar-date"></i></span>
                                <input type="date" asp-for="DateOfBirth" class="form-control" readonly />
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label>Blood Group</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-droplet-fill"></i></span>
                                <select asp-for="BloodGroup" disabled class="form-select">
                                    <option value="">Select</option>
                                    <option>A+</option>
                                    <option>A-</option>
                                    <option>B+</option>
                                    <option>B-</option>
                                    <option>O+</option>
                                    <option>O-</option>
                                    <option>AB+</option>
                                    <option>AB-</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label>Category</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-tags-fill"></i></span>
                                <select asp-for="Category" class="form-select" disabled>
                                    <option>General</option>
                                    <option>OBC</option>
                                    <option>SC</option>
                                    <option>ST</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label>Religion</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                                <input asp-for="Religion" disabled class="form-control" />
                            </div>
                        </div>
                        <!-- Read-only -->
                        <div class="col-md-3">
                            <label>Academic Year</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-calendar"></i></span>
                                <input asp-for="AcademicYear" class="form-control" readonly />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- IDENTITY -->
                <div class="card shadow-sm">

                    <div class="card-header text-white fw-semibold"
                         style="background: linear-gradient(135deg,#11998e,#38ef7d);">
                        <i class="bi bi-shield-lock-fill"></i> Identity Details
                    </div>

                    <div class="card-body row g-3">
                        <div class="col-md-3">
                            <label>Aadhaar</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-credit-card"></i></span>
                                <input value="@Model.AadhaarMasked" class="form-control" readonly />
                            </div>
                        </div>
                        
                        <div class="col-md-3">
                            <label>Apaar ID</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-credit-card-2-front"></i></span>
                                <input value="@Model.ApaarIDMasked" class="form-control" readonly />
                            </div>
                        </div>

                    </div>
                </div>

            </div>

            <!-- ================= RIGHT SIDE : PROFILE PANEL ================= -->
            <div class="col-lg-4">

                <div class="card shadow-sm sticky-top" style="top:15px;">

                    <!-- PROFILE HEADER -->
                    <div class="card-header text-center text-white"
                         style="background: linear-gradient(135deg,#ff416c,#ff4b2b);">

                        <div class="text-center position-relative d-inline-block">

                            <img id="profilePreview"
                                 src="@(string.IsNullOrEmpty(Model.ProfileImagePath) ? "/images/default-user.png" : Model.ProfileImagePath)"
                                 class="rounded-circle border border-4 border-white shadow"
                                 width="130" height="130" />

                            <!-- Upload Button (Overlay) -->
                            <label for="photoInput" class="upload-btn">
                                <i class="bi bi-camera-fill"></i>
                                <input type="file"
                                       id="photoInput"
                                       accept="image/*"
                                       class="d-none"/>
                            </label>

                            <!-- Save Button (Floating) -->
                            <button id="saveBtn" type="button" class="btn btn-success btn-sm rounded-circle d-none shadow" onclick="saveProfileImage()" >
                                <i class="bi bi-check-lg"></i>
                            </button>
                        </div>

                        <h6 class="mt-2 mb-0">@Model.StudentName</h6>
                    </div>

                    <div class="card-body">
                        @* Admission Year *@
                        <div class="mb-2">
                            <i class="bi bi-calendar text-success me-2"></i>
                            Admission: <strong>@Model.AdmissionYear</strong>
                        </div>
                        <!-- CONTACT -->
                        <div class="mb-2">
                            <i class="bi bi-envelope-at text-danger me-2"></i>
                            @Model.EmailID
                        </div>

                        <div class="mb-2">
                            <i class="bi bi-phone-fill text-warning me-2"></i>
                            @Model.PhoneNo
                        </div>
                        <hr />

                        <!-- CLASS / SECTION -->
                        <div class="mb-2">
                            <i class="bi bi-mortarboard-fill text-primary me-2"></i>
                            <strong>@Model.Class - @Model.Section</strong>
                        </div>
                        
                        <!-- ROLL -->
                        <div class="mb-2">
                            <i class="bi bi-hash text-success me-2"></i>
                            Roll No: <strong>@Model.RollNumber</strong>
                        </div>

                    </div>
                </div>

            </div>

        </div>

        <div class="row g-3">
            <div class="col-lg-12">
                <!-- CONTACT -->
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                        <div>
                            <i class="bi bi-telephone-fill"></i> Communication Details
                        </div>

                        <button type="button" class="btn btn-warning" onclick="openAddressModal(@Model.Id)">
                            Edit Address
                        </button>
                    </div>

                    <div class="card-body row g-3">

                        <div class="col-md-3">
                            <label>Address</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                                <textarea asp-for="PermanentAddress"
                                          class="form-control" placeholder="Enter Address"
                                          maxlength="250" required></textarea>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label>City</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-building"></i></span>
                                <input asp-for="City" class="form-control" placeholder="City" required />
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label>State</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-map"></i></span>
                                <input asp-for="State" class="form-control" placeholder="State" required />
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label>Pincode</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-mailbox"></i></span>
                                <input asp-for="Pincode" class="form-control"
                                       maxlength="6" required
                                       pattern="\d{6}"
                                       oninput="allowOnlyNumbers(this)"
                                       placeholder="Pincode" />
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <div class="col-lg-12">
                <!-- ACADEMIC -->
                <div class="card mb-3 shadow-sm">
                    <div class="card-header bg-info text-white">
                        <i class="bi bi-mortarboard-fill"></i> Previous Academic Information
                    </div>
                    <div class="card-body row g-3">
                        <div class="col-md-4">
                            <label>Previous School</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-building"></i>
                                </span>
                                <input type="text" asp-for="PreviousSchoolName"
                                       class="form-control"
                                       placeholder="Enter previous school name"
                                       maxlength="150" readonly>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label>Last Class Studied</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-journal-text"></i>
                                </span>
                                <input asp-for="LastClassStudied" class="form-control" readonly />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label>Result (%)</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-bar-chart"></i>
                                </span>
                                <input asp-for="LastClassResult" class="form-control" readonly />
                            </div>
                        </div>

                        <div class="col-md-2">
                            <label>Medium of Education</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-translate"></i>
                                </span>
                                <input asp-for="MediumOfEducation" class="form-control" readonly />
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- FAMILY -->
        <div class="card mb-3 shadow-sm">
            <div class="card-header bg-warning">
                <i class="bi bi-people-fill"></i> Family Details
            </div>
            <div class="card-body row g-3">

                <div class="col-md-6">
                    <label>Father Name</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                        <input type="text" asp-for="FatherName" readonly
                               class="form-control" placeholder="Father Name"
                               maxlength="100">
                    </div>
                </div>

                <div class="col-md-6">
                    <label>Mother Name</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person-heart"></i></span>
                        <input type="text" asp-for="MotherName" readonly
                               class="form-control" placeholder="Mother Name"
                               maxlength="100">
                    </div>
                </div>

                <div class="col-md-4">
                    <label>Parent Occupation</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-briefcase"></i>
                        </span>
                        <input asp-for="ParentOccupation" class="form-control" placeholder="Occupation" required />
                    </div>
                </div>

                <div class="col-md-4">
                    <label>Parent Email</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-envelope-at"></i>
                        </span>
                        <input asp-for="ParentEmail" type="email"
                               class="form-control" placeholder="Parent Email" />
                    </div>
                </div>

                <div class="col-md-4">
                    <label>Annual Income</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-currency-rupee"></i>
                        </span>
                        <input asp-for="AnnualIncome" type="number"
                               class="form-control" placeholder="Annual Income" required />
                    </div>
                </div>

                <!-- Sensitive -->
                <div class="col-md-4">
                    <label>Father Aadhaar No</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-credit-card"></i></span>
                        <input type="text" asp-for="FatherAadhaar" readonly                              
                               class="form-control" placeholder="Enter Aadhaar" maxlength="12">
                    </div>
                </div>

                <div class="col-md-4">
                    <label>Mother Aadhaar No</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-credit-card"></i></span>
                        <input type="text" asp-for="MotherAadhaar" required maxlength="12"
                               class="form-control" readonly placeholder="Enter Aadhaar">
                    </div>
                </div>

            </div>
        </div>

        <!-- 🔘 Buttons -->
        <div class="text-end">

            @* <button type="submit" class="btn btn-success" id="saveBtn">
                <i class="bi bi-check-circle"></i> Save
            </button> *@
            <a class="btn btn-secondary px-4" href="/Students/MyProfile">
                <i class="bi bi-x-circle"></i> Cancel
            </a>
            
        </div>
    </form>


</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        let selectedFile = null;
        const input = document.getElementById("photoInput");
        const preview = document.getElementById("profilePreview");

        function allowOnlyNumbers(input) {
            input.value = input.value.replace(/\D/g, '');
        }

        input.addEventListener("change", function () {
            const file = this.files[0];

            if (!file) return;

            selectedFile = file; // ✅ FIX HERE

            // Validate file type
            if (!file.type.startsWith("image/")) {
                Swal.fire({
                            icon: 'warning',
                            title: 'Please select a valid image file.'
                        });
                this.value = "";
                return;
            }

            // Validate size (max 2MB)
            if (file.size > 2 * 1024 * 1024) {
                Swal.fire({
                            icon: 'warning',
                            title: 'Image size must be less than 2MB.'
                        });
                this.value = "";
                return;
            }

            const reader = new FileReader();
            reader.onload = function (e) {
                preview.src = e.target.result;

                 // Show save button
                $('#saveBtn').removeClass('d-none');
            };

            reader.readAsDataURL(file);
        });

        function saveProfileImage() {

            if (!selectedFile) {
                Swal.fire({
                            icon: 'warning',
                            title: 'Please select an image first.'
                        });
                return;
            }

            $('#saveBtn').addClass('d-none');

            let token = $('input[name="__RequestVerificationToken"]').val();
            let formData = new FormData();
            formData.append("photo", selectedFile);

            $.ajax({
                url: '/Students/UploadProfilePhoto',
                type: 'POST',
                data: formData,
                headers: {
                    'RequestVerificationToken': token
                },
                contentType: false,
                processData: false,
                success: function (res) {

                    if (res.success) {
                        $('#saveBtn').addClass('d-none');

                         Swal.fire({
                            icon: 'success',
                            title: res.message || 'Profile upadted'
                        });
                    }
                    else{
                          Swal.fire({
                            icon: 'error',
                            title: res.message || 'Failed to save'
                        });
                    }
                },
                complete: function () {

                    // Re-enable button
                    $('#saveBtn').removeClass('d-none');

                }
            });
        }

        function openAddressModal(studentId) {

            $.ajax({
                url: '/Students/GetAddress',
                type: 'GET',
                data: { studentId: studentId },
                success: function (data) {

                    $('#modalAddress').val(data.address);
                    $('#modalCity').val(data.city);
                    $('#modalState').val(data.state);
                    $('#modalPincode').val(data.pincode);

                    $('#editAddressModal').data('id', studentId);

                    var modal = new bootstrap.Modal(document.getElementById('editAddressModal'));
                    modal.show();
                },
                error: function () {
                    Swal.fire({
                            icon: 'error',
                            title: 'Error while fetching data'
                        });
                }
            });
        }

        function saveAddress() {

            var studentId = $('#editAddressModal').data('id');

            // Disable button
            $("#btnSaveAddress").prop("disabled", true);
            // Show loader text
            $("#btnText").addClass("d-none");
            $("#btnLoader").removeClass("d-none");

            var model = {
                StudentId: studentId,
                Address: $('#modalAddress').val(),
                City: $('#modalCity').val(),
                State: $('#modalState').val(),
                Pincode: $('#modalPincode').val()
            };

            $.ajax({
                url: '/Students/UpdateAddress',
                type: 'POST',
                data: model,
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    
                    if (response.success) {

                        Swal.fire({
                            icon: 'success',
                            title: 'Updated successfully'
                        });

                        // update UI without reload
                        $('#PermanentAddress').val(model.Address);
                        $('#City').val(model.City);
                        $('#State').val(model.State);
                        $('#Pincode').val(model.Pincode);

                        let modal = bootstrap.Modal.getInstance(document.getElementById('editAddressModal'));
                        modal.hide();
                    }
                },
                error: function () {
                    Swal.fire({
                            icon: 'error',
                            title: 'Updated failed'
                        });

                },
                complete: function () {

                    // Re-enable button
                    $("#btnSaveAddress").prop("disabled", false);

                    // Restore text
                    $("#btnText").removeClass("d-none");
                    $("#btnLoader").addClass("d-none");
                }
            });

           
        }

    </script>

}