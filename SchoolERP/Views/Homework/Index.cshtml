                        <div>
                            <p class="text-muted mb-1">Overdue</p>
                            <h3 class="fw-bold mb-0">@Model.Overdue</h3>
                        </div>

                        <div class="dashboard-icon bg-danger-subtle text-danger">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        </div>

                    </div>

                </div>

            </div>
        </div>

    </div> *@


    <!-- Homework List -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex justify-content-between align-items-center flex-wrap">

                <h5 class="fw-bold mb-0">
                    Recent Homework
                </h5>

                <div class="d-flex gap-2">

                    <input type="text"
                           class="form-control rounded-pill"
                           placeholder="Search Homework..." />

                    <select id="allsubject" class="form-select rounded-pill">
                        <option>All Subjects</option>
                    </select>

                </div>

            </div>

        </div>

        <div class="card-body">

            @if (Model.Homeworks.Any())
            {
                @foreach (var item in Model.Homeworks)
                {
                    var badgeClass = "bg-warning";

                    if (item.Status == "Completed")
                    {
                        badgeClass = "bg-success";
                    }
                    else if (item.Status == "Overdue")
                    {
                        badgeClass = "bg-danger";
                    }

                    <div class="homework-card border rounded-4 p-3 mb-3">

                        <div class="row align-items-center">

                            <!-- Subject -->
                            <div class="col-md-3">

                                <div class="d-flex align-items-center">

                                    <div class="subject-icon bg-primary-subtle text-primary me-3">
                                        <i class="bi bi-book-fill"></i>
                                    </div>

                                    <div>
                                        <h6 class="fw-bold mb-1">
                                            @item.SubjectName
                                        </h6>

                                        <small class="text-muted">
                                            @item.ClassName
                                        </small>
                                    </div>

                                </div>

                            </div>


                            <!-- Homework Info -->
                            <div class="col-md-4">

                                <h6 class="fw-semibold mb-1">
                                    @item.Title
                                </h6>

                                <small class="text-muted">
                                    Due:
                                    @item.DueDate.ToString("dd MMM yyyy")
                                </small>

                            </div>


                            <!-- Progress -->
                            <div class="col-md-2">

                                <div class="small text-muted mb-1">
                                    Submission
                                </div>

                                <div class="fw-semibold">
                                    @item.SubmittedCount/@item.TotalStudents
                                </div>

                                <div class="progress mt-1" style="height:6px;">

                                    @{
                                        var progress =
                                        (item.TotalStudents > 0)
                                        ? ((item.SubmittedCount * 100)
                                        / item.TotalStudents)
                                        : 0;
                                    }

                                    <div class="progress-bar bg-success"
                                         style="width:@progress%">
                                    </div>

                                </div>

                            </div>


                            <!-- Status -->
                            <div class="col-md-1 text-center">

                                <span class="badge @badgeClass rounded-pill px-3 py-2">
                                    @item.Status
                                </span>

                            </div>


                            <!-- Actions -->
                            <div class="col-md-2 text-end">

                                <a href="/Homework/Details/@item.HomeworkId"
                                   class="btn btn-light btn-sm rounded-pill">
                                    View
                                </a>

                                <a href="/Homework/Review/@item.HomeworkId"
                                   class="btn btn-primary btn-sm rounded-pill">
                                    Review
                                </a>

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">

                    <img src="/images/empty-homework.svg"
                         width="120"
                         class="mb-3" />

                    <h5 class="fw-bold">
                        No Homework Found
                    </h5>

                    <p class="text-muted">
                        Start by creating your first homework assignment.
                    </p>

                </div>
            }

        </div>

    </div>

</div>