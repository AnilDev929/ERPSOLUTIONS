                        <div>
                            <p class="text-muted mb-1">Pending Review </p>
                            <h3 class="fw-bold mb-0"> @Model.PendingReview</h3>
                        </div>

                        <div class="dashboard-icon bg-warning-subtle text-warning">
                            <i class="bi bi-clock-history"></i>
                        </div>

                    </div>

