@using SchoolERP.Models.ViewModels
@model TeacherHomeworkDashboardVM
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Homework Dashboard";
}

<style>
    .dashboard-card {
        border-radius: 20px;
        transition: 0.3s ease;
    }

    .dashboard-card:hover {
        transform: translateY(-4px);
    }

    .dashboard-icon {
        width: 60px;
        height: 60px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .homework-card {
        transition: all 0.3s ease;
        background: #fff;
    }

    .homework-card:hover {
        box-shadow: 0 6px 18px rgba(0,0,0,0.08);
        transform: translateY(-2px);
    }

    .subject-icon {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }



    .stats-card {
        position: relative;
        overflow: hidden;
        border-radius: 22px;
        padding: 24px;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(0,0,0,0.04);
        transition: all 0.3s ease;
        border: 1px solid #f1f3f5;
        height: 100%;
    }

    .stats-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 16px 40px rgba(0,0,0,0.08);
    }

    .stats-card-body {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .stats-title {
        font-size: 14px;
        color: #6c757d;
        margin-bottom: 10px;
        font-weight: 500;
    }

    .stats-value {
        font-size: 36px;
        font-weight: 700;
        margin-bottom: 6px;
        color: #111827;
        line-height: 1;
    }

    .stats-subtitle {
        font-size: 13px;
        color: #9ca3af;
    }

    .stats-icon {
        width: 72px;
        height: 72px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        flex-shrink: 0;
    }


    /* PRIMARY */
    .primary-card {
        border-left: 5px solid #0d6efd;
    }

    .primary-card .stats-icon {
        background: rgba(13,110,253,0.12);
        color: #0d6efd;
    }


    /* WARNING */
    .warning-card {
        border-left: 5px solid #f59e0b;
    }

    .warning-card .stats-icon {
        background: rgba(245,158,11,0.12);
        color: #f59e0b;
    }


    /* SUCCESS */
    .success-card {
        border-left: 5px solid #10b981;
    }

    .success-card .stats-icon {
        background: rgba(16,185,129,0.12);
        color: #10b981;
    }


    /* DANGER */
    .danger-card {
        border-left: 5px solid #ef4444;
    }

    .danger-card .stats-icon {
        background: rgba(239,68,68,0.12);
        color: #ef4444;
    }

</style>

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                📘 Homework Dashboard
            </h2>

            <p class="text-muted mb-0">
                Manage homework assignments and student submissions
            </p>
        </div>

        <a href="/Homework/Create"
           class="btn btn-primary rounded-pill shadow-sm px-4">
            <i class="bi bi-plus-circle me-2"></i>
            Create Homework
        </a>

    </div>


    <!-- Summary Cards -->
    <div class="row g-4 mb-4">

        <!-- Total Active -->
        <div class="col-xl-3 col-md-6">
            <div class="stats-card primary-card">
                <div class="stats-card-body">
                    <div>
                        <p class="stats-title"> Total Active </p>
                        <h2 class="stats-value"> @Model.TotalActive </h2>
                        <span class="stats-subtitle">Active homework assignments</span>
                    </div>
                    <div class="stats-icon">
                        <i class="bi bi-journal-bookmark-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pending Review -->
        <div class="col-xl-3 col-md-6">
            <div class="stats-card warning-card">
                <div class="stats-card-body">
                    <div>
                        <p class="stats-title">Pending Review</p>
                        <h2 class="stats-value">@Model.PendingReview</h2>
                        <span class="stats-subtitle"> Awaiting teacher review</span>
                    </div>
                    <div class="stats-icon"><i class="bi bi-clock-history"></i></div>
                </div>
            </div>
        </div>

        <!-- Submitted Today -->
        <div class="col-xl-3 col-md-6">
            <div class="stats-card success-card">
                <div class="stats-card-body">
                    <div>
                        <p class="stats-title"> Submitted Today</p>
                        <h2 class="stats-value">@Model.SubmittedToday</h2>
                        <span class="stats-subtitle"> Student submissions today</span>
                    </div>
                    <div class="stats-icon"><i class="bi bi-check-circle-fill"></i></div>
                </div>
            </div>
        </div>


        <!-- Overdue -->
        <div class="col-xl-3 col-md-6">
            <div class="stats-card danger-card">
                <div class="stats-card-body">
                    <div>
                        <p class="stats-title">Overdue</p>
                        <h2 class="stats-value"> @Model.Overdue</h2>
                        <span class="stats-subtitle">Homework past due date</span>
                    </div>
                    <div class="stats-icon">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>



    @* <!-- Summary Cards -->
