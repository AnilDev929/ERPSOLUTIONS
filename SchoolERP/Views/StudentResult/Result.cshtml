@using SchoolERP.Models.DTOS
@model List<ResultDTO>
@{
    ViewData["Title"] = "Exam Result";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var total = Model.Sum(x => x.Marks);
    var max = Model.Sum(x => x.MaxMarks);
    var percentage = (max > 0) ? (total * 100 / max) : 0;
  }

<div class="container mt-4">

    <!-- Header Card -->
    <div class="card shadow-sm border-0 mb-3 border-start border-4 border-primary">
        <div class="card-body py-3">
            <div class="d-flex align-items-center mb-1">
                <i class="bi bi-graph-up-arrow text-primary me-2 fs-5"></i>
                <h5 class="mb-0">Exam Result</h5>
            </div>

            <p class="mb-0 text-muted small">
                Check your marks, status, and overall percentage for this exam.
            </p>

        </div>
    </div>

    <!-- Filter Section -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <label class="form-label fw-semibold">
                <i class="bi bi-funnel me-1"></i> Select Exam
            </label>

            <select name="examId" class="form-select" onchange="this.form.submit()">
                <option value="">-- Select Exam --</option>
                @foreach (var exam in ViewBag.Exams)
                {
                    <option value="@exam.Value">@exam.Text</option>
                }
            </select>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted mt-5">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            <p>No result available</p>
        </div>
    }
    else
    {
        <div class="alert alert-primary d-flex justify-content-between">
            <span><i class="bi bi-calculator me-1"></i> Total Marks: @total</span>
            <span><i class="bi bi-percent me-1"></i> Percentage: @percentage %</span>
        </div>

        <!-- Table Card -->
        <div class="card shadow-sm border-0">

            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-semibold">
                    <i class="bi bi-table me-1"></i> Result Details
                </span>
            </div>

            <div class="card-body p-0">

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>
                                    <i class="bi bi-book me-1"></i> Subject
                                </th>
                                <th class="text-center">
                                    <i class="bi bi-pencil-square me-1"></i> Marks
                                </th>
                                <th class="text-center">
                                    <i class="bi bi-star me-1"></i> Max Marks
                                </th>
                                <th class="text-center">
                                    <i class="bi bi-check-circle me-1"></i> Status
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-medium">@item.SubjectName</td>

                                    <td class="text-center fw-bold text-primary">
                                        @item.Marks
                                    </td>

                                    <td class="text-center text-muted">
                                        @item.MaxMarks
                                    </td>

                                    <td class="text-center">
                                        <span class="badge rounded-pill px-3 py-2
                                                    @(item.Status == "Pass" ? "bg-success" : "bg-danger")">
                                            <i class="bi @(item.Status == "Pass" ? "bi-check-circle" : "bi-x-circle") me-1"></i>
                                            @item.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

            </div>
        </div>
    }

</div>