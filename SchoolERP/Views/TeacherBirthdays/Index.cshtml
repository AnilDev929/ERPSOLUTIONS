@using SchoolERP.Models.DTOS
@model List<TeacherBirthdayDTO>

@{
    ViewData["Title"] = "Teacher Birthdays";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>

    .birthday-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        flex-wrap: wrap;
        gap: 15px;
    }

    .header-stats {
        display: flex;
        gap: 15px;
    }

    .mini-stat {
        min-width: 140px;
        background: #fff;
        padding: 15px 20px;
        border-radius: 18px;
        display: flex;
        gap: 12px;
        align-items: center;
        box-shadow: 0 5px 15px rgba(0,0,0,.05);
    }

        .mini-stat i {
            font-size: 24px;
        }

        .mini-stat strong {
            display: block;
            font-size: 18px;
        }

        .mini-stat span {
            color: #6b7280;
            font-size: 13px;
        }

    .today i {
        color: #f59e0b;
    }

    .upcoming i {
        color: #4f46e5;
    }

    .filter-panel {
        background: #fff;
        border-radius: 18px;
        padding: 20px;
        margin-bottom: 25px;
        box-shadow: 0 5px 15px rgba(0,0,0,.05);
    }

    .section-title {
        margin-bottom: 15px;
    }

    .birthday-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .birthday-item {
        background: #fff;
        border-radius: 18px;
        padding: 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 5px 15px rgba(0,0,0,.05);
        transition: .25s;
    }

        .birthday-item:hover {
            transform: translateY(-2px);
        }

    .today-item {
        border-left: 5px solid #f59e0b;
    }

    .birthday-left {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .teacher-avatar {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        color: white;
        font-size: 22px;
        font-weight: 700;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .female-avatar {
        background: linear-gradient(135deg,#ec4899,#f43f5e);
    }

    .male-avatar {
        background: linear-gradient(135deg,#3b82f6,#2563eb);
    }

    .birthday-left h6 {
        margin-bottom: 4px;
        font-weight: 600;
    }

    .birthday-left small {
        color: #6b7280;
    }

    .birthday-right {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .birthday-date {
        font-weight: 600;
    }

    .days-tag {
        background: #eef2ff;
        color: #4f46e5;
        padding: 5px 12px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 600;
        margin-left: 10px;
    }

    .today-tag {
        background: #fff7ed;
        color: #ea580c;
        padding: 6px 12px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 700;
    }

    .empty-state {
        text-align: center;
        padding: 60px;
        background: #fff;
        border-radius: 20px;
    }

        .empty-state i {
            font-size: 55px;
            color: #d1d5db;
        }

    @@media (max-width:768px) {
        .birthday-item

    {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
    }

    .birthday-right {
        width: 100%;
        justify-content: space-between;
    }

    .header-stats {
        width: 100%;
    }

    .mini-stat {
        flex: 1;
    }

    }

</style>

<div class="container-fluid py-3">

    <!-- PAGE HEADER -->

    <div class="birthday-header">

        <div>

            <h3>
                <i class="bi bi-cake2-fill text-danger me-2"></i>
                Teacher Birthdays
            </h3>

            <p class="text-muted mb-0">
                Celebrate and appreciate our teachers
            </p>

        </div>

        <div class="header-stats">

            <div class="mini-stat today">

                <i class="bi bi-gift-fill"></i>

                <div>
                    <strong>
                        @Model.Count(x => x.DaysRemaining == 0)
                    </strong>
                    <span>Today</span>
                </div>

            </div>

            <div class="mini-stat upcoming">

                <i class="bi bi-calendar-heart-fill"></i>

                <div>
                    <strong>@Model.Count()</strong>
                    <span>Upcoming</span>
                </div>

            </div>

        </div>

    </div>

    <!-- FILTERS -->

    <form method="get" class="filter-panel">

        <div class="row g-3">

            <div class="col-lg-6">

                <div class="input-group">

                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Search Teacher..." />

                </div>

            </div>

            <div class="col-lg-3">

                <select name="month"
                        class="form-select"
                        onchange="this.form.submit()">

                    <option value="">
                        All Months
                    </option>

                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i"
                            selected="@(ViewBag.Month?.ToString() == i.ToString())">
                            @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)
                        </option>
                    }

                </select>

            </div>

            <div class="col-lg-3 d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary flex-fill">

                    <i class="bi bi-search me-1"></i>
                    Search

                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-clockwise"></i>

                </a>

            </div>

        </div>

    </form>

    <!-- TODAY BIRTHDAY -->

    @if (Model.Any(x => x.DaysRemaining == 0))
    {
        <div class="section-title">

            <h5>
                🎉 Today's Birthdays
            </h5>

        </div>

        <div class="birthday-list">

            @foreach (var item in Model.Where(x => x.DaysRemaining == 0))
            {
                var avatarClass = item.Gender?.ToLower() == "female"
                    ? "female-avatar"
                    : "male-avatar";

                <div class="birthday-item today-item">

                    <div class="birthday-left">

                        <div class="teacher-avatar @avatarClass">
                            @item.TeacherName.Substring(0,1)
                        </div>

                        <div>

                            <h6>
                                @item.TeacherName
                            </h6>

                            <small>
                                <i class="bi bi-person-workspace me-1"></i>
                                @item.Designation
                            </small>

                        </div>

                    </div>

                    <div class="birthday-right">

                        <span class="today-tag">
                            🎂 Birthday Today
                        </span>

                        <button class="btn btn-primary btn-sm">
                            <i class="bi bi-chat-heart-fill me-1"></i>
                            Wish
                        </button>

                    </div>

                </div>
            }

        </div>
    }

    <!-- UPCOMING -->

    <div class="section-title mt-4">

        <h5>
            <i class="bi bi-calendar-event me-2"></i>
            Upcoming Birthdays
        </h5>

    </div>

    @if (Model.Any())
    {
        <div class="birthday-list">

            @foreach (var item in Model.Where(x => x.DaysRemaining > 0))
            {
                var avatarClass = item.Gender?.ToLower() == "female"
                    ? "female-avatar"
                    : "male-avatar";

                <div class="birthday-item">

                    <div class="birthday-left">

                        <div class="teacher-avatar @avatarClass">
                            @item.TeacherName.Substring(0,1)
                        </div>

                        <div>

                            <h6>
                                @item.TeacherName
                            </h6>

                            <small>
                                <i class="bi bi-person-workspace me-1"></i>
                                @item.Designation
                            </small>

                        </div>

                    </div>

                    <div class="birthday-right">

                        <div class="date-section">

                            <span class="birthday-date">
                                @item.DOB.ToString("dd MMM")
                            </span>

                            <span class="days-tag">
                                @item.DaysRemaining Days
                            </span>

                        </div>

                        <button class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-chat-heart"></i>
                        </button>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="empty-state">

            <i class="bi bi-cake2"></i>

            <h5>
                No Birthdays Found
            </h5>

            <p>
                No teacher birthdays available.
            </p>

        </div>
    }

</div>