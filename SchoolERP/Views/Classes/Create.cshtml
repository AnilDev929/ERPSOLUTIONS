@using SchoolERP.Models.Entities
@model ClassModel

@{
    ViewBag.Title = ViewBag.Title ?? "Add/Edit Class";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow-sm rounded">
        <div class="card-header bg-primary text-white d-flex align-items-center py-3 px-4">
            <i class="fas fa-chalkboard fa-2x me-1"></i>
            <h3 class="mb-0 font-weight-bold">@ViewBag.Title</h3>
        </div>
        <div class="card-body p-4">
            <p class="text-muted mb-4">Fill in the details below to @ViewBag.Title.ToLower() a class.</p>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                <div class="row g-3">
                    <div class="col-md-4">
                        <label for="ClassName" class="font-weight-bold">
                            <i class="fas fa-pencil-alt me-1"></i> Class Name
                        </label>
                        @Html.TextBoxFor(m => m.ClassName, new { @class = "form-control", placeholder = "Enter class name" })
                        @Html.ValidationMessageFor(m => m.ClassName, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-4">
                        <label for="Description" class="font-weight-bold">
                            <i class="bi bi-card-text me-1"></i> Description
                        </label>

                        @Html.TextAreaFor(m => m.Description,
                            new {
                                @class = "form-control",
                                @rows = "4",
                                maxlength = "250",
                                placeholder = "Class Description"
                            })

                        <div class="d-flex justify-content-between mt-1">
                            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                            <small id="descCounter" class="text-muted">0 / 250</small>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-start gap-2 mt-4">
                    <button type="submit" class="btn btn-success d-flex align-items-center px-4">
                        <i class="fas fa-save me-1"></i> @ViewBag.Title
                    </button>
                    <a href="@Url.Action("Index","Classes")" class="btn btn-secondary d-flex align-items-center px-4">
                        <i class="fas fa-arrow-left me-1"></i> Back
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const textarea = document.querySelector("#Description");
            const counter = document.getElementById("descCounter");
            const max = 250;

            function updateCounter() {
                const len = textarea.value.length;
                counter.textContent = `${len} / ${max}`;

                // optional styling warning
                counter.classList.toggle("text-danger", len > max);
            }

            textarea.addEventListener("input", updateCounter);
            updateCounter();
        });
    </script>
}