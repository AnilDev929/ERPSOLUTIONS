@using SchoolERP.Models.Entities
@model Homework
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Homework Detail";

    var DaysLeft = (Model.DueDate.Date - DateTime.Now.Date).Days;
}


@{
    var statusClass = "bg-warning";

    if (Model.Status == SchoolERP.Enum.HomeworkStatus.Completed)
        statusClass = "bg-success";

    if (DaysLeft < 0)
        statusClass = "bg-danger";
}

<style>

    body {
        background: #f4f7fb;
    }

    .homework-wrapper {
        max-width: 950px;
        margin: auto;
    }

    .homework-card {
        border: none;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.06);
        background: white;
    }

    .homework-header {
        background: linear-gradient(135deg, #4f46e5, #6366f1);
        padding: 35px;
        color: white;
    }

    .homework-title {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .subject-badge {
        background: rgba(255,255,255,0.15);
        padding: 8px 16px;
        border-radius: 50px;
        display: inline-block;
        font-size: 14px;
        font-weight: 600;
    }

    .status-badge {
        font-size: 14px;
        padding: 10px 18px;
        border-radius: 50px;
        font-weight: 600;
    }

    .content-section {
        padding: 35px;
    }

    .section-title {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 14px;
        color: #111827;
    }

    .description-box {
        background: #f9fafb;
        border-radius: 16px;
        padding: 20px;
        color: #4b5563;
        line-height: 1.7;
        font-size: 15px;
    }

    .info-card {
        background: white;
        border-radius: 18px;
        padding: 22px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.04);
        border: 1px solid #eef2f7;
        transition: 0.3s;
        height: 100%;
    }

    .info-card:hover {
        transform: translateY(-3px);
    }

    .info-icon {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        margin-bottom: 15px;
    }

    .icon-blue {
        background: #eef2ff;
        color: #4f46e5;
    }

    .icon-red {
        background: #fef2f2;
        color: #dc2626;
    }

    .info-label {
        color: #6b7280;
        font-size: 14px;
    }

    .info-value {
        font-size: 22px;
        font-weight: 700;
        margin-top: 5px;
        color: #111827;
    }

    .days-danger {
        color: #dc2626;
    }

    .days-warning {
        color: #f59e0b;
    }

    .days-success {
        color: #16a34a;
    }

    .action-buttons {
        margin-top: 40px;
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
    }

    .btn-custom {
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .btn-custom:hover {
        transform: translateY(-2px);
    }

</style>

<div class="container py-5">

    <div class="homework-wrapper">

        <div class="homework-card">

            <!-- Header -->
            <div class="homework-header">

                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

                    <div>

                        <div class="homework-title">
                            @Model.Title
                        </div>

                        <div class="subject-badge">
                            📘 @Model.Subject.SubjectName
                        </div>

                    </div>

                    <div>

                        <span class="badge @statusClass status-badge">

                            @if (Model.Status == SchoolERP.Enum.HomeworkStatus.Completed)
                            {
                                <span>✅ Completed</span>
                            }
                            else if (DaysLeft < 0)
                            {
                                <span>❌ Overdue</span>
                            }
                            else
                            {
                                <span>⏳ Pending</span>
                            }

                        </span>

                    </div>

                </div>

            </div>

            <!-- Content -->
            <div class="content-section">

                <!-- Description -->
                <div>

                    <div class="section-title">
                        Homework Description
                    </div>

                    <div class="description-box">
                        @Model.Description
                    </div>

                </div>

                <!-- Info Cards -->
                <div class="row mt-4 g-4">

                    <!-- Due Date -->
                    <div class="col-md-6">

                        <div class="info-card">

                            <div class="info-icon icon-blue">
                                📅
                            </div>

                            <div class="info-label">
                                Due Date
                            </div>

                            <div class="info-value">
                                @Model.DueDate.ToString("dd MMM yyyy")
                            </div>

                        </div>

                    </div>

                    <!-- Days Left -->
                    <div class="col-md-6">

                        <div class="info-card">

                            <div class="info-icon icon-red">
                                ⏰
                            </div>

                            <div class="info-label">
                                Remaining Time
                            </div>

                            <div class="info-value">

                                @if (Model.Status == SchoolERP.Enum.HomeworkStatus.Completed)
                                {
                                    <span class="days-success">
                                        Completed
                                    </span>
                                }
                                else if (DaysLeft < 0)
                                {
                                    <span class="days-danger">
                                        Overdue
                                    </span>
                                }
                                else
                                {
                                    <span class="days-warning">
                                        @DaysLeft Days Left
                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Action Buttons -->
                <div class="action-buttons d-flex flex-wrap gap-3 mt-4">

                    <!-- Back Button -->
                    <a href="/StudentHomework/Index"
                       class="btn btn-light border btn-custom px-4 py-2"><i class="bi bi-arrow-left-circle me-2"></i>Back to Homework</a>

                    @if (Model.Status != SchoolERP.Enum.HomeworkStatus.Completed)
                    {
                        <!-- Submit Button -->
                        <a href="/StudentHomework/Submit/@Model.HomeworkId"
                           class="btn btn-primary btn-custom px-4 py-2 shadow-sm"><i class="bi bi-upload me-2"></i>Submit Homework
                        </a>
                    }
                    else
                    {
                        <!-- Submitted -->
                        <button class="btn btn-success btn-custom px-4 py-2 shadow-sm"
                                disabled><i class="bi bi-check-circle-fill me-2"></i>
                            Homework Submitted</button>
                    }

                </div>

            </div>

        </div>

    </div>

</div>