@using SchoolERP.Models.Entities
@using SchoolERP.Helpers
@model List<FeeConfiguration>
@{
    ViewBag.Title = "List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <div class="mb-4 p-3 bg-light rounded border">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h3 class="mb-1">
                    <i class="bi bi-sliders"></i> Fee Configurations
                </h3>
                <p class="text-muted mb-0">
                    Define how fees are structured and when payments are due each month.
                </p>
            </div>

            <a class="btn btn-primary" asp-action="Create">
                <i class="bi bi-plus"></i> Add Configuration
            </a>
        </div>
    </div>

    <div class="modal fade" id="commonModal" tabindex="-1">
        <div class="modal-dialog modal-md modal-dialog-centered">
            <div class="modal-content" id="modalContent">
            </div>
        </div>
    </div>

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Fee Type</th>
                <th>Due Day</th>
                <th>Grace Day</th>
                <th>Late Fine</th>
                <th>Status</th>
                <th width="160">Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FeeType</td>
                    @* <td>@item.DueDay</td> *@
                    <td>
                        @($"{item.DueDay}{DateHelper.GetDaySuffix(item.DueDay)} of Every Month")
                    </td>
                    <td>@item.GraceDays</td>
                    <td>@item.LateFineType - ₹@item.LateFineAmount</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </td>

                    <td>
                        <button class="btn btn-sm btn-warning"
                                onclick="openEditModal(@item.ConfigId)">
                            <i class="bi bi-pencil"></i>
                        </button>
                        @if (item.IsActive)
                        {
                            <button class="btn btn-sm btn-danger"
                                    onclick="openDeleteModal(@item.ConfigId)">
                                <i class="bi bi-trash"></i>
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>



@section Scripts {

    <script>

        function openEditModal(id) {
            $.get("/FeeConfiguration/Edit/" + id, function (data) {
                $("#modalContent").html(data);
                $("#commonModal").modal("show");
            });
        }

        function saveEdit() {
            $.ajax({
                url: "/FeeConfiguration/Edit",
                type: "POST",
                data: $("#editForm").serialize(),
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        $("#modalContent").html(res);
                    }
                }
            });
        }

        function openDeleteModal(id) {
            $.get("/FeeConfiguration/Delete/" + id, function (data) {
                $("#modalContent").html(data);
                $("#commonModal").modal("show");
            });
        }

        function confirmDelete(id) {
            $.post("/FeeConfiguration/DeleteConfirmed", { id: id }, function (res) {
                if (res.success) {
                    location.reload();
                }
            });
        }

    </script>

}