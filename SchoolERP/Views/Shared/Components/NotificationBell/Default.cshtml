@model SchoolERP.Models.ViewModels.NotificationBellVM

<div class="dropdown">
    <button class="btn position-relative" data-bs-toggle="dropdown">
        <i class="fas fa-bell fa-lg"></i>

        @if (Model.UnreadCount > 0)
        {
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                @Model.UnreadCount
            </span>
        }
    </button>

    <ul class="dropdown-menu dropdown-menu-end shadow">
        <li class="dropdown-header fw-bold">Notifications</li>

        @if (Model.TopNotifications.Any())
        {
            @foreach (var item in Model.TopNotifications)
            {
                <li>
                    <a class="dropdown-item" asp-controller="UserNotification" asp-action="Inbox">
                        @item.Title
                    </a>
                </li>
            }
        }
        else
        {
            <li>
                <span class="dropdown-item text-muted">No notifications</span>
            </li>
        }

        <li><hr class="dropdown-divider"></li>

        <li>
            <a class="dropdown-item text-center" asp-controller="UserNotification" asp-action="Inbox">
                View all
            </a>
        </li>
    </ul>
</div>