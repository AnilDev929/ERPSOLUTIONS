        // const toggleBtn = document.getElementById('toggleSidebar');
        // if (toggleBtn) {
        //     toggleBtn.addEventListener('click', () => {
        //         document.getElementById('sidebar').classList.toggle('collapsed');
        //     });
        // }
        // // restore state
        // if (localStorage.getItem("sidebar") === "collapsed") {
        //     sidebar.classList.add("collapsed");
        // }


        $(".collapse").on("show.bs.collapse", function () {
            $(this).prev().find(".toggleicon")
                .removeClass("bi-chevron-down")
                .addClass("bi-chevron-up");
        });

        $(".collapse").on("hide.bs.collapse", function () {
            $(this).prev().find(".toggleicon")
                .removeClass("bi-chevron-up")
                .addClass("bi-chevron-down");
        });

              

       
                /* Auto close on mobile menu click */
        $("#sidebar .nav-link").on("click", function () {

            if ($(window).width() <= 991) {
                $("body").removeClass("sidebar-open");
            }

        });

        /* Restore state */
        $(document).ready(function () {

            function adjustLayout() 
            {
                if ($(window).width() <= 991) {

                    // entering mobile
                    $("body")
                        .removeClass("sidebar-collapsed");

                } else {

                    // entering desktop
                    $("body")
                        .removeClass("sidebar-open");

                    if (localStorage.getItem("sidebar") === "collapsed") {
                        $("body").addClass("sidebar-collapsed");
                    }

                }
            }

            adjustLayout();

            $(window).on("resize", adjustLayout);

            if (localStorage.getItem("sidebar") === "collapsed"
                && $(window).width() > 991) 
            {
                $("body").addClass("sidebar-collapsed");
            }


            $("#toggleSidebar").on("click", function () {

                if ($(window).width() <= 991) {
                    $("body").toggleClass("sidebar-open");

                } else {

                    $("body").toggleClass("sidebar-collapsed");

                    localStorage.setItem(
                        "sidebar",
                        $("body").hasClass("sidebar-collapsed")
                            ? "collapsed"
                            : "expanded"
                    );
                }

            });
        });


        const toggle = document.getElementById("darkModeToggle");
        if (toggle) {
            toggle.addEventListener("click", () => {
                document.body.classList.toggle("dark-mode");

                if (document.body.classList.contains("dark-mode")) {
                    localStorage.setItem("theme", "dark");
                    toggle.innerHTML = '<i class="fas fa-sun me-2"></i> Light Mode';
                } else {
                    localStorage.setItem("theme", "light");
                    toggle.innerHTML = '<i class="fas fa-moon me-2"></i> Dark Mode';
                }
            });
        }

        if (localStorage.getItem("theme") === "dark") {
            document.body.classList.add("dark-mode");
            if (toggle) {
                toggle.innerHTML = '<i class="fas fa-sun me-2"></i> Light Mode';
            }
        }

        document.querySelectorAll('.dropdown-toggle').forEach(el => {
            el.addEventListener('click', function (e) {
                e.preventDefault();
            });
        });

        window.addEventListener("resize", () => {
            if (window.innerWidth > 992) {
                sidebar.classList.remove("collapsed");
                localStorage.setItem("sidebar", "expanded");
            }
        });
    </script>

    @if (!string.IsNullOrEmpty(msg))
    {
        <script>
            try {

                const swalMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(msg));
                const swalType = '@type';

                console.log("DEBUG:", swalMessage, swalType);

                if (typeof Swal !== "undefined") {

                    Swal.fire({
                        icon: swalType,
                        title: swalType.toUpperCase(),
                        text: swalMessage,

                        showConfirmButton: true,
                        confirmButtonText: 'OK',

                        timer: 5000,
                        timerProgressBar: true
                    });

                } else {
                    console.error("SweetAlert is NOT loaded");
                }

            } catch (e) {
                console.error("SweetAlert error:", e);
            }
        </script>
    }



 


