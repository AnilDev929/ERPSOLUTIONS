@using System.Security.Claims
@using SchoolERP.Data;
@inject AppDbContext _context
@{
    var msg = TempData["Success"] as string
           ?? TempData["Error"] as string
           ?? TempData["Warning"] as string
           ?? TempData["Info"] as string;

    var type =
        TempData["Success"] != null ? "success" :
        TempData["Error"] != null ? "error" :
        TempData["Warning"] != null ? "warning" :
        TempData["Info"] != null ? "info" : null;

    var roleName = User.FindFirst(ClaimTypes.Role)?.Value;

    var examMenu = _context.MenuSettings
        .FirstOrDefault(x => x.MenuKey == "ExamTimeTable");

    // var promotionMenu = _context.MenuSettings
    //     .FirstOrDefault(x => x.MenuKey == "StudentPromotion");

    bool showExamMenu = false;
    // bool showPromotionMenu = false;

    if (examMenu != null)
    {
        showExamMenu = 
            examMenu.IsActive && (!examMenu.StartDate.HasValue || examMenu.StartDate <= DateTime.Now) 
            && ( !examMenu.EndDate.HasValue || examMenu.EndDate >= DateTime.Now);
    }

    // if (promotionMenu != null)
    // {
    //     showPromotionMenu =
    //         promotionMenu.IsActive;
    // }
}

