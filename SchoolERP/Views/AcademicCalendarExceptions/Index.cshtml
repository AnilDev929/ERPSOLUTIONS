@using SchoolERP.Models.ViewModels
@model IEnumerable<AcademicCalendarExceptionListVM>

@{
    ViewBag.Title = "List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <!-- ✅ A. Page Header -->
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h3 class="mb-1">Academic Calendar Exceptions</h3>
            <p class="text-muted mb-0" style="font-size:14px;">
                Manage academic calendar exceptions such as summer vacations, exam breaks, and holidays.
                These periods are used to automatically block or adjust fee generation and billing.
            </p>
        </div>

        <div class="d-flex justify-content-end mb-3">
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Add Exception
            </a>
        </div>
    </div>

    <!-- ✅ B. Filter Section -->
    <form method="get" asp-action="Index" class="row mb-4">

        <div class="col-md-3">
            <label>Academic Year</label>
            <select name="academicYearId" class="form-control">
                <option value="">All</option>
                @foreach (var year in ViewBag.AcademicYears)
                {
                    <option value="@year.Value">@year.Text</option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label>Exception Type</label>
            <select name="exceptionType" class="form-control">
                <option value="">All</option>
                <option value="SUMMER_VACATION">Summer Vacation</option>
                <option value="EXAM_BREAK">Exam Break</option>
                <option value="HOLIDAY">Holiday</option>
            </select>
        </div>

        <div class="col-md-2">
            <label>Start Date</label>
            <input type="date" name="startDate" 
                min="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
        </div>

        <div class="col-md-2">
            <label>End Date</label>
            <input type="date" name="endDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-success w-100">Filter</button>
        </div>

    </form>

    <!-- ✅ C. Table Design -->
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Academic Year</th>
                <th>Type</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Billing Blocked</th>
               @*  <th>Description</th> *@
                <th style="width:150px;">Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">
                        No records found
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr class="@GetRowClass(item.ExceptionType)">
                        <td>@item.AcademicYearName</td>
                        <td>@item.ExceptionType</td>
                        <td>@item.StartDate.ToString("dd-MMM-yyyy")</td>
                        <td>@item.EndDate.ToString("dd-MMM-yyyy")</td>
                        <td>
                            @(item.IsBillingBlocked ? "Yes" : "No")
                        </td>
                        @* <td>@item.Description</td> *@
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.ExceptionId" class="btn btn-sm btn-warning">Edit</a>
                            <form asp-action="Delete" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@item.ExceptionId" />

                                <button type="submit"
                                        class="btn btn-sm btn-danger"
                                        onclick="return confirm('Are you sure you want to delete this record?');">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

</div>

@functions {
    public string GetRowClass(string type)
    {
        return type switch
        {
            "SUMMER_VACATION" => "table-warning",
            "EXAM_BREAK" => "table-danger",
            "HOLIDAY" => "table-info",
            _ => ""
        };
    }
}