@using SchoolERP.Models.Entities
@model IEnumerable<ExamSchedule>

@{
    ViewBag.Title = "Exam Schedule";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <!-- PAGE HEADER -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body bg-light">

            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="fw-bold text-primary mb-1">
                        <i class="bi bi-calendar-week"></i> Exam Schedule Management
                    </h3>
                    <p class="text-muted mb-0">
                        View, filter, and manage exam schedules by class and exam.
                        Use filters below to quickly find relevant records and update them if needed.
                    </p>
                </div>

                <a href="@Url.Action("Create")" class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> Add Schedule
                </a>
            </div>

        </div>
    </div>

    <!-- FILTER CARD -->
    <div class="card shadow-sm mb-3">
        <div class="card-body">

            @using (Html.BeginForm("Index", "ExamSchedule", FormMethod.Get))
            {
                <div class="row g-3 align-items-end">

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-mortarboard"></i> Class
                        </label>
                        @Html.DropDownList("classId", (SelectList)ViewBag.Classes,
                        "All Classes", new { @class = "form-select" })
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-file-earmark-text"></i> Exam
                        </label>
                        @Html.DropDownList("examId", (SelectList)ViewBag.Exams,
                                            "All Exams", new { @class = "form-select" })
                    </div>

                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-funnel"></i> Apply Filters
                        </button>
                    </div>

                </div>
            }

        </div>
    </div>

    <!-- TABLE -->
    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle text-center">

                    <thead class="table-dark">
                        <tr>
                            <th>Subject</th>
                            <th>Class</th>
                            <th>Exam</th>
                            <th>Date</th>
                            <th>Time Slot</th>
                            <th>Max Marks</th>
                            <th>Passing Marks</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-muted">
                                    <i class="bi bi-inbox"></i> No schedules found
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.Subject?.SubjectName</td>
                                    <td>@item.Class?.ClassName</td>
                                    <td>@item.Exam?.ExamName</td>
                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @item.ExamDate.ToString("dd MMM yyyy")
                                        </span>
                                    </td>
                                    <td>@item.TimeSlot?.SlotName</td>
                                    <td>@item.MaxMarks</td>
                                    <td>@item.PassingMarks</td>

                                    <td>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a href="@Url.Action("Edit", new { id = item.ScheduleId })"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <a href="@Url.Action("Delete", new { id = item.ScheduleId })"
                                               class="btn btn-sm btn-outline-danger"
                                               onclick="return confirm('Delete this record?');">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>
</div>