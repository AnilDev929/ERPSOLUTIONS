@using SchoolERP.Models.Entities
@model List<ExamTimeSlot>
@{
    ViewBag.Title = "Time Slots";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-0">
                <i class="bi bi-clock-history text-primary"></i> Exam Time Slot Management</h3>
            <small class="text-muted">Manage examination session timings</small>
        </div>

        <a asp-action="CreateTimeSlot" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Time Slot</a>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body table-responsive">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Exam Time Slots</h5>
                <form method="get" asp-action="TimeSlots">
                    <select name="examTypeId" class="form-select w-auto" onchange="this.form.submit()">
                        <option value="">All Exam Types</option>

                        @foreach (var type in ViewBag.ExamTypes)
                        {
                            <option value="@type.ExamId"
                                    selected="@(ViewBag.ExamType == type.ExamId ? "selected" : null)">@type.ExamName</option>
                        }
                    </select>
                </form>
            </div>

            <table class="table table-hover table-striped table-bordered align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Exam Date</th>
                        <th>Slot Name</th>
                        <th>Start Time</th>
                        <th>End Time</th>
                        <th>Duration</th>
                        <th>Floor No</th>
                        <th>Room No</th>
                        <th>Status</th>
                        <th width="120">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if(Model.Any())
                    {
                        foreach(var item in Model)
                        {
                            var duration = item.EndTime - item.StartTime;
                            <tr>
                                <td>@item.ExamDate.ToString("dd MMM yyyy")</td>
                                <td> <strong> @item.SlotName </strong></td>
                                <td> @item.StartTime.ToString(@"hh\:mm")</td>
                                <td> @item.EndTime.ToString(@"hh\:mm")</td>
                                <td> @duration.TotalHours Hr </td>
                                <td>@(string.IsNullOrEmpty(item.FloorNo) ? "N/A" : item.FloorNo)</td>
                                <td>@(string.IsNullOrEmpty(item.RoomNo) ? "N/A" : item.RoomNo)</td>
                                <td>
                                    @if(item.IsActive)
                                    {<span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"> Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group gap-2">
                                        <a asp-action="CreateTimeSlot"
                                           asp-route-id="@item.ExamTimeSlotId"
                                           class="btn btn-sm btn-warning ">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        @* <a asp-action="Delete"
                                           asp-route-id="@item.ExamTimeSlotId"
                                           class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i>
                                        </a> *@
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="9" class="text-center text-muted py-4">
                                <i class="bi bi-clock-history text-secondary"
                                   style="font-size:60px;"></i>
                                <div>
                                    No Exam Time Slots Found
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>