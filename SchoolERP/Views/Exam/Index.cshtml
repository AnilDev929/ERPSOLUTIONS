@using SchoolERP.Models.ViewModels
@model List<ExamVM>
@{
    ViewData["Title"] = "Exam";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container mt-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h3 class="mb-0">
                <i class="bi bi-journal-text text-primary"></i>
                Exam Management
            </h3>
            <small class="text-muted">Create and manage academic exams</small>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus me-1"></i> Create Exam
        </a>
    </div>

    @* <!-- SEARCH BAR (UI ONLY - optional JS later) -->
    <div class="card border-4 shadow-sm mb-3">
        <div class="card-body">

            <div class="row">

                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="searchBox"
                               class="form-control"
                               placeholder="Search exam name..." />
                    </div>
                </div>

            </div>

        </div>
    </div> *@

    <!-- TABLE -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-light">
            <i class="bi bi-table me-1 text-primary"></i>
            Exam List
        </div>

        <div class="card-body p-0">

            @if (Model == null || !Model.Any())
            {
                <div class="text-center p-5">
                    <i class="bi bi-inbox display-4 text-muted"></i>
                    <h5 class="mt-2">No Exams Found</h5>
                    <p class="text-muted">Click "Create Exam" to add new records.</p>
                </div>
            }
            else
            {
                <table class="table table-hover mb-0 align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Exam Name</th>
                            <th>Description</th>
                            <th>Academic Year</th>
                            <th width="160">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <i class="bi bi-journal-check text-success me-1"></i>
                                    @item.ExamName
                                </td>

                                <td>
                                    @item.Description
                                </td>

                                <td>
                                    <span class="badge bg-success-subtle text-success border">
                                        <i class="bi bi-mortarboard me-1"></i>
                                        AY @item.AcademicYearName
                                    </span>
                                </td>
                                <td>

                                    <a asp-action="Create" asp-route-id="@item.ExamId"
                                       class="btn btn-sm">

                                        <i class="bi bi-pencil me-1"></i> Edit
                                    </a>

                                   @*  <button class="btn btn-sm btn-danger"
                                            onclick="deleteExam(@item.ExamId)">
                                        <i class="bi bi-trash"></i>
                                    </button> *@

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }

        </div>
    </div>

</div>


@section Scripts {
    <script>

        function deleteExam(id) {

            if (!confirm("Are you sure you want to delete this exam?"))
                return;

            $.ajax({
                url: '/Exam/Delete/' + id,
                type: 'POST',
                success: function () {
                    location.reload();
                },
                error: function () {
                    alert("Delete failed");
                }
            });
        }

    </script>
}


                                    