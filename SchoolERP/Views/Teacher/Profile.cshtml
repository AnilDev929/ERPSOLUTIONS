@using SchoolERP.Enum
@using SchoolERP.Models.DTOS
@model TeacherProfileDTO
@{
    ViewData["Title"] = "Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var statusClass = "";
    var statusIcon = "";

    switch (Model.Status)
    {
        case TeacherStatus.Active:
            statusClass = "bg-success";
            statusIcon = "bi-check-circle";
            break;

        case TeacherStatus.Resigned:
            statusClass = "bg-warning text-dark";
            statusIcon = "bi-box-arrow-right";
            break;

        case TeacherStatus.Left:
            statusClass = "bg-info text-dark";
            statusIcon = "bi-person-x";
            break;

        case TeacherStatus.Blocked:
            statusClass = "bg-danger";
            statusIcon = "bi-slash-circle";
            break;

        default:
            statusClass = "bg-secondary";
            statusIcon = "bi-question-circle";
            break;
    }

}

<div class="container my-4">

    <!-- 🔷 PROFILE HEADER -->
    <div class="card shadow-sm border-0 mb-2">
        <div class="card-body d-flex align-items-center justify-content-between">

            <!-- Left Section -->
            <div class="d-flex align-items-center">
                <div class="me-3">
                    @* <i class="bi bi-person-circle text-primary" style="font-size: 70px;"></i> *@
                    <img src="@(string.IsNullOrEmpty(Model.ProfileImageUrl)
                                     ? "/images/default-user.png"
                                     : Model.ProfileImageUrl)"
                         class="rounded-circle border shadow"
                         width="130"
                         height="130" />
                    
                </div>
                <div>
                    <!-- Name + Status -->
                    <div class="d-flex align-items-center gap-2">
                        <h3 class="mb-0">@Model.FullName</h3>
                        <span class="badge rounded-pill @statusClass px-3 py-2">
                            <i class="bi @statusIcon me-1"></i> @Model.Status
                        </span>
                    </div>
                    <!-- Designation -->
                    <span class="text-muted">@Model.Designation</span><br />
                    <!-- Employment Type (NEW - Integrated Cleanly) -->
                    <div class="mt-1">
                        <small class="text-muted me-1">
                            <i class="bi bi-person-workspace"></i> Employment:
                        </small>

                        @if (Model.EmploymentType == "Permanent")
                        {
                            <span class="badge bg-success">
                                <i class="bi bi-check-circle"></i> Permanent
                            </span>
                        }
                        else if (Model.EmploymentType == "Contract")
                        {
                            <span class="badge bg-warning text-dark">
                                <i class="bi bi-clock-history"></i> Contract
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Not Defined
                            </span>
                        }
                    </div>

                    <!-- Last Login -->
                    <small class="text-muted mt-1 d-block">
                        <i class="bi bi-clock me-1"></i>
                        Last Login: @User.FindFirst("LastLogin")?.Value
                    </small>
                </div>
            </div>

            <!-- Right Section (Edit Button) -->
            <div>
                <a href="@Url.Action("UpdateProfile", "Teacher", new { id = Model.TeacherID })"
                   class="btn btn-sm btn-info me-1">
                    <i class="bi bi-pencil-square me-1"></i> Edit Profile
                </a>
            </div>

        </div>
    </div>

    <div class="row">

        <!-- 👤 PERSONAL INFO -->
        <div class="col-md-6">
            <div class="card shadow-sm mb-2">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-person-lines-fill me-2"></i> Personal Information
                </div>
                <div class="card-body">
                    <p><i class="bi bi-calendar-date me-2"></i> DOB: @Model.DateOfBirth?.ToString("dd MMM yyyy")</p>
                    <p><i class="bi bi-gender-ambiguous me-2"></i> Gender: @Model.GenderName</p>
                    <p><i class="bi bi-droplet me-2"></i> Blood Group: @Model.BloodGroup</p>
                    <p><i class="bi bi-heart me-2"></i> Married: @(Model.IsMarried ? "Yes" : "No")</p>
                </div>
            </div>
        </div>

        <!-- 👨‍👩‍👧 FAMILY -->
        <div class="col-md-6">
            <div class="card shadow-sm mb-2">
                <div class="card-header bg-info text-white">
                    <i class="bi bi-people-fill me-2"></i> Family Details
                </div>
                <div class="card-body">
                    <p><i class="bi bi-person me-2"></i> Father: @Model.FatherName</p>
                    <p><i class="bi bi-person me-2"></i> Mother: @Model.MotherName</p>

                    @if (Model.IsMarried)
                    {
                        <p><i class="bi bi-person-heart me-2"></i> Spouse: @Model.SpouseName</p>
                        <p><i class="bi bi-telephone me-2"></i> Spouse Contact: @Model.SpouseContact</p>
                    }
                </div>
            </div>
        </div>

        <!-- 📞 CONTACT -->
        <div class="col-md-6">
            <div class="card shadow-sm mb-2">
                <div class="card-header bg-warning text-dark">
                    <i class="bi bi-telephone-fill me-2"></i> Contact Details
                </div>
                <div class="card-body">
                    <p><i class="bi bi-phone me-2"></i> @Model.Phone</p>
                    <p><i class="bi bi-envelope me-2"></i> @Model.EmailID</p>
                    <p><i class="bi bi-exclamation-circle me-2"></i> Emergency: @Model.EmergencyContact</p>
                    <p><i class="bi bi-credit-card me-2"></i> Aadhaar: @Model.Aadhaar</p>
                </div>
            </div>
        </div>

        <!-- 📍 ADDRESS -->
        <div class="col-md-6">
            <div class="card shadow-sm mb-2">
                <div class="card-header bg-secondary text-white">
                    <i class="bi bi-geo-alt-fill me-2"></i> Address
                </div>
                <div class="card-body">
                    <p><i class="bi bi-house me-2"></i> Permanent: @Model.PermanentAddress</p>
                    <p><i class="bi bi-geo-alt me-2"> City : @Model.City</i></p>
                    <p><i class="bi bi-globe me-2"> State : @Model.State</i></p>
                    <p><i class="bi bi-hash me-2"> Pin Code : @Model.PostalCode</i></p>
                </div>
            </div>
        </div>

        <!-- 🎓 PROFESSIONAL -->
        <div class="col-md-6">
            <div class="card shadow-sm mb-2">
                <div class="card-header bg-success text-white">
                    <i class="bi bi-mortarboard-fill me-2"></i> Professional Info
                </div>
                <div class="card-body">
                    <p><i class="bi bi-book me-2"></i> Qualification: @Model.Qualification</p>
                    <p><i class="bi bi-lightbulb me-2"></i> Specialization: @Model.Specialization</p>
                    <p><i class="bi bi-briefcase me-2"></i> Experience: @Model.Experience Years</p>
                    <p><i class="bi bi-calendar-check me-2"></i> Joining: @Model.JoiningDate</p>
                </div>
            </div>
        </div>

        <!-- 🛡️ STATUS -->
        <div class="col-md-6">
            <div class="card shadow-sm mb-2">
                <div class="card-header bg-dark text-white">
                    <i class="bi bi-shield-lock me-2"></i> Account Status
                </div>
                <div class="card-body">
                    <p><strong>Status:</strong> @Model.Status</p>
                    <p><strong>Remark:</strong> @Model.StatusRemark</p>
                    <p><strong>Updated:</strong> @Model.StatusUpdatedOn</p>
                </div>
            </div>
        </div>

    </div>
</div>