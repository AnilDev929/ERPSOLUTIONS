@using SchoolERP.Enum
@using SchoolERP.Models.DTOS
@model IEnumerable<TeacherDto>

@{
    ViewData["Title"] = "Teachers";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var totalTeachers = Model?.Count() ?? 0;
    // Change property according to your DTO
    var activeTeachers = Model?.Count(x => x.Status == TeacherStatus.Active) ?? 0;
    var inactiveTeachers = totalTeachers - activeTeachers;
}
<style>

    .stats-card {
        border: none;
        border-radius: 18px;
        transition: .25s ease;
        overflow: hidden;
        background: #fff;
        min-height: 120px;
    }

    .stats-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 30px rgba(0,0,0,.08);
    }

    .stats-icon {
        width: 65px;
        height: 65px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        flex-shrink: 0;
    }

    .stats-title {
        font-size: 14px;
        color: #6c757d;
        margin-bottom: 6px;
        font-weight: 500;
    }

    .stats-value {
        font-size: 34px;
        font-weight: 700;
        line-height: 1;
        color: #212529;
    }

    .bg-soft-primary {
        background: rgba(13,110,253,.12);
    }

    .bg-soft-success {
        background: rgba(25,135,84,.12);
    }

    .bg-soft-warning {
        background: rgba(255,193,7,.18);
    }

    th {
        text-align: left !important;
    }
</style>


<div class="container-fluid mt-2">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-people-fill text-primary"></i>
                Teacher Management
            </h2>

            <!-- Breadcrumb -->
            <nav>
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href ="@Url.Action("Index", "Dashboard")">Dashboard</a>
                    </li>
                    <li class="breadcrumb-item active">
                        Teacher Management
                    </li>
                </ol>
            </nav>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Teacher
        </a>
    </div>

    <!-- Statistics -->
    <div class="row g-4 mb-2">

        <!-- Total -->
        <div class="col-lg-4 col-md-6">
            <div class="card stats-card shadow-sm">
                <div class="card-body d-flex align-items-center">

                    <div class="stats-icon bg-soft-primary">
                        <i class="bi bi-people-fill text-primary"></i>
                    </div>
                    <div class="ms-4">
                        <div class="stats-title">
                            Total Teachers
                        </div>
                        <div class="stats-value"> @totalTeachers </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Active -->
        <div class="col-lg-4 col-md-6">
            <div class="card stats-card shadow-sm">
                <div class="card-body d-flex align-items-center">

                    <div class="stats-icon bg-soft-success">
                        <i class="bi bi-person-check-fill text-success"></i>
                    </div>

                    <div class="ms-4">
                        <div class="stats-title">
                            Active Teachers
                        </div>

                        <div class="stats-value">
                            @activeTeachers
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Inactive -->
        <div class="col-lg-4 col-md-6">
            <div class="card stats-card shadow-sm">
                <div class="card-body d-flex align-items-center">

                    <div class="stats-icon bg-soft-warning">
                        <i class="bi bi-person-dash-fill text-warning"></i>
                    </div>

                    <div class="ms-4">
                        <div class="stats-title">
                            Inactive Teachers
                        </div>

                        <div class="stats-value">
                            @inactiveTeachers
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- TempData Messages -->
    @* @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" id="successMessage">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorMessage">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    } *@

    <div class="modal fade" id="statusModal" tabindex="-1" data-bs-backdrop="static"
         data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">


                <!-- Header -->
                <div class="modal-header bg-light border-0">
                    <h5 class="modal-title d-flex align-items-center gap-2">
                        <i class="bi bi-person-check-fill text-success fs-4"></i>
                        Update Teacher Status
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <!-- Body -->
                <div class="modal-body px-4 py-3">
                    <input type="hidden" id="teacherId" name="Id" />

                    <!-- Status -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-flag me-1 text-primary"></i> Status
                        </label>
                        <select class="form-select" name="Status" id="status">
                            <option value="0">🟢 Active</option>
                            <option value="1">🟡 Resigned</option>
                            <option value="2">🔵 Left</option>
                            <option value="3">🔴 Blocked</option>
                        </select>
                    </div>

                    <!-- Remark -->
                    <div class="mb-2">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-chat-left-text me-1 text-secondary"></i> Remark
                        </label>
                        <textarea class="form-control" name="StatusRemark" rows="3"
                                  placeholder="Add a note (optional)..."></textarea>
                    </div>
                </div>

                <!-- Footer -->
                <div class="modal-footer border-0 px-4 pb-4">
                    <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i> Cancel
                    </button>

                    <button type="button" class="btn btn-success px-4" id="saveBtn" onclick="saveStatus()">
                        <span id="saveBtnText"> <i class="bi bi-check-circle-fill me-1"></i> Save Changes </span>
                        <span id="saveLoader" class="d-none">
                            <span class="spinner-border spinner-border-sm me-1"></span>Saving...
                        </span>
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- Search Form -->
    <form method="get" class="mb-3">
        <div class="input-group">
            <span class="input-group-text bg-primary text-white">
                <i class="bi bi-search"></i>
            </span>
            <input type="text" name="search" class="form-control" placeholder="Search by Name, Phone, Email, or Qualification" value="@ViewBag.Search" />
            <button class="btn btn-primary" type="submit">Search</button>
        </div>
    </form>

    <!-- Teachers Table -->
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark text-center">
                <tr>
                    <th>#</th>
                    <th align="left">Teacher Name</th>
                    <th align="left">Gender</th>
                    <th align="right">Phone</th>
                    <th align="left">Email ID</th>
                    <th align="left">Qualification</th>
                    <th align="left">Designation</th>
                    <th align ="left">Specialization</th>
                    <th align="center">Status</th>
                    <th align="left">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    int serial = ((ViewBag.CurrentPage - 1) * 10) + 1;
                    <!-- for server-side paging -->
                    foreach (var teacher in Model)
                    {
                        <tr class="text-center">
                            <td><b>@serial</b></td>

                            <td class="text-start" align="left">
                                @teacher.TeacherName
                            </td>
                            <td align="left">
                                @if (teacher.Gender == "Male")
                                {
                                    <span class="d-inline-flex align-items-center">
                                        <i class="bi bi-gender-male me-2"
                                           style="color:#2563EB;"></i>
                                        <span>Male</span>
                                    </span>
                                }
                                else if (teacher.Gender == "Female")
                                {
                                    <span class="d-inline-flex align-items-center">
                                        <i class="bi bi-gender-female me-2"
                                           style="color:#EC4899;"></i>
                                        <span>Female</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="d-inline-flex align-items-center">
                                        <i class="bi bi-person me-2 text-secondary"></i>
                                        <span>@teacher.Gender</span>
                                    </span>
                                }
                            </td>
                            <td align="left">
                                <a href="tel:@teacher.Phone">@teacher.Phone</a>
                            </td>
                            <td align="left">
                                <i class="bi bi-envelope-fill text-danger me-1"></i>
                                <a href="mailto:@teacher.EmailID">@teacher.EmailID</a>
                            </td>
                            <td align="left">
                                <i class="bi bi-mortarboard-fill text-success me-1"></i>
                                @teacher.Qualification
                            </td>
                            <td align="left">@teacher.Designation</td>
                            <td align="left">@teacher.Specialization</td>
                            <td>
                                @if (teacher.Status == TeacherStatus.Active)
                                {
                                    <span class="text-success">
                                        <i class="bi bi-check-circle-fill fs-5"></i> Active
                                    </span>
                                }
                                else if (teacher.Status == TeacherStatus.Blocked)
                                {
                                    <span class="text-danger">
                                        <i class="bi bi-slash-circle-fill fs-5"></i> Blocked
                                    </span>
                                }
                                else if (teacher.Status == TeacherStatus.Resigned)
                                {
                                    <span class="text-warning">
                                        <i class="bi bi-door-closed fs-5"></i> Resigned
                                    </span>
                                }
                                else if (teacher.Status == TeacherStatus.Left)
                                {
                                    <span class="text-secondary">
                                        <i class="bi bi-person-dash fs-5"></i> Left
                                    </span>
                                }
                            </td>
                            <td>
                                <a href="@Url.Action("Edit", new { teacherID = teacher.TeacherID })"
                                    class="btn btn-sm btn-primary me-1">
                                    <i class="bi bi-pencil"></i></a>
                                <a class="btn btn-sm btn-danger" href="@Url.Action("Delete", new { id = teacher.TeacherID })">
                                    <i class="bi bi-trash"></i></a>
                                <button class="btn btn-sm btn-outline-primary"
                                        onclick="openStatusModal(@teacher.TeacherID, '@teacher.Status')">
                                    <i class="bi bi-person-gear me-1"></i>
                                </button>
                            </td>
                        </tr>
                        serial++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center fw-bold">No teachers found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="?search=@ViewBag.Search&page=@(ViewBag.CurrentPage - 1)">Previous</a>
                </li>

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="?search=@ViewBag.Search&page=@i">@i</a>
                    </li>
                }

                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="?search=@ViewBag.Search&page=@(ViewBag.CurrentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts {

    <script>

        // // Auto-hide TempData messages
        // setTimeout(function () {
        //     const success = document.getElementById('successMessage');
        //     const error = document.getElementById('errorMessage');
        //     if (success) { success.classList.remove('show'); success.classList.add('fade'); }
        //     if (error) { error.classList.remove('show'); error.classList.add('fade'); }
        // }, 5000);

        function openStatusModal(id, status) {
            document.getElementById("teacherId").value = id;
            document.getElementById("status").value = status;

            var modal = new bootstrap.Modal(document.getElementById('statusModal'));
            modal.show();
        }

        // function saveStatus() {
        //     var formData = {
        //         Id: document.getElementById("teacherId").value,
        //         Status: document.getElementById("status").value,
        //         StatusRemark: document.querySelector("textarea[name='StatusRemark']").value
        //     };

        //     fetch('/Teacher/UpdateStatus', {
        //         method: 'POST',
        //         headers: {
        //             'Content-Type': 'application/json'
        //         },
        //         body: JSON.stringify(formData)
        //     })
        //     .then(res => res.json())
        //     .then(data => {
        //         if (data.success) {
        //             location.reload(); // refresh table
        //         }
        //     });
        // }

        function validateForm() {

            const teacherId = document.getElementById("teacherId").value;
            const status = document.getElementById("status").value;
            const remark = document.querySelector("[name='StatusRemark']").value;

            if (!teacherId || teacherId === "0") {
                Swal.fire({
                    icon: "warning",
                    title: "Validation Error",
                    text: "No Teacher is selected to update."
                });
                return false;
            }

            if (!status || status.trim() === "") {
                Swal.fire({
                    icon: "warning",
                    title: "Validation Error",
                    text: "Please select a status"
                });
                return false;
            }

            if (!remark || remark.trim().length < 3) {
                Swal.fire({
                    icon: "warning",
                    title: "Validation Error",
                    text: "Status remark must be at least 3 characters"
                });
                return false;
            }

            return true;
        }

        async function saveStatus() {

            if (!validateForm()) return;

            const saveBtn = document.getElementById("saveBtn");
            const saveBtnText = document.getElementById("saveBtnText");
            const saveLoader = document.getElementById("saveLoader");

            // SHOW LOADER
            saveBtn.disabled = true;
            saveBtnText.classList.add("d-none");
            saveLoader.classList.remove("d-none");

            // FORM DATA
            const data = {
                TeacherID: parseInt(document.getElementById("teacherId").value),
                Status: document.getElementById("status").value,
                StatusRemark: document.querySelector("[name='StatusRemark']").value
            };
            // console.log(data);

            try {

                const response = await fetch('/Teacher/UpdateStatus', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (result.success) {

                    // SUCCESS ALERT
                    await Swal.fire({
                        icon: 'success',
                        title: 'Updated Successfully',
                        text: 'Teacher status updated successfully.',
                        confirmButtonColor: '#198754',
                        timer: 1800,
                        showConfirmButton: false
                    });

                    // REDIRECT
                    // window.location.href = '/Teacher/Index';
                    window.location.replace('/Teacher/Index');
                }
                else {

                    Swal.fire({
                        icon: 'error',
                        title: 'Update Failed',
                        text: 'Unable to update teacher status.'
                    });
                }
            }
            catch (error) {
                console.error(error);
                Swal.fire({
                    icon: 'error',
                    title: 'Something went wrong',
                    text: 'Please try again later.'
                });
            }
            finally {

                // RESET BUTTON
                saveBtn.disabled = false;
                saveBtnText.classList.remove("d-none");
                saveLoader.classList.add("d-none");
            }
        
        
        
        }




    </script>
}