@using SchoolERP.Models.ViewModels
@model ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header text-center bg-primary text-white">
                    <h3><i class="bi bi-key-fill"></i> Change Password</h3>
                </div>
                <div class="card-body">
                    @* @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    } *@

                    <form asp-action="ChangePassword" method="post">
                        <!-- Current Password -->
                        <div class="mb-3 position-relative">
                            <label asp-for="CurrentPassword" class="form-label"></label>
                            <input asp-for="CurrentPassword" class="form-control" id="CurrentPassword" />
                            <i class="bi bi-eye-slash toggle-password" style="position:absolute; right:10px; top:38px; cursor:pointer;"></i>
                            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                        </div>

                        <!-- New Password -->
                        <div class="mb-3 position-relative">
                            <label asp-for="NewPassword" class="form-label"></label>
                            <input asp-for="NewPassword" class="form-control" id="NewPassword" />
                            <i class="bi bi-eye-slash toggle-password" style="position:absolute; right:10px; top:38px; cursor:pointer;"></i>
                            <span asp-validation-for="NewPassword" class="text-danger"></span>

                            <!-- Password Rules -->
                            <ul class="mt-2 list-unstyled" id="passwordRules">
                                <li id="ruleLength" class="text-danger"><i class="bi bi-x-circle"></i> At least 6 characters</li>
                                <li id="ruleUpper" class="text-danger"><i class="bi bi-x-circle"></i> At least 1 uppercase letter</li>
                                <li id="ruleNumber" class="text-danger"><i class="bi bi-x-circle"></i> At least 1 number</li>
                                <li id="ruleSpecial" class="text-danger"><i class="bi bi-x-circle"></i> At least 1 special character</li>
                            </ul>

                            <!-- Strength Bar -->
                            <div id="passwordStrength" class="mt-2"></div>
                        </div>

                        <!-- Confirm Password -->
                        <div class="mb-3 position-relative">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" id="ConfirmPassword" />
                            <i class="bi bi-eye-slash toggle-password" style="position:absolute; right:10px; top:38px; cursor:pointer;"></i>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Change Password</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Toggle password visibility
        document.querySelectorAll('.toggle-password').forEach(icon => {
            icon.addEventListener('click', () => {
                const input = icon.previousElementSibling;
                if (input.type === "password") {
                    input.type = "text";
                    icon.classList.replace('bi-eye-slash', 'bi-eye');
                } else {
                    input.type = "password";
                    icon.classList.replace('bi-eye', 'bi-eye-slash');
                }
            });
        });

        // Password strength and rules check
        const passwordInput = document.getElementById('NewPassword');
        const strengthDiv = document.getElementById('passwordStrength');

        const rules = {
            length: document.getElementById('ruleLength'),
            upper: document.getElementById('ruleUpper'),
            number: document.getElementById('ruleNumber'),
            special: document.getElementById('ruleSpecial')
        };

        passwordInput.addEventListener('input', () => {
            const val = passwordInput.value;
            let strength = 0;

            // Check rules
            if (val.length >= 6) {
                rules.length.classList.replace('text-danger', 'text-success');
                rules.length.innerHTML = '<i class="bi bi-check-circle"></i> At least 6 characters';
                strength++;
            } else {
                rules.length.classList.replace('text-success', 'text-danger');
                rules.length.innerHTML = '<i class="bi bi-x-circle"></i> At least 6 characters';
            }

            if (/[A-Z]/.test(val)) {
                rules.upper.classList.replace('text-danger', 'text-success');
                rules.upper.innerHTML = '<i class="bi bi-check-circle"></i> At least 1 uppercase letter';
                strength++;
            } else {
                rules.upper.classList.replace('text-success', 'text-danger');
                rules.upper.innerHTML = '<i class="bi bi-x-circle"></i> At least 1 uppercase letter';
            }

            if (/[0-9]/.test(val)) {
                rules.number.classList.replace('text-danger', 'text-success');
                rules.number.innerHTML = '<i class="bi bi-check-circle"></i> At least 1 number';
                strength++;
            } else {
                rules.number.classList.replace('text-success', 'text-danger');
                rules.number.innerHTML = '<i class="bi bi-x-circle"></i> At least 1 number';
            }

            if (/[\W]/.test(val)) {
                rules.special.classList.replace('text-danger', 'text-success');
                rules.special.innerHTML = '<i class="bi bi-check-circle"></i> At least 1 special character';
                strength++;
            } else {
                rules.special.classList.replace('text-success', 'text-danger');
                rules.special.innerHTML = '<i class="bi bi-x-circle"></i> At least 1 special character';
            }

            // Strength bar
            const colors = ["danger","warning","info","success"];
            strengthDiv.innerHTML = `<div class="progress">
                <div class="progress-bar bg-${colors[strength-1] || "danger"}" role="progressbar" style="width:${strength*25}%"></div>
            </div>`;
        });
    </script>
}