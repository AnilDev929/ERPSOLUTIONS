@using SchoolERP.Models.Entities
@model List<MenuSetting>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Setting";
}

<style>
    body {
        background-color: #f5f7fb;
    }

    .settings-card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.06);
        overflow: hidden;
    }

    .table thead {
        background: #0d6efd;
        color: white;
    }

    .table tbody tr:hover {
        background-color: #f8fbff;
        transition: 0.2s ease;
    }

    .menu-name {
        font-weight: 600;
        color: #2d3748;
    }

    .date-input {
        border-radius: 10px;
        border: 1px solid #dbe2ea;
        padding: 8px 12px;
    }

    .save-btn {
        border-radius: 10px;
        padding: 8px 18px;
        font-weight: 500;
    }

    .form-switch .form-check-input {
        width: 3em;
        height: 1.5em;
        cursor: pointer;
    }

    .status-badge {
        font-size: 12px;
        padding: 5px 10px;
        border-radius: 20px;
    }

    .header-section {
        margin-bottom: 20px;
    }
</style>

<div class="container py-4">

    <!-- Header -->
    <div class="header-section d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-1"> Menu Settings </h2>
            <p class="text-muted mb-0"> Manage menu activation and date availability </p>
        </div>
        <div>
            <span class="badge bg-primary fs-6"> Total Menus: @Model.Count() </span>
        </div>

    </div>

    <!-- Card -->
    <div class="card settings-card">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead>
                        <tr>
                            <th class="ps-4">Menu</th>
                            <th>Status</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                @using (Html.BeginForm("Save", "Settings", FormMethod.Post))
                                {
                                    @Html.Hidden("Id", item.Id)

                                    <!-- Menu Name -->
                                    <td class="ps-4">

                                        <div class="d-flex flex-column">

                                            <span class="menu-name">
                                                <i class="fa-solid fa-bars me-2 text-primary"></i>
                                                @item.MenuName
                                            </span>

                                            <small class="text-muted">
                                                Configure availability settings
                                            </small>

                                        </div>

                                    </td>

                                    <!-- Active Switch -->
                                    <td>

                                        <div class="form-check form-switch">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   name="IsActive"
                                                   value="true"
                                                   @(item.IsActive ? "checked" : "") />
                                        </div>

                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success status-badge"> Active </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary status-badge">Inactive </span>
                                        }
                                    </td>

                                    <!-- Start Date -->
                                    <td>
                                        <input type="date"
                                               name="StartDate"
                                               class="form-control date-input"
                                               value="@(item.StartDate?.ToString("yyyy-MM-dd"))" />
                                    </td>

                                    <!-- End Date -->
                                    <td>

                                        <input type="date"
                                               name="EndDate"
                                               class="form-control date-input"
                                               value="@(item.EndDate?.ToString("yyyy-MM-dd"))" />

                                    </td>

                                    <!-- Save -->
                                    <td class="text-center">

                                        <button type="submit"
                                                class="btn btn-primary save-btn">

                                            <i class="fa-solid fa-floppy-disk me-1"></i>
                                            Save

                                        </button>

                                    </td>
                                }

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>