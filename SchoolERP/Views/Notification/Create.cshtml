        //     // Initial load (for edit mode)
        //     updateCounter();

        // });

        $(function () {

            const $messageBox = $("#messageBox");
            const $charCount = $("#charCount");
            const maxLength = 250;

            function updateCounter() {
                const length = $messageBox.val().length;
                const remaining = maxLength - length;

                $charCount.text(`${remaining} left (${length}/${maxLength})`);

                // Better threshold handling
                $charCount
                    .toggleClass("text-danger", length > maxLength * 0.9)
                    .toggleClass("text-muted", length <= maxLength * 0.9);
            }

            // Bind event
            $messageBox.on("input", updateCounter);

            // Initial render (edit mode support)
            updateCounter();
        });
    
    </script>
}


                                        