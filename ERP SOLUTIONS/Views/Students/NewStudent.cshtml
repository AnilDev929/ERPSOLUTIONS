@using ERP_SOLUTIONS.Models.ViewModels
@model StudentFormViewModel
@{
    ViewData["Title"] = "Student Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .custom-tabs .nav-link {
        color: #6c757d;
        font-weight: 500;
        border: none;
        border-bottom: 3px solid transparent;
        transition: all 0.3s ease;
    }

    /* Hover effect */
    .custom-tabs .nav-link:hover {
        color: #0d6efd;
        background-color: #f8f9fa;
    }

    /* Active tab */
    .custom-tabs .nav-link.active {
        color: #0d6efd;
        border-bottom: 3px solid #0d6efd;
        background-color: #eef5ff;
    }

    /* Disabled tab */
    .custom-tabs .nav-link:disabled {
        color: #adb5bd;
        cursor: not-allowed;
        opacity: 0.7;
    }

    /* Icon alignment */
    .custom-tabs .nav-link i {
        font-size: 1rem;
    }

    .input-group-text {
        border-radius: 0.5rem 0 0 0.5rem;
    }

    .hover-shadow:hover {
        box-shadow: 0 8px 20px rgba(0,0,0,0.2) !important;
        transition: all 0.3s ease;
    }

    input.input-validation-error,
    select.input-validation-error {
        border: 2px solid red !important;
        background-color: #ffe6e6;
    }

    /* Hide the validation message if you don’t want it */
    .field-validation-error {
        display: none;
    }

    .form-check-input {
        appearance: auto !important;
        opacity: 1 !important;
    }
</style>

<div class="container my-4">
    <h2 class="mb-3 text-center"><i class="bi bi-mortarboard me-2"></i>Student Details</h2>

    @if (TempData.Peek("IsSuccess") != null)
    {
        var isSuccess = (bool)TempData["IsSuccess"];

        <div class="modal fade" id="statusModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header @(isSuccess ? "bg-success" : "bg-danger") text-white">
                        <h5 class="modal-title">
                            @(isSuccess ? "Success" : "Error")
                        </h5>
                    </div>

                    <div class="modal-body text-center">
                        @if (isSuccess)
                        {
                            <p>Student Created Successfully</p>
                            <p>Roll: @TempData["RollNumber"]</p>
                            <p>User: @TempData["UserName"]</p>
                            <p>Password: @TempData["Password"]</p>
                        }
                        else
                        {
                            <p>@TempData["Error"]</p>
                        }
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-primary" data-bs-dismiss="modal">OK</button>
                    </div>

                </div>
            </div>
        </div>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var modal = new bootstrap.Modal(document.getElementById('statusModal'));
                modal.show();
            });
        </script>
    }

    <form id="studentForm" name="studentForm" asp-action="NewStudent" method="post">
        <!-- ===== Tabs ===== -->
        <ul class="nav nav-tabs custom-tabs mb-3" id="studentFormTabs" role="tablist">

            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="student-tab"
                        data-bs-toggle="tab" data-bs-target="#student" type="button" role="tab">
                    <i class="bi bi-person me-2"></i> Student Details
                </button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link" id="family-tab"
                        data-bs-toggle="tab" data-bs-target="#family" type="button" role="tab" disabled>
                    <i class="bi bi-people me-2"></i> Family Details
                </button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link" id="class-tab"
                        data-bs-toggle="tab" data-bs-target="#class" type="button" role="tab" disabled>
                    <i class="bi bi-mortarboard me-2"></i> Class & Fees
                </button>
            </li>

        </ul>

        <div class="tab-content">
            <!-- ================= Student Detail Tab ================= -->
            <div class="tab-pane fade show active" id="student" role="tabpanel">
                <!-- Use your existing Student Detail card -->
                <div class="card mb-2 shadow-sm rounded-4 border-0 hover-shadow">
                    <div class="card-header text-white rounded-top-4 mb-2" style="background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);">
                        <i class="bi bi-person-circle me-2"></i>Basic Information
                    </div>
                    <div class="card-body row g-3">
                        <!-- StudentName, Gender, DOB, etc -->
                        <div class="col-md-6">
                            <label>Student Name</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input type="text" asp-for="StudentName" required
                                       class="form-control" placeholder="Enter Student Name"
                                       maxlength="100" oninput="updateCounter('StudentName','studentNameCounter',100)">
                            </div>
                            <small id="studentNameCounter" class="text-muted">100 characters remaining</small>
                            <span asp-validation-for="StudentName" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label>Gender</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-gender-ambiguous"></i></span>
                                <select asp-for="GenderID" asp-items="Model.Genders" class="form-control" required>
                                    <option value="">-- Select Gender --</option>
                                </select>
                            </div>
                            <span asp-validation-for="GenderID" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label>Date of Birth</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-calendar-date"></i></span>
                                <input type="date" asp-for="DateOfBirth" id="DateOfBirth"
                                       class="form-control" required
                                       max="@DateTime.Today.AddYears(-5).ToString("yyyy-MM-dd")"
                                       min="@DateTime.Today.AddYears(-100).ToString("yyyy-MM-dd")">
                                <span id="dobError" class="text-danger"></span>
                            </div>
                            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            
                <!-- Personal Details Card -->
                <div class="card mb-2 shadow-sm rounded-4 border-0 hover-shadow">
                    <div class="card-header text-white rounded-top-4 mb-2"
                         style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                        <i class="bi bi-house-door me-2"></i>Personal Details
                    </div>

                    <div class="card-body row g-3">

                        <!-- Address Section -->
                        <div class="col-md-6">
                            <label>Permanent Address</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                                <textarea asp-for="PermanentAddress"
                                          class="form-control" placeholder="Enter Address"
                                          maxlength="250" required
                                          oninput="updateCounter('PermanentAddress','addressCounter',250)"></textarea>
                            </div>
                            <small id="addressCounter" class="text-muted">250 characters remaining</small>
                            <span asp-validation-for="PermanentAddress" class="text-danger"></span>
                        </div>

                        <div class="col-md-2">
                            <label>City</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-building"></i></span>
                                <input asp-for="City" class="form-control" placeholder="City" required />
                            </div>
                        </div>

                        <div class="col-md-2">
                            <label>State</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-map"></i></span>
                                <input asp-for="State" class="form-control" placeholder="State" required />
                            </div>
                        </div>

                        <div class="col-md-2">
                            <label>Pincode</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-mailbox"></i></span>
                                <input asp-for="Pincode" class="form-control"
                                       maxlength="6" required
                                       pattern="\d{6}"
                                       oninput="allowOnlyNumbers(this)"
                                       placeholder="Pincode" />
                            </div>
                        </div>

                        <!-- Contact Info -->
                        <div class="col-md-3">
                            <label>Phone Number</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                <input type="text" asp-for="PhoneNo" id="PhoneNo"
                                       class="form-control"
                                       maxlength="10" required
                                       pattern="[6-9]{1}[0-9]{9}"
                                       oninput="allowOnlyNumbers(this); updateCounter('PhoneNo','phoneCounter',10)"
                                       placeholder="Mobile Number">
                            </div>
                            <small id="phoneCounter" class="text-muted">10 characters remaining</small>
                            <span asp-validation-for="PhoneNo" class="text-danger"></span>
                        </div>

                        <div class="col-md-3">
                            <label>Email</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input type="email" asp-for="EmailID"
                                       class="form-control"
                                       maxlength="100" required
                                       oninput="updateCounter('EmailID','emailCounter',100)"
                                       placeholder="Email Address">
                            </div>
                            <small id="emailCounter" class="text-muted">100 characters remaining</small>
                            <span asp-validation-for="EmailID" class="text-danger"></span>
                        </div>

                        <!-- Identity Info -->
                        <div class="col-md-3">
                            <label>Aadhaar</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-credit-card"></i></span>
                                <input type="text" asp-for="Aadhaar"
                                       class="form-control"
                                       maxlength="12" required
                                       pattern="\d{12}"
                                       oninput="allowOnlyNumbers(this); updateCounter('Aadhaar','aadhaarCounter',12)"
                                       placeholder="Aadhaar Number">
                            </div>
                            <small id="aadhaarCounter" class="text-muted">12 characters remaining</small>
                            <span asp-validation-for="Aadhaar" class="text-danger"></span>
                        </div>

                        <div class="col-md-3">
                            <label>APAAR ID</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-credit-card-2-front"></i></span>
                                <input type="text" asp-for="ApaarID"
                                       class="form-control"
                                       maxlength="12"
                                       oninput="updateCounter('ApaarID','apaaridCounter',12)"
                                       placeholder="APAAR ID">
                            </div>
                            <small id="apaaridCounter" class="text-muted">12 characters remaining</small>
                        </div>

                        <!-- Personal Info -->
                        <div class="col-md-2">
                            <label>Blood Group</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-droplet"></i></span>
                                <select class="form-select" required asp-for="BloodGroup">
                                    <option value="">Select</option>
                                    <option>A+</option>
                                    <option>A-</option>
                                    <option>B+</option>
                                    <option>B-</option>
                                    <option>O+</option>
                                    <option>O-</option>
                                    <option>AB+</option>
                                    <option>AB-</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-2">
                            <label>Category</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-tags"></i></span>
                                <select asp-for="Category" class="form-select" required>
                                    <option value="">Select</option>
                                    <option>General</option>
                                    <option>OBC</option>
                                    <option>SC</option>
                                    <option>ST</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-2">
                            <label>Religion</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                                <input asp-for="Religion" class="form-control" placeholder="Religion" required />
                            </div>
                        </div>

                        <!-- Medical -->
                        <div class="col-md-6">
                            <label>Medical Condition</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-heart-pulse"></i></span>
                                <textarea asp-for="MedicalCondition" required
                                          class="form-control"
                                          placeholder="Any medical notes"></textarea>
                            </div>
                        </div>

                    </div>
                </div>


                <div class="card mb-3 shadow-sm rounded-4 border-0 hover-shadow">

                    <div class="card-header text-white rounded-top-4 mb-2"
                         style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                        <span>
                            <i class="bi bi-mortarboard me-2"></i> Academic Background
                        </span>
                        <small class="ms-3 text-white text-muted">This section is optional</small>
                    </div>

                    <div class="card-body row g-3">

                        <!-- Previous School Name -->
                        <div class="col-md-5">
                            <label>Previous School Name</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-building"></i>
                                </span>
                                <input type="text" asp-for="PreviousSchoolName"
                                       class="form-control"
                                       placeholder="Enter previous school name"
                                       maxlength="150"
                                       oninput="updateCounter('PreviousSchoolName','schoolCounter',150)">
                            </div>
                            <small id="schoolCounter" class="text-muted">150 characters remaining</small>
                            <span asp-validation-for="PreviousSchoolName" class="text-danger"></span>
                        </div>

                        <!-- Last Class Studied -->
                        <div class="col-md-3">
                            <label>Last Class Studied</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-journal-text"></i>
                                </span>
                                <select asp-for="LastClassStudied" class="form-control">
                                    <option value="">-- Select Class --</option>
                                    <option>Pre-KG</option>
                                    <option>LKG</option>
                                    <option>UKG</option>
                                    <option>1st Grade</option>
                                    <option>2nd Grade</option>
                                    <option>3rd Grade</option>
                                    <option>4th Grade</option>
                                    <option>5th Grade</option>
                                    <option>6th Grade</option>
                                    <option>7th Grade</option>
                                    <option>8th Grade</option>
                                    <option>9th Grade</option>
                                    <option>10th Grade</option>
                                </select>
                            </div>
                        </div>

                        <!-- Last Class Result -->
                        <div class="col-md-2">
                            <label>Last Class Result</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-bar-chart"></i>
                                </span>
                                <input type="number" asp-for="LastClassResult"
                                       class="form-control" min="0"
                                       max="100"
                                       step="0.01"
                                       oninput="preventNegative(this)"
                                       onkeydown="return event.key !== '-'"
                                       placeholder="e.g. 85%">
                            </div>
                            <small class="text-muted">Enter percentage</small>
                        </div>

                        <!-- Medium of Education -->
                        <div class="col-md-2">
                            <label>Medium of Education</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-translate"></i>
                                </span>
                                <select asp-for="MediumOfEducation" class="form-control">
                                    <option value="">-- Select Medium --</option>
                                    <option>English</option>
                                    <option>Odia</option>
                                    <option>Tamil</option>
                                    <option>Telugu</option>
                                    <option>Bengoli</option>
                                    <option>Hindi</option>
                                    <option>Other</option>
                                </select>
                            </div>
                            
                        </div>

                    </div>

                </div>

                <div class="d-flex justify-content-end mt-3">
                    <button type="button" class="btn btn-primary" onclick="nextTab('student')">Next</button>
                </div>
            </div>

            <!-- ================= Family Detail Tab ================= -->
            <div class="tab-pane fade" id="family" role="tabpanel">
                <!-- Use your existing Family Information card -->
                <div class="card mb-2 shadow-sm rounded-4 border-0 hover-shadow">
                    <div class="card-header text-white rounded-top-4 mb-2" style="background: linear-gradient(135deg, #ff7e5f 0%, #feb47b 100%);">
                        <i class="bi bi-people me-2"></i>Family Information
                    </div>
                    <div class="card-body row g-3">
                        <div class="col-md-3">
                            <label>Father Name</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                                <input type="text" asp-for="FatherName" required
                                       class="form-control" placeholder="Father Name"
                                       maxlength="100" oninput="updateCounter('FatherName','fatherCounter',100)">
                            </div>
                            <small id="fatherCounter" class="text-muted">100 characters remaining</small>
                            <span asp-validation-for="FatherName" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label>Mother Name</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person-heart"></i></span>
                                <input type="text" asp-for="MotherName" required
                                       class="form-control" placeholder="Mother Name"
                                       maxlength="100" oninput="updateCounter('MotherName','motherCounter',100)">
                            </div>
                            <small id="motherCounter" class="text-muted">100 characters remaining</small>
                            <span asp-validation-for="MotherName" class="text-danger"></span>
                        </div>
                        <div class="col-md-2">
                            <label>Emergency Contact</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-telephone-forward"></i></span>
                                <input type="text" asp-for="EmergencyContact" maxlength="10"
                                       pattern="[6-9]{1}[0-9]{9}" required
                                       class="form-control" placeholder="Emergency Contact"
                                       maxlength="10" oninput="updateCounter('EmergencyContact','emergencyCounter',10)">
                            </div>
                            <small id="emergencyCounter" class="text-muted">10 characters remaining</small>
                            <span asp-validation-for="EmergencyContact" class="text-danger"></span>
                        </div>
                        <div class="col-md-2">
                            <label>Father Aadhaar No</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-credit-card"></i></span>
                                <input type="text" asp-for="FatherAadhaar" 
                                       pattern="\d{12}" required
                                       class="form-control" placeholder="Enter Aadhaar" maxlength="12"
                                       oninput="updateCounter('FatherAadhaar','faaadhaarCounter',12)">
                            </div>
                            <small id="faaadhaarCounter" class="text-muted">12 characters remaining</small>
                            <span asp-validation-for="FatherAadhaar" class="text-danger"></span>
                        </div>
                        <div class="col-md-2">
                            <label>Mother Aadhaar No</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-credit-card"></i></span>
                                <input type="text" asp-for="MotherAadhaar" required 
                                       pattern="\d{12}"
                                       class="form-control" placeholder="Enter Aadhaar"
                                       maxlength="12" oninput="updateCounter('MotherAadhaar','maadhaarCounter',12)">
                            </div>
                            <small id="maadhaarCounter" class="text-muted">12 characters remaining</small>
                            <span asp-validation-for="MotherAadhaar" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label>Parent Occupation</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-briefcase"></i>
                                </span>
                                <input asp-for="ParentOccupation" class="form-control" placeholder="Occupation" required />
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label>Parent Email</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-envelope-at"></i>
                                </span>
                                <input asp-for="ParentEmail" type="email" 
                                class="form-control" placeholder="Parent Email" />
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label>Annual Income</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-currency-rupee"></i>
                                </span>
                                <input asp-for="AnnualIncome" type="number" 
                                class="form-control" placeholder="Annual Income" required />
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between mt-3">
                        <button type="button" class="btn btn-secondary" onclick="prevTab('family')">Previous</button>
                        <button type="button" class="btn btn-primary" onclick="nextTab('family')">Next</button>
                    </div>
                </div>
            </div>

            <!-- ================= Class & Course Fee Tab ================= -->
            <div class="tab-pane fade" id="class" role="tabpanel">
                <!-- Class Assignment Card -->
                <div class="card mb-2 shadow-sm rounded-4 border-0 hover-shadow">
                    <div class="card-header text-white rounded-top-4 mb-2" style="background: linear-gradient(135deg, #ff4b1f 0%, #1fddff 100%);">
                        <i class="bi bi-mortarboard me-2"></i>Academic Information
                    </div>
                    <div class="card-body row g-3">
                        <div class="col-md-3">
                            <label>Roll Number</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-hash"></i></span>
                                <input type="text" class="form-control" name="RollNumber" id="RollNumber"
                                       placeholder="Auto-generated" readonly>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label>Academic Year</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-calendar"></i></span>
                                <select asp-for="AcademicYearID" asp-items="Model.AcademicYears" class="form-control">
                                    <option value="">-- Select Year --</option>
                                </select>
                            </div>
                            <span asp-validation-for="AcademicYearID" class="text-danger"></span>
                        </div>
                        <div class="col-md-2">
                            <label>Admission Year</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-calendar"></i></span>
                                <input type="number" name="AdmissionYear" id="AdmissionYear" value="@Model.AdmissionYear" readonly
                                       class="form-control" placeholder="YYYY">
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label>Class</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-list-ol"></i></span>
                                <select id="ClassID" asp-for="ClassID" asp-items="Model.Classes" class="form-control">
                                    <option value="">-- Select Class --</option>
                                </select>
                            </div>
                            <span asp-validation-for="ClassID" class="text-danger"></span>
                        </div>
                        <div class="col-md-2">
                            <label>Section</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-diagram-3"></i></span>
                                <select id="SectionDropdown" asp-for="SectionID" class="form-control">
                                    <option value="">-- Select Section --</option>
                                </select>
                                <input type="hidden" asp-for="ClassSectionID" />
                            </div>
                            <span asp-validation-for="SectionID" class="text-danger"></span>
                        </div>
                    </div>

                </div>

                <!-- Course Fees Card -->
                <div class="card mb-2 shadow-sm rounded-4 border-0 hover-shadow">
                    <div class="card-header text-white rounded-top-4 mb-2" style="background: linear-gradient(135deg, #ff4b1f 0%, #1fddff 100%);">
                        <i class="bi bi-cash-stack me-2 fs-5"></i>Course Fees Detail
                    </div>
                    <div class="card-body">
                        <div class="shadow-sm border-0 p-3">
                            <input type="hidden" id="transportFeeValue" value="@(Model.TransportFee ?? 0)" />
                            <input type="hidden" name="CourseFeeId" id="CourseFeeId" />

                            <!-- ================= Fee Breakdown ================= -->
                            <ul class="list-group list-group-flush mb-2">

                                <li class="list-group-item d-flex justify-content-between py-1">
                                    <span><i class="bi bi-bank2 me-2 text-primary"></i>Tuition</span>
