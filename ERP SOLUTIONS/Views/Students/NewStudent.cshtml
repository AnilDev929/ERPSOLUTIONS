@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>

        function nextTab(currentTabId) {
          let form = document.getElementById("studentForm");
          let currentTab = document.getElementById(currentTabId);

          // Validate all required fields in current tab
          let inputs = currentTab.querySelectorAll("input[required], select[required], textarea[required]");

          for (let input of inputs) {
            if (!input.value) {
              input.classList.add("is-invalid");
              input.focus();
              return;
            } else {
              input.classList.remove("is-invalid");
            }
          }

          // Move to next tab
          if (currentTabId === 'student') {
            let nextTabBtn = document.getElementById("family-tab");
            nextTabBtn.removeAttribute("readonly ");
            nextTabBtn.click();
          } else if (currentTabId === 'family') {
            let nextTabBtn = document.getElementById("class-tab");
            nextTabBtn.removeAttribute("readonly ");
            nextTabBtn.click();
          }
        }

        function prevTab(currentTabId) {
          if (currentTabId === 'family') document.getElementById("student-tab").click();
          if (currentTabId === 'class') document.getElementById("family-tab").click();
        }

        function allowOnlyNumbers(input) {
            input.value = input.value.replace(/\D/g, '');
        }

        // Format currency
        function formatCurrency(value) {
            return value.toLocaleString('en-IN', {
                style: 'currency',
                currency: 'INR'
            });
        }

        function getTotalFee() {
            return parseFloat(document.getElementById("totalFee").innerText.replace(/[^0-9.-]+/g, "")) || 0;
        }

        function toggleTransportFee() {

            const checkbox = document.getElementById("includeTransport");
            const feeElement = document.getElementById("transportFee");
            const actualFee = parseFloat(document.getElementById("transportFeeValue").value) || 0;

            let transport = 0;

            if (checkbox.checked) {
                transport = actualFee;
                feeElement.innerText = formatCurrency(transport);
                feeElement.classList.remove("bg-secondary");
                feeElement.classList.add("bg-success");
                feeElement.closest("li").classList.remove("opacity-50");
            } else {
                transport = 0;
                feeElement.innerText = formatCurrency(0);
                feeElement.classList.remove("bg-success");
                feeElement.classList.add("bg-secondary");
                feeElement.closest("li").classList.add("opacity-50");
            }

            calculateTotal();
        }

        function calculateTotal() {

            let tuition = parseFloat(document.getElementById("tuitionFee").innerText.replace(/[^\d.-]/g, '')) || 0;
            let admissionFees = parseFloat(document.getElementById("admissionFee").innerText.replace(/[^\d.-]/g, '')) || 0;
            let transport = parseFloat(document.getElementById("transportFee").innerText.replace(/[^\d.-]/g, '')) || 0;
            let library = parseFloat(document.getElementById("libraryFee").innerText.replace(/[^\d.-]/g, '')) || 0;
            let other = parseFloat(document.getElementById("otherFee").innerText.replace(/[^\d.-]/g, '')) || 0;

            if (document.getElementById("includeTransport").checked) {
                transport = parseFloat(document.getElementById("transportFeeValue").value) || 0;
            }

            let total = tuition + admissionFees+ transport +  library + other;

            document.getElementById("totalFee").innerText = formatCurrency(total);

            calculateFinalAmount();
        }


        function togglePaymentOption() {

            let option = document.querySelector('input[name="PaymentOption"]:checked').value;
            let discountInput = document.getElementById("Discount");

            if (option === "Monthly") {
                // Disable discount
                discountInput.value = 0;
                    discountInput.readOnly = true;
                document.getElementById("monthlySection").style.display = "block";
            } else {
                // Enable discount
                    discountInput.readOnly = true;
                document.getElementById("monthlySection").style.display = "none";
            }

            calculateFinalAmount();
        }

    function preventNegative(input) {
        let value = parseFloat(input.value);

        if (isNaN(value)) return;

        if (value < 0) {
            input.value = 0; // or "" if you prefer clearing
        }
    }

    function validateMonths() {
        let monthsInput = document.getElementById("Months");
        let value = parseInt(monthsInput.value) || 0;

        //Block Negative Values
        if (isNaN(value)) value = 1;
        // Prevent negative
        if (value < 0) value = 0;
        // Prevent above 12
        if (value > 12) value = 12;

        monthsInput.value = value;
    }

        function validatePaidMonths() {
                let months = parseInt(document.getElementById("Months").value) || 0;
            let paidInput = document.getElementById("paidMonths");
            let paid = parseInt(paidInput.value) || 0;

            //Block Negative Values
            if (isNaN(paid)) paid = 0;

            if (paid > months) paid = months;
            if (paid < 0) paid = 0;

            paidInput.value = paid;
        }

        function calculateFinalAmount() {
            let total = getTotalFee();
            let userDiscount = parseFloat(document.getElementById("Discount").value) || 0;
            let option = document.querySelector('input[name="PaymentOption"]:checked').value;

            let extraDiscount = (option === "Full") ? total * 0.10 : 0;
            let totalDiscount = (option === "Full") ? userDiscount + extraDiscount : 0;

            document.getElementById("Discount").value = totalDiscount.toFixed(2);
            let finalAmount = total - totalDiscount;
            document.getElementById("FinalAmount").value = finalAmount.toFixed(2);

            calculateInstallment();
        }

        function calculateInstallment() {
            let option = document.querySelector('input[name="PaymentOption"]:checked').value;
            if (option !== "Monthly") return;

            let finalAmount = parseFloat(document.getElementById("FinalAmount").value) || 0;
                let months = parseInt(document.getElementById("Months").value) || 1;
            let paidMonths = parseInt(document.getElementById("paidMonths").value) || 0;

            let monthly = finalAmount / months;
            let remaining = finalAmount - (monthly * paidMonths);

            document.getElementById("MonthlyAmount").value = monthly;
            document.getElementById("RemainingAmount").value = remaining;
        }


        // Initial load
        window.onload = function () {
            calculateFinalAmount();
        };

        // Character counter
        function updateCounter(inputId, counterId, max) {
            const input = document.getElementById(inputId);
            const counter = document.getElementById(counterId);
            if (!input || !counter) return; // Safe check
            const remaining = max - input.value.length;
            counter.textContent = remaining + ' characters remaining';
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', () => {

            

            const fields = [
                { id: 'StudentName', max: 100 },
                { id: 'PermanentAddress', max: 250 },
                { id: 'PhoneNo', max: 10 },
                { id: 'EmailID', max: 100 },
                { id: 'Aadhaar', max: 12 },
                { id: 'FatherName', max: 100 },
                { id: 'FatherAadhaar', max: 12 },
                { id: 'MotherName', max: 100 },
                { id: 'MotherAadhaar', max: 12 },
                { id: 'EmergencyContact', max: 10 },
                { id: 'PreviousSchoolName', max: 150 }
            ];

            fields.forEach(f => updateCounter(f.id, f.id + 'Counter', f.max));

            calculateFinalAmount();
        });

        $(document).ready(function() {

            function updateFees(fees) {

                $('#CourseFeeId').val(fees.courseFeeId || 0);
                $('#tuitionFee').text(formatCurrency(fees.tuitionFee || 0));
                $('#admissionFee').text(formatCurrency(fees.admissionFee || 0));
                $('#transportFee').text(formatCurrency(fees.transportFee || 0));
                $('#libraryFee').text(formatCurrency(fees.libraryFee || 0));
                $('#otherFee').text(formatCurrency(fees.otherFee || 0));
                $('#totalFee').text(formatCurrency(fees.totalFee || 0));
                
                let total = getTotalFee();
                let userDiscount = parseFloat(document.getElementById("Discount").value) || 0;
                let option = document.querySelector('input[name="PaymentOption"]:checked').value;
                let extraDiscount = (option === "Full") ? total * 0.10 : 0;
                let totalDiscount = (option === "Full") ? userDiscount + extraDiscount : 0;
                document.getElementById("Discount").value = totalDiscount.toFixed(2);
                let finalAmount = total - totalDiscount;
                document.getElementById("FinalAmount").value = finalAmount.toFixed(2);
            }

            $('#DateOfBirth').change(function () {
                var dob = new Date($(this).val());
                var today = new Date();

                var age = today.getFullYear() - dob.getFullYear();
                var monthDiff = today.getMonth() - dob.getMonth();

                if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dob.getDate())) {
                    age--;
                }

                if (dob > today) {
                    $('#dobError').text('Date of birth cannot be in the future');
                }
                else if (age < 5) {
                    $('#dobError').text('Student must be at least 5 years old');
                }
                else if (age > 100) {
                    $('#dobError').text('Invalid date of birth');
                }
                else {
                    $('#dobError').text('');
                }
            });


            $('#ClassID').change(function(){
                var classId = $(this).val();
                var academicYearId = $('#AcademicYearID').val();

                if(classId && academicYearId) {
                    $.getJSON('/Students/GetClassDetails', { classId: classId, academicYearId: academicYearId }, function(data){

                        // Make sure sections exist
                        if(data.sections && data.sections.length > 0) {
                            var sectionDropdown = $('#SectionDropdown');
                            sectionDropdown.empty();
                            sectionDropdown.append('<option value="">-- Select Section --</option>');

                            $.each(data.sections, function(i, section){
                                sectionDropdown.append('<option value="'+section.sectionId+'" data-classsectionid="'+section.id+'">'+section.sectionName+'</option>');
                            });

                            // Reset hidden ClassSectionID
                            $('#ClassSectionID').val('');
                        } else {
                            $('#SectionDropdown').empty().append('<option value="">-- No Sections --</option>');
                        }

                        // Update fees
                        if(data.fees) {
                            updateFees(data.fees);
                        } else {
                                updateFees({ CourseFeeId:0, tuitionFee:0, admissionFee:0, transportFee:0, libraryFee:0, otherFee:0, totalFee:0});
                        }
                    });
                }
            });

            // When Section changes, set ClassSectionID
            $('#SectionDropdown').change(function(){
                // var selectedOption = $(this).find('option:selected');
                // var classSectionId = selectedOption.data('classsectionid');
                // $('#ClassSectionID').val(classSectionId);

                // Get the selected <option>
                var selectedOption = $(this).find('option:selected');

                // Get the data attribute
                var classSectionId = selectedOption.data('classsectionid');

                // Set the value in your hidden/input field
                $('#ClassSectionID').val(classSectionId);
            });

        });

    </script>

}




