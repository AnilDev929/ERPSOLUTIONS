@using ERP_SOLUTIONS.Models.Entities
@model Student

@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Card Styling */
    .form-card {
        border-radius: 16px !important;
        border: 1px solid #cfd8e3 !important;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08) !important;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    /* Card Header */
    .card-header {
        background: linear-gradient(90deg, #eef2ff, #ffffff);
        border-bottom: 1px solid #d1d5db;
        font-weight: 600;
    }

    /* Labels & Info */
    label {
        font-size: 0.9rem;
    }
    /* Input Styling */
    .form-control {
        border-radius: 0 8px 8px 0;
        border: 1px solid #d1d5db;
    }

        .form-control.bg-light {
            background-color: #f8f9fc;
        }
    /* .form-control.bg-light {
        background-color: #f8f9fc;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        padding: 0.5rem 0.75rem;
        height: auto;
    } */

    /* Input Group Icon */
    .input-group-text {
        background-color: #f8f9fc;
        border: 1px solid #d1d5db;
        border-radius: 8px 0 0 8px;
        color: #4e73df;
        min-width: 45px;
        justify-content: center;
    }

    /* Buttons */
    .btn-primary {
        background: linear-gradient(45deg, #4e73df, #6c8cff);
        border: none;
    }

        .btn-primary:hover {
            background: linear-gradient(45deg, #3b5bcc, #5a78e0);
        }

    .bi-person-circle {
        background: #e7f1ff;
        border-radius: 50%;
        padding: 15px;
    }
</style>

<div class="container mt-4">

    <!-- Header -->
    <div class="mb-4 p-3 border-start border-4 border-primary bg-light rounded">
        <h3 class="fw-bold mb-1 text-primary">
            <i class="bi bi-person-circle me-2"></i>
            My Profile
        </h3>
        <small class="text-muted">View and manage your profile information</small>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">

            <div class="card shadow-lg text-center p-4">
                <!-- Status -->
                
                <span class="position-absolute top-0 end-0 m-3 badge rounded-pill px-4 py-3 fs-6"
                      style="background-color:#e6f4ea; color:#198754;">
                    <i class="bi bi-check-circle-fill me-1"></i> Active
                </span>
                <!-- Profile Icon -->
                <div class="mb-3">
                    <i class="bi bi-person-circle text-primary" style="font-size: 80px;"></i>
                </div>

                <h3>Anil Rout</h3>
                <p class="text-muted">
                    <i class="bi bi-envelope"></i> rout.anil@gmail.com
                </p>
            </div>

            <div class="row mt-4">
                <!-- Personal Info -->
                <div class="col-md-6">
                    <div class="card p-3 shadow-sm">
                        <h5><i class="bi bi-person"></i> Personal Info</h5>
                        <p><i class="bi bi-telephone"></i> 2225255</p>
                        <p><i class="bi bi-geo-alt"></i> skljklgjkljfgkldf</p>
                    </div>
                </div>

                <!-- Academic Info -->
                <div class="col-md-6">
                    <div class="card p-3 shadow-sm">
                        <h5><i class="bi bi-mortarboard"></i> Academic Info</h5>
                        <p><i class="bi bi-book"></i> 10th</p>
                        <p><i class="bi bi-calendar"></i> 2026</p>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="text-center mt-4">

                <!-- Change Password -->
                <a asp-controller="Account" asp-action="ChangePassword"
                   class="btn btn-warning me-2">
                    <i class="bi bi-key"></i> Change Password
                </a>

                <!-- Edit Profile -->
                <a asp-controller="Student" asp-action="Edit"
                   class="btn btn-primary">
                    <i class="bi bi-pencil-square"></i> Edit Profile
                </a>

            </div>
        </div>
    </div>
</div>