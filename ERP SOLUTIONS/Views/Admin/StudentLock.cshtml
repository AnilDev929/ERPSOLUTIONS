@using ERP_SOLUTIONS.Models.ViewModels
@model List<StudentLockViewModel>

@{
    ViewData["Title"] = "Lock/Unlock Students";
}

<h2 class="mb-4">
    <i class="bi bi-shield-lock-fill"></i> Student Lock/Unlock Management
</h2>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Class</th>
            <@* th>Section</th> *@
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.Count; i++)
        {
            var student = Model[i];
            <tr>
                <td>@(i + 1)</td>
                <td>@student.Name</td>
                <td>@student.ClassName</td>
                @* <td>@student.SectionName</td> *@
                <td>
                    @if (student.IsLocked)
                    {
                        <span class="badge bg-danger">
                            <i class="bi bi-lock-fill"></i> Locked
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            <i class="bi bi-unlock-fill"></i> Unlocked
                        </span>
                    }
                </td>
                <td>
                    <form asp-action="ToggleLock" method="post">
                        <input type="hidden" name="studentId" value="@student.StudentId" />
                        <button type="submit" class="btn btn-sm @(student.IsLocked ? "btn-success" : "btn-danger")">
                            @if (student.IsLocked)
                            {
                                <i class="bi bi-unlock-fill"></i><text>Unlock</text>
                            }
                            else
                            {
                                <i class="bi bi-lock-fill"></i> <text>Lock</text>
                            }
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>