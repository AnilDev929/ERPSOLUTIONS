                <li class="nav-item mt-auto">
                    <a class="nav-link" href="@Url.Action("Logout", "Account")">
                        <i class="fas fa-sign-out-alt"></i> Logout
                    </a>
                </li>
            </ul>
        </div>

        <!-- Main Content -->
        <div id="content">

            <!-- Top Navbar (Improved Header) -->
            <nav class="navbar navbar-expand-lg navbar-light bg-light mb-3 shadow-sm custom-navbar">
                <div class="container-fluid">

                    <!-- Sidebar toggle -->
                    <button class="btn btn-outline-secondary d-lg-none me-2" id="toggleSidebar">
                        <i class="fas fa-bars"></i>
                    </button>

                    <!-- Right side -->
                    <div class="ms-auto d-flex align-items-center gap-3">

                        <!-- 🌙 Dark Mode Toggle -->
                        <button id="darkModeToggle" class="btn"
                                title="Toggle Dark Mode">
                            <i class="fas fa-moon me-2"></i> Dark Mode
                        </button>

                        <!-- 🔔 Notifications -->
                        <div class="dropdown me-3">
                            <button class="btn position-relative" data-bs-toggle="dropdown">
                                <i class="fas fa-bell fa-lg"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    3
                                </span>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li class="dropdown-header fw-bold">Notifications</li>
                                <li><a class="dropdown-item" href="#">New student registered</a></li>
                                <li><a class="dropdown-item" href="#">Fee payment received</a></li>
                                <li><a class="dropdown-item" href="#">Exam schedule updated</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-center" href="#">View all</a></li>
                            </ul>
                        </div>

                        <!-- 👤 Profile Dropdown -->
                        <div class="dropdown">
                            <button class="profile-btn dropdown-toggle d-flex align-items-center" data-bs-toggle="dropdown">
                                <div class="profile-avatar">
                                    <i class="fas fa-user"></i>
                                </div>
                                <div class="profile-text">
                                    <span class="profile-name">@User.FindFirst(ClaimTypes.Role)?.Value</span>
                                </div>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end shadow profile-dropdown">

                                <!-- User Info Header -->
                                <li class="px-3 py-2 border-bottom d-flex align-items-center">
                                    <div>
                                        <div class="fw-semibold">
                                            <small class="text-muted">@User.FindFirst("FullName")?.Value</small>
                                        </div>
                                    </div>
                                </li>

                                <!-- Menu Items -->
                                <li>
                                    <a class="dropdown-item d-flex align-items-center" href="@Url.Action("MyProfile", "Account")">
                                        <i class="fas fa-user me-2 text-secondary"></i> My Profile
                                    </a>
                                </li>


                                <li><hr class="dropdown-divider"></li>

                                <!-- Logout -->
                                <li>
                                    <a class="dropdown-item d-flex align-items-center text-danger" href="@Url.Action("Logout", "Account")">
                                        <i class="fas fa-sign-out-alt me-2"></i> Logout
                                    </a>
                                </li>

                            </ul>
                        </div>

                    </div>

                </div>
            </nav>


            <!-- Page Content -->
            @RenderBody()

            @if (TempData["Success"] != null)
            {
                <script>
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'success',
                        title: 'Success',
                        text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Success"])),
                        timer: 2000,
                        showConfirmButton: false
                    });
                </script>
            }

            @if (TempData["Error"] != null)
            {
                <script>
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'error',
                        title: 'Error',
                        text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"]))
                    });
                </script>
            }

            @if (TempData["Warning"] != null)
            {
                <script>
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'warning',
                        title: 'Warning',
                        text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Warning"]))
                    });
                </script>
            }

            @if (TempData["Info"] != null)
            {
                <script>
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'info',
                        title: 'Info',
                        text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Info"]))
                    });
                </script>
            }

        </div>
    </div>

    <footer class="footer text-center text-white py-2">
    <small>&copy; @DateTime.Now.Year School ERP</small>
</footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>



    <script>
        // Toggle sidebar on mobile
        const toggleBtn = document.getElementById('toggleSidebar');
        const sidebar = document.getElementById('sidebar');
        toggleBtn.addEventListener('click', () => {
            sidebar.classList.toggle('collapsed');
        });

            const toggle = document.getElementById("darkModeToggle");
        toggle.addEventListener("click", () => {
            document.body.classList.toggle("dark-mode");

            // Save preference
            if (document.body.classList.contains("dark-mode")) {
                localStorage.setItem("theme", "dark");
                toggle.innerHTML = '<i class="fas fa-sun me-2"></i> Light Mode';
            } else {
                localStorage.setItem("theme", "light");
                toggle.innerHTML = '<i class="fas fa-moon me-2"></i> Dark Mode';
            }
        });

        // Apply saved preference on page load
        if (localStorage.getItem("theme") === "dark") {
            document.body.classList.add("dark-mode");
            toggle.innerHTML = '<i class="fas fa-sun me-2"></i> Light Mode';
        }

            // Prevent dropdown parent link from jumping
        document.querySelectorAll('.dropdown-toggle').forEach(el => {
            el.addEventListener('click', function (e) {
                e.preventDefault();
            });
        });
    </script>

    @RenderSection("Scripts", required: false)

</body>

</html>