@using System.Security.Claims
@{
    // Get current controller and action to highlight active menu
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - School ERP</title>

    <link href="~/css/site.css" rel="stylesheet" />
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icon -->
    @* <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" /> *@

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    

    <style>
        body {
             height: 100vh;       /* fix height */
            overflow: hidden;    /* prevent full page scroll */
            display: flex;
            flex-direction: column; /* ADD THIS */
        }

        .main-wrapper {
            flex: 1; /* pushes footer down */
            display: flex;
            overflow: hidden; /* important */
        }

        #content {
            flex: 1;
            padding: 20px;
            overflow-y: auto; /* scroll only here */
        }

        /* Sidebar */
        #sidebar {
            min-width: 220px;
            max-width: 220px;
            background-color: #343a40;
            color: #fff;
            /* min-height: 100vh; */
            transition: all 0.3s;
            height: 100%; /* instead of min-height */
        }

        #sidebar.collapsed {
            margin-left: -220px;
        }

        #sidebar .nav-link {
            color: #fff;
            font-size: 16px;
        }

        #sidebar .nav-link:hover {
            background-color: #495057;
            color: #fff;
        }

        #sidebar .nav-link i {
            margin-right: 10px;
        }

        #sidebar .dropdown-menu {
            background-color: #343a40; /* match sidebar bg */
        }

        #sidebar .dropdown-item {
            color: #fff;
        }

        #sidebar .dropdown-item:hover,
        #sidebar .dropdown-item:focus {
            background-color: #495057; /* hover background like nav-links */
            color: #fff;
        }

        /* Main content */
        #content {
            flex: 1;
            padding: 20px;
            transition: all 0.3s;
        }

        /* Card hover effect */
        .dashboard-card {
            transition: transform 0.2s, box-shadow 0.2s;
            cursor: pointer;
        }

        .dashboard-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.2);
        }

        /* Master Data submenu hover */
        #adminMasterData .nav-link:hover {
            background-color: #495057;
            color: #fff;
        }

        /* Chevron rotates when expanded */
        .nav-link.collapsed i.fas.fa-chevron-down {
            transition: transform 0.3s;
        }

        .nav-link[aria-expanded="true"] i.fas.fa-chevron-down {
            transform: rotate(180deg);
        }

        .footer {
            background: #343a40;
        }

        
        .custom-navbar {
            background: linear-gradient(to right, #232526, #414345) !important;
            color: #ffffff !important;
            padding: 0 20px; /* remove vertical padding */
            height: 60px; /* fixed professional height */
            border-bottom: 2px solid #00c6ff;
            display: flex;
            align-items: center; /* vertical centering */
        }

        .custom-navbar .btn {
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 12px;
            border-radius: 6px;
        }

                .custom-navbar .btn i {
                    font-size: 16px;
                }

            .custom-navbar .badge {
                font-size: 10px;
                padding: 3px 6px;
            }

        .custom-navbar .navbar-brand {
            font-size: 22px;
            letter-spacing: 0.5px;
        }

        .dropdown-menu {
            min-width: 220px;
            max-height: 300px;
            overflow-y: auto;
            border-radius: 8px;
            border: none;
        }

        .custom-navbar .btn,
        .profile-btn {
            background: transparent !important;
            color: #ffffff !important;
            border: none !important;
            transition: all 0.2s ease;
        }

            /* 🔥 Fix hover issue */
            .custom-navbar .btn:hover,
            .profile-btn:hover {
                background: rgba(255, 255, 255, 0.12) !important;
                color: #ffffff !important;
            }

            /* Remove Bootstrap default focus/active white flash */
.custom-navbar .btn:focus,
.custom-navbar .btn:active,
.profile-btn:focus,
.profile-btn:active {
    background: rgba(255, 255, 255, 0.18);
    color: #ffffff;
    box-shadow: none;
}

        .user-info span {
            font-size: 16px;
        }

        .profile-dropdown {
            min-width: 260px;
            border-radius: 10px;
            overflow: hidden;
        }

        .profile-dropdown .dropdown-item {
            padding: 10px 16px;
            transition: background 0.2s;
        }

        .profile-dropdown .dropdown-item:hover {
            background-color: #2c2f33;
            color: #fff;
        }

        .profile-btn {
            background: transparent !important;
            border: none;
            color: #fff;
            display: flex;
            align-items: center;
            height: 38px;
            padding: 0 10px;
            gap: 8px;
        }

        .profile-avatar {
            width: 32px;
            height: 32px;
            background: #00c6ff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .profile-text {
            margin-left: 8px;
            font-size: 14px;
        }


        .profile-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #4e73df;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .profile-text {
            display: flex;
            flex-direction: column;
            line-height: 1.1;
        }

        .profile-name {
            font-weight: 600;
            font-size: 14px;
        }

        .profile-role {
            font-size: 12px;
            color: #6c757d;
        }

        #darkModeToggle {
            background: transparent;
            border: 1px solid rgba(255,255,255,0.3);
            color: #fff;
            font-size: 14px;
        }
    </style>

</head>

<body>

    <div class="main-wrapper d-flex flex-grow-1">

        <!-- Sidebar -->
        <div id="sidebar" class="d-flex flex-column p-3">
            <a href="@Url.Action("Dashboard", "Home")" class="navbar-brand mb-4 text-white fs-4">
                <i class="fas fa-school me-2"></i> School ERP
            </a>
            <ul class="nav nav-pills flex-column">
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Dashboard")">
                        <i class="fas fa-tachometer-alt"></i> Dashboard
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link collapsed" data-bs-toggle="collapse" href="#adminMasterData" role="button" 
                    aria-expanded="false" aria-controls="adminMasterData">
                        <i class="fas fa-cogs me-2"></i> Master Data
                        <i class="fas fa-chevron-down ms-auto"></i>
                    </a>
                    <div class="collapse" id="adminMasterData">
                        <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small">
                            <li>
                                <a href="@Url.Action("Index", "Roles")" class="nav-link">
                                    <i class="fas fa-user-shield me-2"></i> Roles
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("Index", "Permission")" class="nav-link">
                                    <i class="fas fa-user-shield me-2"></i> Permission
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("Index", "AcademicYears")" class="nav-link">
                                    <i class="fas fa-user-shield me-2"></i> Academic Year
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("Index", "Holidays")" class="nav-link">
                                    <i class="fas fa-calendar-alt me-2"></i> Holidays
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("Index", "Subjects")" class="nav-link">
                                    <i class="fas fa-school me-2"></i> Subjects
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("Index", "Classes")" class="nav-link">
                                    <i class="fas fa-school me-2"></i> Classes
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Index", "Fees")">
                                    <i class="fas fa-wallet"></i> Course Fees
                                </a>
                            </li>
                            <li>
                                <a class="nav-link" href="@Url.Action("Create", "Hostel")">
                                    <i class="fas fa-wallet"></i> Hostel Management
                                </a>
                            </li>

                        </ul>
                    </div>
                </li>

                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center justify-content-between collapsed"
                       data-bs-toggle="collapse"
                       href="#teachersDropdown"
                       role="button"
                       aria-controls="teachersDropdown"
                       aria-expanded="false">
                        <span>
                            <i class="fas fa-chalkboard-teacher me-2"></i>
                            Teacher
                        </span>
                        <i class="fas fa-chevron-down"></i>
                    </a>

                    <div class="collapse" id="teachersDropdown">
                        <ul class="nav flex-column ms-3">
                            <li class="nav-item">
                                <a class="nav-link text-white @(currentAction == "Index" ? "active" : "")"
                                   href="@Url.Action("Index", "Teacher")">
                                    <i class="fas fa-users me-2"></i> All Teachers
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white @(currentAction == "Entry" ? "active" : "")"
                                   href="@Url.Action("Entry", "Teachers")">
                                    <i class="fas fa-user-plus me-2"></i> New Teacher
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white @(currentAction == "Salary" ? "active" : "")"
                                   href="@Url.Action("Salary", "Teachers")">
                                    <i class="fas fa-money-bill-wave me-2"></i> Teacher Salary
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white @(currentAction == "TeacherAttendance" ? "active" : "")"
                                   href="@Url.Action("TeacherAttendance", "Attendance")">
                                    <i class="fas fa-calendar-check me-2"></i> Teacher Attendance
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white @(currentAction == "StudentAttendance" ? "active" : "")"
                                   href="@Url.Action("Student", "Attendance")">
                                    <i class="fas fa-user-check me-2"></i> Student Attendance
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>

                <!-- Students dropdown example -->
                @* <li class="nav-item dropdown @(currentController == "Students" ? "active" : "")">
                    <a class="nav-link dropdown-toggle" href="#" id="studentsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-user-graduate"></i> <span>Students</span>
                    </a>
                    <ul class="dropdown-menu bg-dark border-0" aria-labelledby="studentsDropdown">
                        <li><a class="dropdown-item text-white @(currentAction == "Entry" ? "active" : "")" href="@Url.Action("Entry", "Students")">Student Entry</a></li>
                        <li><a class="dropdown-item text-white @(currentAction == "Fees" ? "active" : "")" href="@Url.Action("Fees", "Students")">Fees</a></li>
                        <li><a class="dropdown-item text-white @(currentAction == "Marks" ? "active" : "")" href="@Url.Action("Marks", "Students")">Marks</a></li>
                        <li><a class="dropdown-item text-white @(currentAction == "Exam" ? "active" : "")" href="@Url.Action("Exam", "Students")">Exam</a></li>
                    </ul>
                </li> *@

                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center justify-content-between
                        collapsed"
                       data-bs-toggle="collapse" href="#studentsDropdown" role="button" 
                    aria-expanded="false" aria-controls="studentsDropdown">
                        <i class="fas fa-user-graduate me-2"></i> <span>Student</span>
                        <i class="fas fa-chevron-down ms-auto"></i>
                    </a>
                    <div class="collapse" id="studentsDropdown">
                        <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small">

                            <li>
                                <a href="@Url.Action("Entry", "Students")"
                                   class="nav-link text-white @(currentAction == "Entry" ? "active" : "")">
                                    <i class="fas fa-user-graduate me-2"></i> Students
                                </a>
                            </li>
                            <!-- Student Entry -->
                            <li>
                                <a href="@Url.Action("NewStudent", "Students")"
                                   class="nav-link text-white @(currentAction == "Entry" ? "active" : "")">
                                    <i class="fas fa-user-graduate me-2"></i> Student Entry
                                </a>
                            </li>

                            <!-- Fees -->
                            <li>
                                <a href="@Url.Action("Fees", "Students")"
                                   class="nav-link text-white @(currentAction == "Fees" ? "active" : "")">
                                    <i class="fas fa-wallet me-2"></i> Fees
                                </a>
                            </li>

                            <!-- Attendance -->
                            <li>
                                <a href="@Url.Action("Attendance", "Students")"
                                   class="nav-link text-white @(currentAction == "Attendance" ? "active" : "")">
                                    <i class="fas fa-calendar-check me-2"></i> Attendance
                                </a>
                            </li>

                            <!-- Exam -->
                            <li>
                                <a href="@Url.Action("Exam", "Students")"
                                   class="nav-link text-white @(currentAction == "Exam" ? "active" : "")">
                                    <i class="fas fa-file-alt me-2"></i> Exam
                                </a>
                            </li>

                            <!-- Marks -->
                            <li>
                                <a href="@Url.Action("Marks", "Students")"
                                   class="nav-link text-white @(currentAction == "Marks" ? "active" : "")">
                                    <i class="fas fa-chart-line me-2"></i> Marks
                                </a>
                            </li>
                            <li>
                                <a href="@Url.Action("StudentLock", "Admin")"
                                   class="nav-link text-white @(currentAction == "Marks" ? "active" : "")">
                                    <i class="fas fa-chart-line me-2"></i> Unlock Student
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>


                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center justify-content-between collapsed"
                       data-bs-toggle="collapse"
                       href="#leaveDropdown"
                       role="button"
                       aria-controls="leaveDropdown"
                       aria-expanded="false">
                        <span>
                            <i class="fas fa-calendar-alt me-2"></i>
                            Leave Management
                        </span>
                        <i class="fas fa-chevron-down"></i>
                    </a>

                    <div class="collapse" id="leaveDropdown">
                        <ul class="nav flex-column ms-3">
                            <li class="nav-item">
                                <a class="nav-link text-white @(currentAction == "ApplyLeave" ? "active" : "")"
                                   href="@Url.Action("Apply", "Leave")">
                                    <i class="fas fa-pencil-alt me-2"></i> Apply Leave
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white @(currentAction == "ApproveLeave" ? "active" : "")"
