@using ERP_SOLUTIONS.Models.ViewModels
@model AttendanceViewModel
@{
    ViewBag.Title = "Student Attendance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    .present {
        background-color: #e6f4ea;
    }

    .absent {
        background-color: #fdecea;
    }

    .status-btn {
        min-width: 110px;
    }

    /* Mobile optimization */
    @@media (max-width: 576px) {
        .status-btn {
            font-size: 12px;
            padding: 5px;
        }
    }
</style>


<div class="container mt-3">

    <div class="d-flex align-items-center mb-3">
        <i class="bi bi-clipboard-check text-primary fs-2 me-2"></i>
        <div>
            <h4 class="mb-0 fw-bold">Attendance</h4>
            <small class="text-muted">Manage student attendance records</small>
        </div>
    </div>

    <form asp-action="SaveAttendance" method="post">
       
        <div class="row g-2 mb-3 align-items-end">

            <!-- Class Dropdown -->
            <div class="col-12 col-md-4">
                <label for="classSelect" class="form-label">Select Class</label>
                <select id="classSelect" name="ClassId" class="form-select">
                    <option value="">--Select Class--</option>
                    @foreach (var cls in ViewBag.Classes)
                    {
                        <option value="@cls.Value">@cls.Text</option>
                    }
                </select>
            </div>

            <!-- Subject Dropdown -->
            <div class="col-12 col-md-4">
                <label for="subjectSelect" class="form-label">Select Subject</label>
                <select id="subjectSelect" name="Subject" class="form-select">
                    <option value="">--Select Subject--</option>
                    @foreach (var subj in ViewBag.Subjects)
                    {
                        <option value="@subj.Value">@subj.Text</option>
                    }
                </select>
            </div>

            <!-- Date Picker -->
            <div class="col-6 col-md-2">
                <label for="attendanceDate" class="form-label">Date</label>
                <input type="date" id="attendanceDate" name="Date" class="form-control"
                       value="@DateTime.Now.ToString("yyyy-MM-dd")"
                       min="@DateTime.Now.ToString("yyyy-MM-dd")"
                       max="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>

            <!-- Submit Button -->
            <div class="col-6 col-md-2">
                <button type="submit" class="btn btn-primary w-100 mt-2 mt-md-0">
                    <i class="bi bi-search"></i> Load
                </button>
            </div>
        </div>

        <!-- Search -->
        <input type="text" id="searchBox" class="form-control mb-2"
               placeholder="🔍 Search student...">

        <div class="card shadow-sm">
            <div class="card-body p-2">
                <small class="text-muted">Tap to mark absent</small>

                <div class="table-responsive" style="max-height: 400px;">
                    <table class="table table-sm align-middle">
                        <tbody id="studentTable">
                            @for (int i = 0; i < Model.Students.Count; i++)
                            {
                                <tr class="student-row present" data-id="@Model.Students[i].Id" data-name="@Model.Students[i].Name.ToLower()">
                                    <td align="right"><strong>@Model.Students[i].Id</strong></td>
                                    <td>@Model.Students[i].Name</td>
                                    <td class="text-end">
                                        <button type="button"
                                                class="btn btn-sm status-btn btn-success"
                                                onclick="toggleStatus(this)">
                                            <i class="bi bi-check-circle"></i> Present
                                        </button>

                                        <input type="hidden" name="Students[@i].Id" value="@Model.Students[i].Id" />
                                        <input type="hidden" name="Students[@i].Status" value="Present" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <button type="submit" class="btn btn-primary w-100 mt-2">
                    <i class="bi bi-save"></i> Save Attendance
                </button>
            </div>
        </div>
    </form>
</div>



@section Scripts {

    <script>

        const classSelect = document.getElementById('classSelect');
        const subjectSelect = document.getElementById('subjectSelect');

        //     classSelect.addEventListener('change', function() {
        //     const selectedClass = this.value;
        //     console.log("Selected Class:", selectedClass);

        //     // TODO: Optional: filter subjects based on class via AJAX
        // });

        // subjectSelect.addEventListener('change', function() {
        //     const selectedSubject = this.value;
        //     console.log("Selected Subject:", selectedSubject);

        //     // TODO: Optional: fetch students for selected class + subject
        // });

        function toggleStatus(btn) {
            let row = btn.closest("tr");
            let input = row.querySelector('input[name$=".Status"]');

            if (row.classList.contains("present")) {
                row.classList.remove("present");
                row.classList.add("absent");
                btn.classList.remove("btn-success");
                btn.classList.add("btn-danger");
                btn.innerHTML = '<i class="bi bi-x-circle"></i> Absent';
                input.value = "Absent";
            } else {
                row.classList.remove("absent");
                row.classList.add("present");
                btn.classList.remove("btn-danger");
                btn.classList.add("btn-success");
                btn.innerHTML = '<i class="bi bi-check-circle"></i> Present';
                input.value = "Present";
            }
        }

        // document.getElementById("searchBox").addEventListener("keyup", function () {
        //     let value = this.value.toLowerCase();
        //     document.querySelectorAll(".student-row").forEach(row => {
        //         let name = row.getAttribute("data-name");
        //         row.style.display = name.includes(value) ? "" : "none";
        //     });
        // });

        document.getElementById("searchBox").addEventListener("keyup", function () {
            let value = this.value.toLowerCase();

            document.querySelectorAll(".student-row").forEach(row => {
                let name = row.getAttribute("data-name").toLowerCase();
                let id = row.getAttribute("data-id").toLowerCase();

                // Show row if value matches name OR id
                row.style.display = (name.includes(value) || id.includes(value)) ? "" : "none";
            });
        });

        document.getElementById('subjectSelect').addEventListener('change', function() {
            let selectedSubject = this.value;
            console.log("Selected Subject:", selectedSubject);
            // TODO: Call AJAX to reload attendance list for this subject
        });

    </script>

}